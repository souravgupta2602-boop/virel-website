---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/travel', label: 'Travel' },
  { href: '/best-card', label: 'Best Card' },
  { href: '/cards', label: 'Browse Cards' },
  { href: '/offers', label: 'Offers & Rewards' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="container">
    <a href="/" class="logo">
      <div class="logo-icon">V</div>
      <span class="logo-text">Virel</span>
    </a>

    <nav class="nav-links">
      {navLinks.map(link => (
        <a href={link.href} class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-cta">
      <a href="/login" class="btn-login">Log In</a>
      <a href="/signup" class="btn-primary">
        Sign Up Free
      </a>
    </div>

    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-link">{link.label}</a>
    ))}
    <div class="mobile-auth">
      <a href="/login" class="mobile-login">Log In</a>
      <a href="/signup" class="btn-primary mobile-cta">Sign Up Free</a>
    </div>
  </div>
</header>

<!-- Show user name if logged in -->
<div id="user-bar" style="display:none" class="user-bar">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;padding:8px 24px;">
    <span id="user-greeting" style="font-size:0.85rem;color:#4F46E5;font-weight:600;"></span>
    <button id="logout-btn" style="font-size:0.8rem;color:#6B7280;background:none;border:none;cursor:pointer;">Sign out</button>
  </div>
</div>

<script type="module">
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
  import { getAuth, onAuthStateChanged, signOut } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';

  const firebaseConfig = {
    apiKey: "AIzaSyPLACEHOLDER",
    authDomain: "virel-app.firebaseapp.com",
    projectId: "virel-app",
    storageBucket: "virel-app.appspot.com",
    messagingSenderId: "000000000000",
    appId: "1:000000000000:web:placeholder"
  };

  // Load config from window if set (injected by firebase-config.js in public/)
  const cfg = window.__VIREL_FIREBASE_CONFIG__ || firebaseConfig;

  try {
    const app = initializeApp(cfg, 'header-app');
    const auth = getAuth(app);
    onAuthStateChanged(auth, (user) => {
      const bar = document.getElementById('user-bar');
      const greeting = document.getElementById('user-greeting');
      const loginBtn = document.querySelector('.header-cta .btn-login');
      const signupBtn = document.querySelector('.header-cta .btn-primary');
      if (user) {
        if (bar) { bar.style.display = 'block'; }
        if (greeting) greeting.textContent = `👋 Hi, ${user.displayName || user.email}`;
        if (loginBtn) loginBtn.style.display = 'none';
        if (signupBtn) { signupBtn.textContent = 'My Account'; signupBtn.href = '/my-cards'; }
      }
    });
    document.getElementById('logout-btn')?.addEventListener('click', () => signOut(auth).then(() => location.href = '/'));
  } catch(e) { /* Firebase not configured yet */ }
</script>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('open');
    hamburger.classList.toggle('active');
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 16px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #4F46E5, #7C3AED);
    border-radius: 10px;
    color: white;
    font-weight: 900;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-text {
    font-size: 1.3rem;
    font-weight: 800;
    background: linear-gradient(135deg, #4F46E5, #7C3AED);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    padding: 7px 13px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #374151;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .nav-link:hover, .nav-link.active {
    background: rgba(79, 70, 229, 0.08);
    color: #4F46E5;
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-login {
    padding: 9px 18px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #4F46E5;
    border: 1.5px solid rgba(79,70,229,0.3);
    transition: all 0.15s;
  }

  .btn-login:hover {
    background: rgba(79,70,229,0.06);
    border-color: #4F46E5;
  }

  .header-cta .btn-primary {
    padding: 9px 20px;
    font-size: 0.9rem;
  }

  .user-bar {
    background: rgba(79,70,229,0.04);
    border-bottom: 1px solid rgba(79,70,229,0.1);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #374151;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 24px 20px;
    border-top: 1px solid rgba(0,0,0,0.06);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #374151;
  }

  .mobile-auth {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #F3F4F6;
  }

  .mobile-login {
    flex: 1;
    text-align: center;
    padding: 11px;
    border-radius: 10px;
    font-weight: 600;
    color: #4F46E5;
    border: 1.5px solid rgba(79,70,229,0.3);
    font-size: 0.9rem;
  }

  .mobile-cta {
    flex: 1;
    justify-content: center;
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .nav-links, .header-cta {
      display: none;
    }
    .hamburger {
      display: flex;
    }
  }
</style>
