---

<Layout title="Activities — Experiences for Every City | Virel" description="Discover the best activities, tours, and experiences for your trip. AI-curated highlights, area explorer, and best credit card for every booking.">

  <!-- TOP BAR -->
  <div class="act-topbar">
    <div class="atb-left">
      <button class="atb-menu">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="atb-title">Activities</span>
    </div>
    <div class="atb-pill">
      <div class="atb-field" onclick="openDestPicker()">
        <span class="atb-lbl">WHERE</span>
        <span class="atb-val" id="dest-val">Bali</span>
      </div>
      <div class="atb-sep"></div>
      <div class="atb-field">
        <span class="atb-lbl">MONTH</span>
        <span class="atb-val" id="month-val">Jun 2026</span>
      </div>
      <div class="atb-sep"></div>
      <div class="atb-field atb-prefs">
        <span class="atb-lbl">PREFERENCES</span>
        <span class="atb-val">Couple, Leisure</span>
      </div>
      <button class="atb-go" id="actSearchBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Search
      </button>
    </div>
    <button class="atb-wishlist">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
  </div>

  <!-- DEST PICKER DROPDOWN -->
  <div class="dest-picker" id="destPicker" style="display:none">
    {Object.keys(destData).map(d => (
      <button class="dp-item" onclick={`setDest('${d}')`}>
        <span style="font-size:1.2rem">{(destData as any)[d].emoji}</span>
        <div>
          <div style="font-weight:700;font-size:.88rem;color:#0F172A">{d}</div>
          <div style="font-size:.7rem;color:#94A3B8">{(destData as any)[d].tagline.split('—')[0].trim()}</div>
        </div>
      </button>
    ))}
  </div>

  <!-- DESTINATION INFO BANNER -->
  <div class="dest-banner" id="destBanner">
    <!-- Filled by JS -->
  </div>

  <!-- MAIN CONTENT -->
  <div class="act-content">

    <!-- VIREL PICKS (Signature Experiences) -->
    <section class="vp-section">
      <div class="vp-header">
        <div class="vp-header-left">
          <span class="vp-trophy">✦</span>
          <span class="vp-title">Virel Picks</span>
          <span class="vp-sub"> — signature experiences</span>
        </div>
        <div class="vp-nav">
          <button class="vp-arrow" id="vpPrev">‹</button>
          <button class="vp-arrow" id="vpNext">›</button>
        </div>
      </div>
      <div class="vp-scroll-wrap">
        <div class="vp-scroll" id="vpScroll">
          <!-- Filled by JS -->
        </div>
      </div>
    </section>

    <!-- INSTAGRAM REELS SECTION -->
    <section class="ig-section">
      <div class="ig-header">
        <div>
          <h2 class="ig-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="vertical-align:middle;margin-right:6px"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="url(#igGrad)" stroke-width="2.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="url(#igGrad)" stroke-width="2.5"/><circle cx="17.5" cy="6.5" r="1.2" fill="#EC4899"/><defs><linearGradient id="igGrad" x1="0" y1="0" x2="24" y2="24"><stop offset="0%" stop-color="#F59E0B"/><stop offset="50%" stop-color="#EC4899"/><stop offset="100%" stop-color="#7C3AED"/></linearGradient></defs></svg>
            City Reels
          </h2>
          <p class="ig-sub" id="igSubText">Live Instagram reels from Bali</p>
        </div>
        <a href="#" id="igSeeAll" target="_blank" class="ig-see-all">See all on Instagram →</a>
      </div>
      <div class="ig-reels-row" id="igReelsRow">
        <!-- Filled by JS (Instagram API or placeholder) -->
      </div>
      <div id="ig-api-note" class="ig-api-note" style="display:none">
        🔑 Connect Instagram RapidAPI in settings to show live reels
      </div>
    </section>

    <!-- AREA EXPLORER -->
    <section class="area-section">
      <div class="area-header">
        <h2 class="area-title">Explore areas in <span id="areaDestName">Bali</span></h2>
        <a class="area-see-all">See all ›</a>
      </div>
      <div class="area-scroll-wrap">
        <div class="area-scroll" id="areaScroll">
          <!-- Filled by JS -->
        </div>
        <button class="area-nav-btn area-next" id="areaNextBtn">›</button>
      </div>
    </section>

    <!-- ALL EXPERIENCES -->
    <section class="all-exp-section">
      <div class="ae-header">
        <h2 class="ae-title">All Experiences</h2>
        <div class="ae-cats" id="aeCats">
          <!-- Filled by JS -->
        </div>
      </div>
      <div class="ae-grid" id="aeGrid">
        <!-- Filled by JS -->
      </div>
    </section>

  </div>

  <!-- AI ASK BAR -->
  <div class="ai-bar">
    <div class="ai-bar-inner">
      <span class="ai-bar-icon">✨</span>
      <input type="text" class="ai-bar-input" id="aiInput" placeholder='Ask Virel AI: "Best activities for kids in Bali under ₹2,000"' />
      <button class="ai-bar-send" onclick="handleAiAsk()">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9"/></svg>
      </button>
    </div>
  </div>

</Layout>

<script define:vars={{ destData, categoryColors }}>

let currentDest = 'Bali';
let activeCategory = 'All';

// ── Instagram API via RapidAPI ──────────────────────────────────
// Set your RapidAPI key in public/virel-config.js as:
// window.__VIREL_CONFIG__ = { rapidApiKey: 'YOUR_KEY_HERE' }
const RAPID_API_KEY = window.__VIREL_CONFIG__?.rapidApiKey || '';

async function fetchInstagramReels(hashtag) {
  if (!RAPID_API_KEY) {
    renderIgPlaceholders(hashtag);
    return;
  }
  try {
    const res = await fetch(
      `https://instagram-scraper-api2.p.rapidapi.com/v1/hashtag?hashtag=${encodeURIComponent(hashtag)}&type=clips`,
      {
        headers: {
          'X-RapidAPI-Key': RAPID_API_KEY,
          'X-RapidAPI-Host': 'instagram-scraper-api2.p.rapidapi.com'
        }
      }
    );
    if (!res.ok) throw new Error('API error');
    const data = await res.json();
    const items = data?.data?.items?.slice(0, 8) || [];
    if (items.length === 0) throw new Error('No items');
    renderIgReels(items, hashtag);
  } catch(e) {
    renderIgPlaceholders(hashtag);
  }
}

function renderIgReels(items, hashtag) {
  const row = document.getElementById('igReelsRow');
  if (!row) return;
  row.innerHTML = items.map(item => {
    const thumb = item.thumbnail_url || item.display_url || '';
    const likes  = item.like_count ? `${(item.like_count/1000).toFixed(1)}K` : '';
    const url    = item.shortcode ? `https://www.instagram.com/reel/${item.shortcode}/` : `https://www.instagram.com/explore/tags/${hashtag}/`;
    return `
      <a href="${url}" target="_blank" rel="noopener" class="ig-reel">
        ${thumb ? `<img src="${thumb}" alt="Reel" class="ig-reel-img" loading="lazy"/>` : `<div class="ig-reel-ph"></div>`}
        <div class="ig-reel-overlay">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="opacity:.8"><polygon points="5,3 19,12 5,21"/></svg>
          ${likes ? `<span class="ig-reel-likes">♥ ${likes}</span>` : ''}
        </div>
      </a>
    `;
  }).join('');
  document.getElementById('ig-api-note').style.display = 'none';
}

function renderIgPlaceholders(hashtag) {
  const row = document.getElementById('igReelsRow');
  if (!row) return;
  const grads = [
    'linear-gradient(160deg,#059669,#10B981)','linear-gradient(160deg,#0891B2,#06B6D4)',
    'linear-gradient(160deg,#7C3AED,#EC4899)','linear-gradient(160deg,#B45309,#D97706)',
    'linear-gradient(160deg,#BE185D,#EC4899)','linear-gradient(160deg,#1E3A5F,#3B82F6)',
    'linear-gradient(160deg,#166534,#16A34A)','linear-gradient(160deg,#D97706,#F59E0B)',
  ];
  const emojis = ['🌴','🛕','🌋','🤿','🎭','🌅','🌿','🐒'];
  row.innerHTML = grads.map((g,i) => `
    <a href="https://www.instagram.com/explore/tags/${hashtag}/" target="_blank" rel="noopener" class="ig-reel">
      <div class="ig-reel-ph" style="background:${g}">
        <span style="font-size:2rem">${emojis[i]}</span>
      </div>
      <div class="ig-reel-overlay">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="opacity:.8"><polygon points="5,3 19,12 5,21"/></svg>
      </div>
    </a>
  `).join('');
  if (!RAPID_API_KEY) {
    document.getElementById('ig-api-note').style.display = 'block';
  }
}

// ── Render functions ──────────────────────────────────────────
function renderBanner(dest) {
  const d = destData[dest];
  const banner = document.getElementById('destBanner');
  if (!banner || !d) return;
  const crowdClass = d.crowd.level === 'High' ? 'crowd-high' : d.crowd.level === 'Low' ? 'crowd-low' : 'crowd-med';
  banner.innerHTML = `
    <div class="db-left">
      <div class="db-dest-icon" style="background:${d.grad}">${d.emoji}</div>
      <div>
        <h2 class="db-name">${dest}</h2>
        <p class="db-tagline">${d.tagline}</p>
      </div>
    </div>
    <div class="db-stats">
      <div class="db-stat">
        <span class="db-stat-icon">💰</span>
        <div>
          <div class="db-stat-label">Avg. Cost (per day)</div>
          <div class="db-stat-value">₹${d.budget.min.toLocaleString()} – ₹${d.budget.max.toLocaleString()}</div>
          <div class="db-stat-note">${d.budgetNote}</div>
        </div>
      </div>
      <div class="db-stat-sep"></div>
      <div class="db-stat">
        <span class="db-stat-icon">${d.weather.icon}</span>
        <div>
          <div class="db-stat-label">Weather</div>
          <div class="db-stat-value">${d.weather.temp}</div>
          <div class="db-stat-note">${d.weather.desc}</div>
        </div>
      </div>
      <div class="db-stat-sep"></div>
      <div class="db-stat">
        <span class="db-stat-icon">👥</span>
        <div>
          <div class="db-stat-label">Crowd Level</div>
          <div class="db-stat-crowd ${crowdClass}">${d.crowd.level}</div>
          <div class="db-stat-note">${d.crowd.note}</div>
        </div>
      </div>
    </div>
  `;
}

function renderHighlights(dest) {
  const items = destData[dest]?.highlights || [];
  const scroll = document.getElementById('vpScroll');
  if (!scroll) return;
  scroll.innerHTML = items.map(h => {
    const cat = categoryColors[h.cat] || { bg:'#F1F5F9', text:'#475569', border:'#E2E8F0' };
    return `
      <div class="vp-card">
        <div class="vp-card-num">${h.n}</div>
        <div class="vp-card-desc">${h.desc}</div>
        <div class="vp-card-visual">
          <div class="vp-card-emoji">${h.emoji}</div>
          <button class="vp-heart" onclick="this.classList.toggle('saved')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
        </div>
        <div class="vp-card-footer">
          <div class="vp-card-name">${h.name}</div>
          <div class="vp-card-meta">
            <span class="vp-cat-badge" style="background:${cat.bg};color:${cat.text};border-color:${cat.border}">${h.cat}</span>
            <span class="vp-price">${h.price}</span>
            <span class="vp-dur">⏱ ${h.dur}</span>
          </div>
          <div class="vp-card-tip">💳 ${h.card}</div>
        </div>
      </div>
    `;
  }).join('');
}

function renderAreas(dest) {
  const areas = destData[dest]?.areas || [];
  const scroll = document.getElementById('areaScroll');
  const title  = document.getElementById('areaDestName');
  if (title) title.textContent = dest;
  if (!scroll) return;
  scroll.innerHTML = areas.map(a => `
    <div class="area-card">
      <div class="area-card-top" style="background:${a.grad}">
        <div class="area-emoji">${a.emoji}</div>
      </div>
      <div class="area-card-body">
        <div class="area-name">${a.name}</div>
        <div class="area-known">Known for: ${a.known}</div>
      </div>
      <div class="area-nav-arrow">›</div>
    </div>
  `).join('');
}

function renderAllActivities(dest, filterCat) {
  const items = destData[dest]?.highlights || [];
  const filtered = filterCat === 'All' ? items : items.filter(h => h.cat === filterCat);
  const grid = document.getElementById('aeGrid');
  if (!grid) return;
  grid.innerHTML = filtered.map(h => {
    const cat = categoryColors[h.cat] || { bg:'#F1F5F9', text:'#475569', border:'#E2E8F0' };
    const coins = Math.round(parseInt(h.price.replace(/[^0-9–]/g,'').split('–')[0]||'500') / 10);
    return `
      <div class="ae-card">
        <div class="ae-card-left">
          <div class="ae-emoji-wrap" style="background:${cat.bg}">${h.emoji}</div>
        </div>
        <div class="ae-card-body">
          <div class="ae-card-top-row">
            <h3 class="ae-card-name">${h.name}</h3>
            <span class="ae-cat" style="background:${cat.bg};color:${cat.text};border-color:${cat.border}">${h.cat}</span>
          </div>
          <p class="ae-desc">${h.desc}</p>
          <div class="ae-meta">
            <span class="ae-price">₹ ${h.price}</span>
            <span class="ae-dur">⏱ ${h.dur}</span>
            <span class="ae-coins">🪙 ~${coins} coins</span>
          </div>
          <div class="ae-card-tip">💳 Best card: <strong>${h.card}</strong></div>
        </div>
        <div class="ae-card-actions">
          <button class="ae-save" onclick="this.textContent=this.textContent==='♡'?'♥':'♡'">♡</button>
          <a href="/trip-board?dest=${dest}" class="ae-book">Book →</a>
        </div>
      </div>
    `;
  }).join('');
}

function renderCategoryFilter(dest) {
  const items  = destData[dest]?.highlights || [];
  const cats   = ['All', ...new Set(items.map(h => h.cat))];
  const catsEl = document.getElementById('aeCats');
  if (!catsEl) return;
  catsEl.innerHTML = cats.map(c => `
    <button class="ae-cat-btn ${c === activeCategory ? 'active' : ''}" onclick="filterCat('${c}')">${c}</button>
  `).join('');
}

// ── Controls ─────────────────────────────────────────────────
function setDest(dest) {
  currentDest = dest;
  activeCategory = 'All';
  document.getElementById('dest-val').textContent = dest;
  document.getElementById('destPicker').style.display = 'none';
  document.getElementById('igSubText').textContent = `Live Instagram reels from ${dest}`;
  document.getElementById('igSeeAll').href = `https://www.instagram.com/explore/tags/${dest.toLowerCase()}/`;
  renderBanner(dest);
  renderHighlights(dest);
  renderAreas(dest);
  renderCategoryFilter(dest);
  renderAllActivities(dest, 'All');
  fetchInstagramReels(dest.toLowerCase());
}
window.setDest = setDest;

function openDestPicker() {
  const p = document.getElementById('destPicker');
  p.style.display = p.style.display === 'none' ? 'flex' : 'none';
}
window.openDestPicker = openDestPicker;

function filterCat(cat) {
  activeCategory = cat;
  renderCategoryFilter(currentDest);
  renderAllActivities(currentDest, cat);
}
window.filterCat = filterCat;

// Scroll arrows for Virel Picks
document.getElementById('vpPrev')?.addEventListener('click', () => {
  document.getElementById('vpScroll')?.scrollBy({ left: -320, behavior: 'smooth' });
});
document.getElementById('vpNext')?.addEventListener('click', () => {
  document.getElementById('vpScroll')?.scrollBy({ left: 320, behavior: 'smooth' });
});
document.getElementById('areaNextBtn')?.addEventListener('click', () => {
  document.getElementById('areaScroll')?.scrollBy({ left: 300, behavior: 'smooth' });
});

document.getElementById('actSearchBtn')?.addEventListener('click', () => {
  setDest(document.getElementById('dest-val').textContent || 'Bali');
});

document.addEventListener('click', e => {
  if (!e.target.closest('#destPicker') && !e.target.closest('[onclick="openDestPicker()"]')) {
    document.getElementById('destPicker').style.display = 'none';
  }
});

function handleAiAsk() {
  const inp = document.getElementById('aiInput');
  if (!inp?.value) return;
  const q = inp.value; inp.value = '';
  const inner = document.querySelector('.ai-bar-inner');
  const backup = inner.innerHTML;
  inner.innerHTML = `<span class="ai-bar-icon">🤔</span><span style="color:#64748B;font-size:.85rem">Thinking about: "${q}"...</span>`;
  setTimeout(() => { inner.innerHTML = backup; }, 2800);
}
window.handleAiAsk = handleAiAsk;

// Init
document.addEventListener('DOMContentLoaded', () => {
  const now = new Date();
  document.getElementById('month-val').textContent =
    now.toLocaleDateString('en-US', { month:'short', year:'numeric' });
  setDest('Bali');
});
