    budget:'₹1.5L–4L', days:'5–7', best:'Apr–Jun',
    grad:'linear-gradient(160deg,#7C3AED,#A78BFA,#DDD6FE)',
    img:'https://images.unsplash.com/photo-1499856871958-5b9627545d1a?w=600&q=80&auto=format&fit=crop',
    desc:'Eiffel Tower, world-class cuisine, art museums and romantic riverside walks.',
    activities:['🗼 Eiffel Tower summit at night','🖼️ Louvre Museum guided tour','🛥️ Seine River dinner cruise'],
  },
