---
import Layout from '../layouts/Layout.astro';

const destinations = [
  {
    name:'Goa', country:'India', emoji:'🏖️', tag:'Beach',
    budget:'₹15K–35K', days:'3–5', best:'Oct–Mar',
    grad:'linear-gradient(160deg,#10B981,#059669,#14B8A6)',
