    name:'Singapore', country:'Singapore', emoji:'🌃', tag:'Modern',
    budget:'₹50K–1.2L', days:'3–5', best:'Feb–Apr',
    grad:'linear-gradient(160deg,#1E293B,#7C3AED,#EC4899)',
    img:'https://images.unsplash.com/photo-1525625293386-3f8f99389edd?w=600&q=80&auto=format&fit=crop',
    desc:'Gardens by the Bay, world-class food, Universal Studios and Marina Bay.',
    activities:['🌿 Gardens by the Bay Supertrees','🎢 Universal Studios Singapore','🦁 Singapore Night Safari'],
  },
  {
    name:'Kerala', country:'India', emoji:'⛵', tag:'Nature',
    budget:'₹10K–28K', days:'4–7', best:'Sep–Mar',
    grad:'linear-gradient(160deg,#166534,#16A34A,#4ADE80)',
    img:'https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=600&q=80&auto=format&fit=crop',
    desc:'Backwater cruises, spice plantations, Ayurveda retreats and misty hill stations.',
    activities:['⛵ Houseboat cruise on Alleppey backwaters','🌿 Munnar tea plantation trek','💆 Ayurvedic spa retreat'],
  },
  {
    name:'Manali', country:'India', emoji:'❄️', tag:'Mountains',
    budget:'₹8K–20K', days:'3–6', best:'May–Jun',
    grad:'linear-gradient(160deg,#475569,#7C3AED,#C4B5FD)',
    img:'https://images.unsplash.com/photo-1548013146-72479768bada?w=600&q=80&auto=format&fit=crop',
    desc:'Snow-capped peaks, adventure sports, Rohtang Pass and apple orchards.',
    activities:['🏔️ Rohtang Pass snow trek','🚣 River rafting on Beas','🛷 Solang Valley adventure sports'],
  },
  {
    name:'Tokyo', country:'Japan', emoji:'🌸', tag:'Culture',
    budget:'₹1.2L–3L', days:'5–8', best:'Mar–May',
    grad:'linear-gradient(160deg,#9D174D,#EC4899,#FBCFE8)',
    img:'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=600&q=80&auto=format&fit=crop',
