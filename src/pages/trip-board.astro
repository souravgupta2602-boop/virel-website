  },
  {
    name:'Mumbai', country:'India', emoji:'🌆', tag:'City',
    budget:'₹6K–18K', days:'2–4', best:'Oct–Feb',
    grad:'linear-gradient(160deg,#7C2D12,#EA580C,#FB923C)',
    img:'https://images.unsplash.com/photo-1529253355930-ddbe423a2ac7?w=600&q=80&auto=format&fit=crop',
    desc:'Bollywood city, street food, Marine Drive, art deco architecture.',
    activities:['🎬 Bollywood studio tour','🚢 Gateway of India & Elephanta Caves','🌊 Marine Drive sunset walk'],
  },
  {
    name:'London', country:'UK', emoji:'🎡', tag:'Classic',
    budget:'₹1.5L–4L', days:'5–7', best:'Apr–Aug',
    grad:'linear-gradient(160deg,#1E293B,#475569,#94A3B8)',
    img:'https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=600&q=80&auto=format&fit=crop',
    desc:'Buckingham Palace, world-class museums, iconic pubs and theatre shows.',
    activities:['🏰 Tower of London Crown Jewels','🎭 West End theatre show','🛥️ Thames River cruise'],
  },
  {
    name:'Rajasthan', country:'India', emoji:'🐪', tag:'Heritage',
    budget:'₹12K–35K', days:'7–10', best:'Oct–Mar',
    grad:'linear-gradient(160deg,#D97706,#B45309,#92400E)',
    img:'https://images.unsplash.com/photo-1599661046289-e31897846e41?w=600&q=80&auto=format&fit=crop',
    desc:'Desert safaris, royal havelis, colourful festivals and delicious local cuisine.',
    activities:['🏰 Mehrangarh Fort Jodhpur','🌙 Sam Sand Dunes overnight camp','🎪 Pushkar Camel Fair'],
  },
  {
    name:'Andaman', country:'India', emoji:'🤿', tag:'Beach',
    budget:'₹20K–50K', days:'5–7', best:'Oct–May',
    grad:'linear-gradient(160deg,#059669,#10B981,#6EE7B7)',
    img:'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&q=80&auto=format&fit=crop',
    desc:'Pristine white beaches, coral reefs, clear blue water and water sports.',
    activities:['🤿 Scuba diving at Havelock Island','🏖️ Radhanagar Beach sunset','🔦 Cellular Jail light & sound show'],
  },
];

const tripTypes = ['Solo', 'Couple', 'Family', 'Friends', 'Honeymoon', 'Adventure'];
const tags      = ['All', 'Beach', 'Mountains', 'Heritage', 'City', 'Nature', 'Island', 'Luxury', 'Adventure', 'Romantic', 'Culture'];
const destsJson = JSON.stringify(destinations);
---

<Layout title="Virel Blueprints — AI Travel Planner | Virel" description="Plan your perfect trip with AI. Day-by-day itineraries, smart hotel picks, curated experiences and best credit card for every destination.">

  <!-- HERO -->
  <section class="tb-hero">
    <div class="tbh-bg"></div>
    <div class="tbh-glow g1"></div>
    <div class="tbh-glow g2"></div>
    <div class="container tbh-inner">
      <span class="section-label" style="background:rgba(255,255,255,.1);color:white;border-color:rgba(255,255,255,.2);margin-bottom:16px">✨ AI-Powered Trip Planning</span>
      <h1 class="tbh-title">Your travel <span class="tbh-grad">Blueprints.</span></h1>
      <p class="tbh-sub">Tell us your destination and travel style. Virel builds the perfect day-by-day blueprint — hotels, activities, experiences, and the best card to use at every stop.</p>

      <!-- Search Box -->
      <div class="search-box">
        <div class="search-row">
          <div class="search-field sf-dest">
            <span class="sf-icon">🌍</span>
            <input id="destInput" type="text" placeholder="Where do you want to go?" class="sf-input" list="dest-list" />
            <datalist id="dest-list">
              {destinations.map(d => <option value={d.name + ', ' + d.country} />)}
            </datalist>
          </div>
          <div class="search-field sf-dates">
            <span class="sf-icon">📅</span>
            <input id="dateInput" type="date" class="sf-input" />
          </div>
          <div class="search-field sf-type">
            <span class="sf-icon">👤</span>
            <select id="tripTypeInput" class="sf-input sf-select">
              <option value="">Trip Type</option>
              {tripTypes.map(t => <option value={t}>{t}</option>)}
            </select>
          </div>
          <button id="planBtn" class="search-btn">✨ Build Blueprint</button>
        </div>
        <div class="search-chips">
          <span class="sc-label">Popular:</span>
          {['Goa', 'Bali', 'Dubai', 'Jaipur', 'Maldives', 'Kerala'].map(d => (
            <button class="sc-chip" onclick={`quickPlan('${d}')`}>{d}</button>
          ))}
        </div>
      </div>

      <div class="tbh-stats">
        {[['16+','Destinations'],['AI','Blueprints'],['50+','Activities'],['30%','Cashback']].map(([v,l]) => (
          <div class="tbhs"><span class="tbhs-val">{v}</span><span class="tbhs-lbl">{l}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI ITINERARY RESULT -->
  <section id="itinerary-section" class="itinerary-sec" style="display:none">
    <div class="container">
      <div class="itin-header">
        <div>
          <h2 class="itin-title" id="itin-title">Your Blueprint</h2>
          <p class="itin-sub" id="itin-sub">Personalised just for you</p>
        </div>
        <a href="/travel" class="itin-book-btn">Book This Trip →</a>
      </div>
      <div id="itin-content" class="itin-grid"></div>
    </div>
  </section>

  <!-- DESTINATION EXPLORER -->
  <section class="dest-explorer">
    <div class="container">
      <div class="sec-hdr">
        <span class="section-label">🗺️ Explore Destinations</span>
        <h2 class="section-title">Pick your next Blueprint</h2>
        <p class="section-sub" style="margin:0 auto">Each destination comes with curated activities, top stays, and the best card to use.</p>
      </div>

      <!-- Tag Filters -->
      <div class="filters">
        <div class="filter-chips" id="tag-filters">
          {tags.map((t, i) => (
            <button class:list={['filter-chip', { active: i === 0 }]} data-tag={t}>{t}</button>
          ))}
        </div>
      </div>

      <!-- Destination Cards with Real Images -->
      <div class="dest-grid" id="dest-grid">
        {destinations.map(d => (
          <div class="dest-card" data-tag={d.tag} data-name={d.name}>
            <!-- Photo header -->
            <div class="dest-img-wrap">
              <img
                src={d.img}
                alt={d.name}
                class="dest-photo"
                loading="lazy"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
              />
              <div class="dest-photo-fallback" style={`background:${d.grad};display:none`}></div>
              <div class="dest-img-overlay"></div>
              <span class="dest-tag-badge">{d.tag}</span>
              <span class="dest-best-time">🗓️ {d.best}</span>
              <div class="dest-country-chip">{d.emoji} {d.name}</div>
            </div>

            <!-- Card body -->
            <div class="dest-body">
              <div class="dest-meta-row">
                <span class="dest-meta-item">📅 {d.days} days</span>
                <span class="dest-meta-item">💰 {d.budget}</span>
                <span class="dest-meta-item">📍 {d.country}</span>
              </div>
              <p class="dest-desc">{d.desc}</p>

              <!-- Activities -->
              <div class="dest-activities">
                <span class="act-label">Top Activities</span>
                <div class="act-list">
                  {d.activities.map(a => (
                    <span class="act-chip">{a}</span>
                  ))}
                </div>
              </div>

              <div class="dest-actions">
                <button class="dest-plan-btn" onclick={`planTrip('${d.name}')`}>✨ Build Blueprint</button>
                <a href="/travel" class="dest-book-btn">Book Flights →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SMART FEATURES -->
  <section class="smart-sec">
    <div class="container">
      <div class="sec-hdr">
        <span class="section-label">🎯 What's in every Blueprint</span>
        <h2 class="section-title">More than just itineraries</h2>
      </div>
      <div class="smart-grid">
        {[
          { icon:'🏨', title:'Smart Hotel Picks', desc:'AI recommends hotels based on your style, budget, and which credit card gives the best rewards.', grad:'linear-gradient(135deg,#8B5CF6,#7C3AED)' },
          { icon:'🎭', title:'Curated Activities', desc:'Handpicked local tours, cooking classes, adventure sports, and cultural experiences at every destination.', grad:'linear-gradient(135deg,#EC4899,#FF6B35)' },
          { icon:'💳', title:'Card Suggestions', desc:'At every hotel, restaurant, and activity — Virel tells you which card to pay with for maximum rewards.', grad:'linear-gradient(135deg,#FF6B35,#F59E0B)' },
          { icon:'👥', title:'Group Planning', desc:'Split costs, share itineraries, and plan together with friends and family from a single dashboard.', grad:'linear-gradient(135deg,#10B981,#059669)' },
          { icon:'📅', title:'Flexible Dates', desc:"Not sure when to go? Tell us your budget and we'll find the cheapest dates to fly and stay.", grad:'linear-gradient(135deg,#7C3AED,#A78BFA)' },
          { icon:'✈️', title:'Flight + Hotel Bundles', desc:'Compare prices across Amadeus, Duffel, and Booking.com. Book the best deal in one click.', grad:'linear-gradient(135deg,#F59E0B,#EC4899)' },
        ].map(f => (
          <div class="smart-card">
            <div class="smart-icon" style={`background:${f.grad}`}>{f.icon}</div>
            <h3 class="smart-title">{f.title}</h3>
            <p class="smart-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GROUP TRIP TEASER -->
  <section class="group-sec">
    <div class="gs-bg"></div>
    <div class="container gs-inner">
      <div class="gs-content">
        <span class="section-label" style="background:rgba(255,255,255,.1);color:white;border-color:rgba(255,255,255,.2)">👥 Coming Soon</span>
        <h2 class="section-title" style="color:white">Group Blueprints</h2>
        <p class="section-sub" style="color:rgba(255,255,255,.72)">Plan trips with your friends and family. Shared blueprints, split costs, group rewards, and a dedicated family dashboard.</p>
        <form class="gs-form" onsubmit="handleWaitlist(event)">
          <input type="email" placeholder="your@email.com" class="gs-email" required />
          <button type="submit" class="gs-submit">Join Waitlist ✨</button>
        </form>
        <div class="gs-features">
          {['Shared Itineraries','Cost Splitting','Group Rewards','Family Dashboard'].map(f => (
            <span class="gs-feat">✓ {f}</span>
          ))}
        </div>
      </div>
      <div class="gs-visual">
        <div class="gs-card">
          <div class="gs-card-header">
            <span style="font-weight:900;font-size:.9rem;color:#0F172A">Goa Trip · Dec 2025</span>
            <span style="font-size:.68rem;background:#EDE9FE;color:#7C3AED;padding:3px 9px;border-radius:100px;font-weight:700">4 Members</span>
          </div>
          {[
            { name:'You', avatar:'😎', status:'Confirmed', spend:'₹12,400' },
            { name:'Priya', avatar:'👩', status:'Confirmed', spend:'₹11,800' },
            { name:'Arjun', avatar:'👨', status:'Pending', spend:'₹0' },
            { name:'Neha', avatar:'👩‍🦱', status:'Confirmed', spend:'₹9,600' },
          ].map(m => (
            <div class="gs-member">
              <span style="font-size:1.2rem">{m.avatar}</span>
              <div style="flex:1">
                <div style="font-size:.75rem;font-weight:700;color:#1E293B">{m.name}</div>
                <div style={`font-size:.62rem;font-weight:600;color:${m.status==='Confirmed'?'#10B981':'#F59E0B'}`}>{m.status}</div>
              </div>
              <div style="font-size:.75rem;font-weight:800;color:#7C3AED">{m.spend}</div>
            </div>
          ))}
          <div class="gs-total">
            <span style="font-size:.72rem;font-weight:700;color:#64748B">Total Group Spend</span>
            <span style="font-size:.85rem;font-weight:900;color:#0F172A">₹33,800</span>
          </div>
          <div class="gs-savings">🎁 Group earned 2,840 Virel Coins together</div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ destsJson }}>
const destinations = JSON.parse(destsJson);

// Quick plan from hero chips
function quickPlan(dest) {
  document.getElementById('destInput').value = dest;
  document.getElementById('planBtn').click();
}
window.quickPlan = quickPlan;

// Plan trip from destination card
function planTrip(dest) {
  document.getElementById('destInput').value = dest;
  window.scrollTo({ top: 0, behavior: 'smooth' });
  setTimeout(() => document.getElementById('planBtn').click(), 600);
}
window.planTrip = planTrip;

// Tag filters
document.getElementById('tag-filters')?.querySelectorAll('.filter-chip').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#tag-filters .filter-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const tag = btn.dataset.tag;
    document.querySelectorAll('#dest-grid .dest-card').forEach(card => {
      card.style.display = (tag === 'All' || card.dataset.tag === tag) ? '' : 'none';
    });
  });
});

// AI Plan button
document.getElementById('planBtn')?.addEventListener('click', () => {
  const dest = document.getElementById('destInput')?.value;
  if (!dest) { alert('Please enter a destination'); return; }
  const btn = document.getElementById('planBtn');
  btn.textContent = '⏳ Building...';
  btn.disabled = true;
  setTimeout(() => {
    btn.textContent = '✨ Build Blueprint';
    btn.disabled = false;
    generateItinerary(dest);
  }, 1500);
});

function generateItinerary(destRaw) {
  const dest = destRaw.split(',')[0].trim();
  const section = document.getElementById('itinerary-section');
  const title   = document.getElementById('itin-title');
  const sub     = document.getElementById('itin-sub');
  const content = document.getElementById('itin-content');

  const d = destinations.find(x => x.name.toLowerCase() === dest.toLowerCase());
  const acts = d ? d.activities : ['🎯 Explore local highlights','🍽️ Try authentic cuisine','📸 Visit iconic landmarks'];

  const itineraries = {
    'Goa': [
      { day:1, icon:'🛬', title:'Arrival & North Goa', activities:['Check in to beach resort', acts[0], 'Dinner at Thalassa'] },
      { day:2, icon:'🏖️', title:'Beach Hopping', activities:['Anjuna flea market','Vagator cliff views', acts[1]] },
      { day:3, icon:'🚤', title:'Water Sports & Heritage', activities:[acts[0],'Old Goa churches tour','Spice plantation lunch'] },
      { day:4, icon:'🌅', title:'South Goa & Departure', activities:['Palolem beach walk',acts[2],'Evening flight home'] },
    ],
    'Bali': [
      { day:1, icon:'🛬', title:'Arrival — Seminyak', activities:['Check in','Sunset at Tanah Lot', acts[2]] },
      { day:2, icon:'🌿', title:'Ubud Cultural Day', activities:[acts[1],'Tirta Empul holy spring','Rice terrace walk'] },
      { day:3, icon:'🏄', title:'Adventure & Surf', activities:[acts[0],'Uluwatu temple',acts[2]] },
      { day:4, icon:'🤿', title:'Nusa Penida', activities:[acts[2],'Crystal Bay snorkeling','Kelingking Beach viewpoint'] },
    ],
    'Dubai': [
      { day:1, icon:'🛬', title:'Arrival & Downtown', activities:[acts[0],'Dubai Fountain show', acts[2]] },
      { day:2, icon:'🐪', title:'Desert Adventure', activities:[acts[1],'Camel riding','Bedouin BBQ dinner'] },
      { day:3, icon:'🛍️', title:'Shopping & JBR', activities:['Dubai Marina walk',acts[2],'Gold & Spice Souk'] },
    ],
  };

  const days = itineraries[dest] || [
    { day:1, icon:'🛬', title:'Arrival & Orientation', activities:['Check in to hotel', acts[0] || 'Explore surroundings', 'Welcome dinner'] },
    { day:2, icon:'🎯', title:'Main Highlights', activities:[acts[1] || 'City sightseeing', acts[0] || 'Local market visit', 'Best restaurant dinner'] },
    { day:3, icon:'✨', title:'Experiences', activities:[acts[2] || 'Day trip', 'Sunset viewing', 'Souvenir shopping'] },
    { day:4, icon:'🛫', title:'Departure Day', activities:['Breakfast at hotel','Last-minute shopping','Airport transfer'] },
  ];

  title.textContent  = `${dest} Blueprint`;
  sub.textContent    = `${days.length}-day itinerary · Best card: HDFC Infinia or Axis Magnus`;

  content.innerHTML = days.map(day => `
    <div class="itin-day">
      <div class="itin-day-header">
        <span class="itin-day-num">Day ${day.day}</span>
        <span class="itin-day-icon">${day.icon}</span>
        <span class="itin-day-title">${day.title}</span>
      </div>
      <ul class="itin-acts">
        ${day.activities.map(a => `<li><span class="itin-dot">◆</span>${a}</li>`).join('')}
      </ul>
    </div>
  `).join('');

  section.style.display = 'block';
  section.scrollIntoView({ behavior:'smooth', block:'start' });
}

function handleWaitlist(e) {
  e.preventDefault();
  const form = e.target;
  form.innerHTML = '<div style="color:white;font-weight:700;text-align:center;padding:12px">✅ You\'re on the list! We\'ll notify you when Group Blueprints launches.</div>';
}
window.handleWaitlist = handleWaitlist;

// Pre-fill destination from URL param
const urlParams = new URLSearchParams(window.location.search);
const paramDest = urlParams.get('dest');
if (paramDest) {
  const input = document.getElementById('destInput');
  if (input) { input.value = paramDest; }
}
</script>

