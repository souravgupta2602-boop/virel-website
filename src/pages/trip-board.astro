<Layout title="Virel Blueprints — Full Trip Planner | Virel">

<!-- TOP BAR -->
<div class="bp-topbar">
  <div class="bp-topbar-inner">
    <div class="bp-tb-left">
      <span class="bp-logo">✨ Virel Blueprints</span>
      <span class="bp-badge">AI-Powered</span>
    </div>
    <div class="bp-tb-center">
      <input type="text" id="globalSearch" placeholder="Search destination…" class="bp-search" />
    </div>
    <div class="bp-tb-right">
      <button class="bp-mix-toggle" id="mixToggle" onclick="toggleMixMode()">🔀 Mix & Match</button>
      <button class="bp-saved-btn" id="savedBtn" onclick="openSaved()">
        📋 My Blueprints <span class="bp-saved-count" id="savedCount">0</span>
      </button>
    </div>
  </div>
</div>

<!-- MAIN LAYOUT -->
<div class="bp-layout">

  <!-- SIDEBAR -->
  <aside class="bp-sidebar" id="sidebar">
    <div class="sb-header">
      <span class="sb-title">Destinations</span>
      <span class="sb-count" id="sbCount">12</span>
    </div>

    <!-- Mix & Match multi-select info -->
    <div class="mix-info" id="mixInfo" style="display:none">
      <div class="mix-info-text">Select 2–4 cities to build a combined route</div>
      <button class="mix-generate-btn" id="mixGenerateBtn" onclick="generateMixItinerary()" style="display:none">
        🗺️ Build Combined Route
      </button>
    </div>

    <div class="sb-list" id="sbList">
      <!-- Filled by JS -->
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="bp-main" id="bpMain">

    <!-- IMAGE SLIDER -->
    <div class="slider-wrap" id="sliderWrap">
      <div class="slider-track" id="sliderTrack"></div>
      <button class="slider-btn slider-prev" onclick="slidePrev()">‹</button>
      <button class="slider-btn slider-next" onclick="slideNext()">›</button>
      <div class="slider-dots" id="sliderDots"></div>
      <div class="slider-overlay">
        <div class="so-left">
          <h1 class="so-name" id="soName">Goa</h1>
          <div class="so-country" id="soCountry">🇮🇳 India · Beach</div>
        </div>
        <div class="so-right">
          <div class="so-budget" id="soBudget">₹15K–35K</div>
          <div class="so-days" id="soDays">3–5 days</div>
        </div>
      </div>
    </div>

    <!-- DEST INFO BAR -->
    <div class="dest-info-bar" id="destInfoBar">
      <div class="dib-item"><span class="dib-label">Best Season</span><span class="dib-val" id="dibBest">Oct–Mar</span></div>
      <div class="dib-sep"></div>
      <div class="dib-item"><span class="dib-label">Currency</span><span class="dib-val" id="dibCurrency">₹ INR</span></div>
      <div class="dib-sep"></div>
      <div class="dib-item"><span class="dib-label">Visa</span><span class="dib-val" id="dibVisa">Not required</span></div>
      <div class="dib-sep"></div>
      <div class="dib-item"><span class="dib-label">Ideal Duration</span><span class="dib-val" id="dibDays">3–5 days</span></div>
      <div class="dib-sep"></div>
      <button class="theme-btn" id="themeBtn" onclick="applyTheme()">🎨 Apply Country Theme</button>
    </div>

    <!-- FLIGHT COSTS -->
    <div class="section-card" id="flightCard">
      <div class="sc-header">
        <span class="sc-icon">✈️</span>
        <h2 class="sc-title">Estimated Flights</h2>
        <span class="sc-sub">One-way from India (Economy)</span>
      </div>
      <div class="flight-grid" id="flightGrid"></div>
      <div class="sc-note">💳 Best card: <strong>Axis Magnus</strong> (12 RP/₹200) or <strong>HDFC Regalia</strong> (5x miles)</div>
    </div>

    <!-- PACKAGE SUMMARY -->
    <div class="section-card pkg-summary" id="pkgSummary">
      <div class="sc-header">
        <span class="sc-icon">📦</span>
        <h2 class="sc-title">Full Package Estimate</h2>
        <span class="sc-sub">Per person · includes flights, hotel, activities</span>
      </div>
      <div class="pkg-grid" id="pkgGrid"></div>
      <div class="pkg-cta">
        <button class="build-btn" onclick="openBuilder()">✨ Build This Blueprint</button>
        <button class="copy-btn" onclick="copyItinerary()">📋 Copy Itinerary</button>
      </div>
    </div>

    <!-- HOTELS -->
    <div class="section-card" id="hotelsCard">
      <div class="sc-header">
        <span class="sc-icon">🏨</span>
        <h2 class="sc-title">Recommended Hotels</h2>
        <span class="sc-sub">Sorted by best value · add to blueprint</span>
      </div>
      <div class="hotels-row" id="hotelsRow"></div>
    </div>

    <!-- ACTIVITIES -->
    <div class="section-card" id="activitiesCard">
      <div class="sc-header">
        <span class="sc-icon">🎭</span>
        <h2 class="sc-title">Top Activities & Experiences</h2>
        <span class="sc-sub">Click to add to your blueprint</span>
      </div>
      <div class="acts-grid" id="actsGrid"></div>
    </div>

    <!-- DAY-BY-DAY ITINERARY PREVIEW -->
    <div class="section-card" id="itinCard">
      <div class="sc-header">
        <span class="sc-icon">📅</span>
        <h2 class="sc-title">Sample Day-by-Day Itinerary</h2>
        <span class="sc-sub">Edit this in the Blueprint Builder →</span>
      </div>
      <div class="itin-days" id="itinDays"></div>
      <div class="itin-cta">
        <button class="build-btn" onclick="openBuilder()">✨ Open Blueprint Builder & Edit</button>
      </div>
    </div>

  </main>
</div>

<!-- BLUEPRINT BUILDER DRAWER -->
<div class="builder-overlay" id="builderOverlay" onclick="if(event.target===this)closeBuilder()"></div>
<div class="builder-drawer" id="builderDrawer">
  <div class="bd-header">
    <div class="bd-title-row">
      <h2 class="bd-title" id="bdTitle">Blueprint Builder</h2>
      <button class="bd-close" onclick="closeBuilder()">✕</button>
    </div>
    <div class="bd-dest-info" id="bdDestInfo"></div>
    <div class="bd-cost-bar">
      <span class="bd-cost-label">Running Total</span>
      <span class="bd-cost-val" id="bdTotal">₹0</span>
    </div>
  </div>

  <div class="bd-body">
    <!-- Quick Add -->
    <div class="bd-quick-add">
      <span class="bq-label">Quick add:</span>
      <div class="bq-chips" id="bqChips"></div>
    </div>

    <!-- Editable Days -->
    <div class="bd-days" id="bdDays"></div>

    <!-- Add Day -->
    <button class="bd-add-day" onclick="addDay()">+ Add Day</button>
  </div>

  <div class="bd-footer">
    <button class="bd-save-btn" onclick="saveBlueprint()">💾 Save to My Blueprints</button>
    <button class="bd-share-btn" onclick="copyItinerary()">📋 Copy Text</button>
  </div>
</div>

<!-- SAVED BLUEPRINTS PANEL -->
<div class="saved-overlay" id="savedOverlay" onclick="if(event.target===this)closeSaved()"></div>
<div class="saved-panel" id="savedPanel">
  <div class="sp-header">
    <h2 class="sp-title">My Blueprints</h2>
    <button class="bd-close" onclick="closeSaved()">✕</button>
  </div>
  <div class="sp-body" id="spBody"></div>
</div>

<!-- MIX & MATCH RESULT -->
<div class="mix-result" id="mixResult" style="display:none">
  <div class="container">
    <div class="mr-header">
      <h2 class="mr-title" id="mrTitle">Multi-City Blueprint</h2>
      <button class="mr-build" onclick="openBuilderFromMix()">✨ Build This Route</button>
    </div>
    <div class="mr-itin" id="mrItin"></div>
  </div>
</div>

</Layout>

<script define:vars={{ destsJson }}>
const DESTS = JSON.parse(destsJson);
let current = DESTS[0];
let sliderIdx = 0;
let sliderTimer;
let builderDays = [];
let builderDest = null;
let builderHotel = null;
let mixMode = false;
let mixSelected = [];

// ── SIDEBAR ─────────────────────────────────────────────────
function buildSidebar(filter='') {
  const list = document.getElementById('sbList');
  const count = document.getElementById('sbCount');
  const filtered = DESTS.filter(d => d.name.toLowerCase().includes(filter.toLowerCase()) || d.country.toLowerCase().includes(filter.toLowerCase()));
  count.textContent = filtered.length;
  list.innerHTML = filtered.map(d => `
    <div class="sb-item ${current.name===d.name?'active':''} ${mixSelected.includes(d.name)?'mix-selected':''}"
         data-name="${d.name}"
         onclick="${mixMode?`toggleMixCity('${d.name}')`:`selectDest('${d.name}')`}"
         style="--theme:${d.theme}">
      <span class="sbi-flag">${d.flag}</span>
      <div class="sbi-info">
        <div class="sbi-name">${d.name}</div>
        <div class="sbi-meta">${d.tag} · ${d.days}d</div>
      </div>
      <div class="sbi-right">
        <span class="sbi-budget">₹${Math.round(d.totalMin/1000)}K+</span>
        ${mixMode?`<span class="sbi-check ${mixSelected.includes(d.name)?'checked':''}">${mixSelected.includes(d.name)?'✓':''}</span>`:''}
      </div>
    </div>
  `).join('');
}

// ── SELECT DESTINATION ───────────────────────────────────────
function selectDest(name) {
  current = DESTS.find(d => d.name === name) || DESTS[0];
  buildSidebar(document.getElementById('globalSearch').value);
  renderAll();
  document.getElementById('bpMain').scrollTo({ top: 0, behavior:'smooth' });
}
window.selectDest = selectDest;

// ── SLIDER ───────────────────────────────────────────────────
function buildSlider() {
  clearInterval(sliderTimer);
  sliderIdx = 0;
  const track = document.getElementById('sliderTrack');
  const dots  = document.getElementById('sliderDots');
  const imgs  = current.imgs;

  track.innerHTML = imgs.map((id,i) => `
    <div class="slide" style="background:${current.grad}">
      <img src="https://images.unsplash.com/${id}?w=1200&q=80&auto=format&fit=crop"
           alt="${current.name} ${i+1}"
           class="slide-img"
           loading="${i===0?'eager':'lazy'}"
           onerror="this.style.display='none'" />
    </div>
  `).join('');

  dots.innerHTML = imgs.map((_,i) => `<button class="sdot ${i===0?'active':''}" onclick="goSlide(${i})"></button>`).join('');

  document.getElementById('soName').textContent = current.name;
  document.getElementById('soCountry').textContent = `${current.flag} ${current.country} · ${current.tag}`;
  document.getElementById('soBudget').textContent = `₹${Math.round(current.totalMin/1000)}K – ₹${Math.round(current.totalMax/1000)}K`;
  document.getElementById('soDays').textContent = `${current.days} days`;

  updateSlide();
  sliderTimer = setInterval(slideNext, 3500);
}

function updateSlide() {
  const track = document.getElementById('sliderTrack');
  track.style.transform = `translateX(-${sliderIdx * 100}%)`;
  document.querySelectorAll('.sdot').forEach((d,i) => d.classList.toggle('active', i===sliderIdx));
}
function slideNext() { sliderIdx = (sliderIdx+1) % current.imgs.length; updateSlide(); }
function slidePrev() { sliderIdx = (sliderIdx-1+current.imgs.length) % current.imgs.length; updateSlide(); }
function goSlide(i) { sliderIdx=i; updateSlide(); }
window.slideNext=slideNext; window.slidePrev=slidePrev; window.goSlide=goSlide;

// ── FLIGHT COSTS ─────────────────────────────────────────────
function buildFlights() {
  const f = current.flights;
  const grid = document.getElementById('flightGrid');
  const pairs = [['✈️ Delhi (DEL)', f.DEL], ['✈️ Mumbai (BOM)', f.BOM], ['✈️ Bangalore (BLR)', f.BLR]];
  grid.innerHTML = pairs.map(([label, price]) => `
    <div class="flight-chip">
      <div class="fc-route">${label}</div>
      <div class="fc-price">₹${price?.toLocaleString() ?? 'N/A'}</div>
      <div class="fc-note">one-way · economy</div>
    </div>
  `).join('');
}

// ── PACKAGE SUMMARY ──────────────────────────────────────────
function buildPackage() {
  const h = current.hotels[1]; // mid hotel
  const actTotal = current.activities.slice(0,4).reduce((s,a)=>s+a.price,0);
  const flightAvg = Math.round((current.flights.DEL+current.flights.BOM+current.flights.BLR)/3);
  const days = parseInt(current.days.split('–')[1]) || 4;
  const hotelTotal = h.price * days;
  const grand = flightAvg*2 + hotelTotal + actTotal;

  document.getElementById('pkgGrid').innerHTML = `
    <div class="pkg-item">
      <div class="pkg-icon">✈️</div>
      <div class="pkg-label">Return Flights</div>
      <div class="pkg-val">~₹${(flightAvg*2).toLocaleString()}</div>
    </div>
    <div class="pkg-item">
      <div class="pkg-icon">🏨</div>
      <div class="pkg-label">Hotel (${days}N · ${h.name})</div>
      <div class="pkg-val">₹${hotelTotal.toLocaleString()}</div>
    </div>
    <div class="pkg-item">
      <div class="pkg-icon">🎭</div>
      <div class="pkg-label">Top 4 Activities</div>
      <div class="pkg-val">₹${actTotal.toLocaleString()}</div>
    </div>
    <div class="pkg-item pkg-total">
      <div class="pkg-icon">💰</div>
      <div class="pkg-label">Estimated Total</div>
      <div class="pkg-val pkg-val-total">₹${grand.toLocaleString()}</div>
    </div>
  `;
}

// ── HOTELS ───────────────────────────────────────────────────
function buildHotels() {
  document.getElementById('hotelsRow').innerHTML = current.hotels.map((h,i) => `
    <div class="hotel-card">
      <div class="hc-top" style="background:${['linear-gradient(135deg,#7C3AED,#EC4899)','linear-gradient(135deg,#FF6B35,#F59E0B)','linear-gradient(135deg,#10B981,#059669)'][i]}">
        <span class="hc-type">${h.type}</span>
        <span class="hc-rating">⭐ ${h.rating}</span>
      </div>
      <div class="hc-body">
        <div class="hc-name">${h.name}</div>
        <div class="hc-price">₹${h.price.toLocaleString()}<span class="hc-per">/night</span></div>
        <div class="hc-amenities">${h.amenities.map(a=>`<span class="hc-am">${a}</span>`).join('')}</div>
        <button class="hc-add-btn" onclick="addHotelToBuilder(${i})">+ Add to Blueprint</button>
      </div>
    </div>
  `).join('');
}
function addHotelToBuilder(idx) {
  builderHotel = current.hotels[idx];
  updateBuilderCost();
  openBuilder();
}
window.addHotelToBuilder = addHotelToBuilder;

// ── ACTIVITIES ───────────────────────────────────────────────
function buildActivities() {
  document.getElementById('actsGrid').innerHTML = current.activities.map((a,i) => `
    <div class="act-card ${builderDays.some(d=>d.items.some(it=>it.name===a.name))?'added':''}">
      <div class="act-icon">${a.icon}</div>
      <div class="act-body">
        <div class="act-name">${a.name}</div>
        <div class="act-meta">
          <span class="act-type">${a.type}</span>
          <span class="act-dur">⏱ ${a.dur}</span>
        </div>
        <div class="act-price">${a.price===0?'<span class="act-free">Free</span>':`₹${a.price.toLocaleString()}`}</div>
      </div>
      <button class="act-add-btn" onclick="addActivityToDay(${i})" title="Add to blueprint">+</button>
    </div>
  `).join('');
}
function addActivityToDay(actIdx) {
  const act = current.activities[actIdx];
  if (builderDays.length === 0) initBuilderDays();
  const dayIdx = builderDays.findIndex(d => d.items.length < 3) ?? 0;
  const target = builderDays[dayIdx >= 0 ? dayIdx : 0];
  if (!target.items.some(it=>it.name===act.name)) {
    target.items.push({ name: `${act.icon} ${act.name}`, price: act.price });
  }
  updateBuilderCost();
  buildActivities();
  openBuilder();
}
window.addActivityToDay = addActivityToDay;

// ── DAY ITINERARY PREVIEW ────────────────────────────────────
function buildItinPreview() {
  document.getElementById('itinDays').innerHTML = current.itin.map(day => `
    <div class="itin-day-card">
      <div class="idc-num">Day ${day.day}</div>
      <div class="idc-title">${day.title}</div>
      <ul class="idc-items">
        ${day.items.map(it=>`<li><span class="idc-dot">◆</span>${it}</li>`).join('')}
      </ul>
    </div>
  `).join('');
}

// ── INFO BAR ─────────────────────────────────────────────────
function buildInfoBar() {
  document.getElementById('dibBest').textContent = current.best;
  document.getElementById('dibCurrency').textContent = current.currency;
  document.getElementById('dibVisa').textContent = current.visa;
  document.getElementById('dibDays').textContent = current.days + ' days';
}

// ── RENDER ALL ───────────────────────────────────────────────
function renderAll() {
  buildSlider();
  buildInfoBar();
  buildFlights();
  buildPackage();
  buildHotels();
  buildActivities();
  buildItinPreview();
  if (builderDest?.name !== current.name) {
    builderDest = current;
    initBuilderDays();
  }
}

// ── BLUEPRINT BUILDER ────────────────────────────────────────
function initBuilderDays() {
  builderDays = current.itin.map(d => ({
    day: d.day,
    title: d.title,
    items: d.items.map(it => ({ name: it, price: 0 })),
  }));
  builderHotel = current.hotels[1];
}

function openBuilder() {
  if (!builderDest || builderDest.name !== current.name) { builderDest = current; initBuilderDays(); }
  document.getElementById('builderOverlay').style.display = 'block';
  document.getElementById('builderDrawer').classList.add('open');
  renderBuilder();
}
function closeBuilder() {
  document.getElementById('builderOverlay').style.display = 'none';
  document.getElementById('builderDrawer').classList.remove('open');
}
window.openBuilder=openBuilder; window.closeBuilder=closeBuilder;

function renderBuilder() {
  document.getElementById('bdTitle').textContent = `${current.name} Blueprint`;
  document.getElementById('bdDestInfo').textContent = `${current.flag} ${current.country} · ${current.days} days · ${current.best}`;

  // Quick add chips
  document.getElementById('bqChips').innerHTML = current.activities.map((a,i) => `
    <button class="bq-chip" onclick="addActivityToDay(${i})">${a.icon} ${a.name.split(' ')[0]} (+₹${a.price===0?'Free':a.price})</button>
  `).join('');

  renderBuilderDays();
  updateBuilderCost();
}

function renderBuilderDays() {
  document.getElementById('bdDays').innerHTML = builderDays.map((d,di) => `
    <div class="bd-day">
      <div class="bdd-header">
        <div class="bdd-num">Day ${d.day}</div>
        <input class="bdd-title" value="${d.title}" onchange="builderDays[${di}].title=this.value" />
        <button class="bdd-del" onclick="removeDay(${di})">✕</button>
      </div>
      <div class="bdd-items">
        ${d.items.map((it,ii) => `
          <div class="bddi">
            <input class="bddi-text" value="${it.name}" onchange="builderDays[${di}].items[${ii}].name=this.value" />
            <span class="bddi-price">${it.price>0?'₹'+it.price:''}</span>
            <button class="bddi-del" onclick="removeItem(${di},${ii})">✕</button>
          </div>
        `).join('')}
      </div>
      <button class="bdd-add-item" onclick="addCustomItem(${di})">+ Add item</button>
    </div>
  `).join('');
}

function addDay() {
  builderDays.push({ day: builderDays.length+1, title: 'New Day', items: [] });
  renderBuilderDays();
}
function removeDay(di) {
  builderDays.splice(di, 1);
  builderDays.forEach((d,i)=>d.day=i+1);
  renderBuilderDays();
}
function removeItem(di,ii) {
  builderDays[di].items.splice(ii,1);
  renderBuilderDays();
  updateBuilderCost();
}
function addCustomItem(di) {
  const name = prompt('Add item to Day '+(di+1)+':', '');
  if (name) {
    builderDays[di].items.push({ name, price: 0 });
    renderBuilderDays();
  }
}
window.addDay=addDay; window.removeDay=removeDay; window.removeItem=removeItem; window.addCustomItem=addCustomItem;

function updateBuilderCost() {
  const actCost = builderDays.flatMap(d=>d.items).reduce((s,it)=>s+(it.price||0),0);
  const hotelCost = builderHotel ? builderHotel.price * builderDays.length : 0;
  const flightAvg = Math.round((current.flights.DEL+current.flights.BOM+current.flights.BLR)/3);
  const total = flightAvg*2 + hotelCost + actCost;
  const el = document.getElementById('bdTotal');
  if (el) el.textContent = '₹'+total.toLocaleString();
}

// ── SAVE / LOAD ───────────────────────────────────────────────
function saveBlueprint() {
  const saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  const bp = {
    id: Date.now(),
    dest: current.name,
    flag: current.flag,
    days: builderDays,
    hotel: builderHotel?.name,
    saved: new Date().toLocaleDateString(),
  };
  saved.unshift(bp);
  localStorage.setItem('virel_blueprints', JSON.stringify(saved.slice(0,10)));
  updateSavedCount();
  alert(`✅ "${current.name} Blueprint" saved! View in My Blueprints.`);
}

function updateSavedCount() {
  const saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  document.getElementById('savedCount').textContent = saved.length;
}

function openSaved() {
  const saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  document.getElementById('savedOverlay').style.display = 'block';
  document.getElementById('savedPanel').classList.add('open');
  document.getElementById('spBody').innerHTML = saved.length === 0
    ? '<div class="sp-empty">No blueprints saved yet. Build one!</div>'
    : saved.map(bp => `
      <div class="sp-item">
        <div class="spi-flag">${bp.flag}</div>
        <div class="spi-info">
          <div class="spi-name">${bp.dest} Blueprint</div>
          <div class="spi-meta">${bp.days?.length||0} days · Hotel: ${bp.hotel||'Not set'} · Saved ${bp.saved}</div>
        </div>
        <div class="spi-actions">
          <button class="spi-open" onclick="loadBlueprint(${bp.id})">Open</button>
          <button class="spi-del" onclick="deleteBlueprint(${bp.id})">✕</button>
        </div>
      </div>
    `).join('');
}
function closeSaved() {
  document.getElementById('savedOverlay').style.display = 'none';
  document.getElementById('savedPanel').classList.remove('open');
}
function loadBlueprint(id) {
  const saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  const bp = saved.find(b=>b.id===id);
  if (!bp) return;
  const dest = DESTS.find(d=>d.name===bp.dest);
  if (dest) { selectDest(dest.name); }
  closeSaved();
  setTimeout(openBuilder, 400);
}
function deleteBlueprint(id) {
  let saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  saved = saved.filter(b=>b.id!==id);
  localStorage.setItem('virel_blueprints', JSON.stringify(saved));
  updateSavedCount();
  openSaved();
}
window.openSaved=openSaved; window.closeSaved=closeSaved; window.loadBlueprint=loadBlueprint; window.deleteBlueprint=deleteBlueprint;

// ── COPY ITINERARY TEXT ──────────────────────────────────────
function copyItinerary() {
  const lines = [
    `🗺️ ${current.name} Blueprint — Virel`,
    `📍 ${current.country} · ${current.days} days · Best: ${current.best}`,
    `💰 Budget: ₹${current.totalMin.toLocaleString()} – ₹${current.totalMax.toLocaleString()}`,
    `🏨 Hotel: ${builderHotel?.name || current.hotels[1].name}`,
    '',
    ...builderDays.map(d => [`\nDay ${d.day}: ${d.title}`, ...d.items.map(it=>`  • ${it.name}`)].join('\n')),
    '',
    '📲 Built with Virel Blueprints · getvirel.co',
  ].join('\n');
  navigator.clipboard.writeText(lines).then(() => alert('📋 Itinerary copied to clipboard!')).catch(()=>{});
}
window.copyItinerary=copyItinerary;

// ── COUNTRY THEME ────────────────────────────────────────────
function applyTheme() {
  document.documentElement.style.setProperty('--purple', current.theme);
  document.documentElement.style.setProperty('--grad-primary', `linear-gradient(135deg,${current.theme},#EC4899,#FF6B35)`);
  const btn = document.getElementById('themeBtn');
  btn.textContent = `✓ ${current.name} theme applied`;
  btn.style.background = current.theme;
  btn.style.color = 'white';
  setTimeout(() => { btn.textContent = '🎨 Apply Country Theme'; btn.style.background=''; btn.style.color=''; }, 3000);
}
window.applyTheme=applyTheme;

// ── MIX & MATCH ──────────────────────────────────────────────
function toggleMixMode() {
  mixMode = !mixMode;
  mixSelected = [];
  const btn = document.getElementById('mixToggle');
  const info = document.getElementById('mixInfo');
  const result = document.getElementById('mixResult');
  btn.classList.toggle('active', mixMode);
  btn.textContent = mixMode ? '✕ Exit Mix & Match' : '🔀 Mix & Match';
  info.style.display = mixMode ? 'block' : 'none';
  result.style.display = 'none';
  buildSidebar();
}
window.toggleMixMode=toggleMixMode;

function toggleMixCity(name) {
  if (mixSelected.includes(name)) {
    mixSelected = mixSelected.filter(n=>n!==name);
  } else if (mixSelected.length < 4) {
    mixSelected.push(name);
  }
  const genBtn = document.getElementById('mixGenerateBtn');
  genBtn.style.display = mixSelected.length >= 2 ? 'block' : 'none';
  genBtn.textContent = `🗺️ Build Route (${mixSelected.join(' + ')})`;
  buildSidebar();
}
window.toggleMixCity=toggleMixCity;

function generateMixItinerary() {
  const cities = mixSelected.map(n=>DESTS.find(d=>d.name===n)).filter(Boolean);
  let dayCount = 0;
  const allDays = cities.flatMap(city => {
    return city.itin.map(d => ({
      ...d,
      day: ++dayCount,
      city: city.name,
      flag: city.flag,
    }));
  });
  const totalMin = cities.reduce((s,c)=>s+c.totalMin,0);
  const totalMax = cities.reduce((s,c)=>s+c.totalMax,0);

  document.getElementById('mrTitle').textContent = `${cities.map(c=>c.flag+' '+c.name).join(' + ')} · ${dayCount} Days`;
  document.getElementById('mrItin').innerHTML = `
    <div class="mr-summary">
      <span>💰 Estimated: ₹${totalMin.toLocaleString()} – ₹${totalMax.toLocaleString()}</span>
      <span>📅 ${dayCount} days total</span>
      <span>${cities.map(c=>c.flag+' '+c.name+' ('+c.days+'d)').join(' → ')}</span>
    </div>
    <div class="mr-days">
      ${allDays.map(d=>`
        <div class="mr-day">
          <div class="mrd-hdr">
            <span class="mrd-num">Day ${d.day}</span>
            <span class="mrd-city">${d.flag} ${d.city}</span>
            <span class="mrd-title">${d.title}</span>
          </div>
          <div class="mrd-items">${d.items.map(it=>`<span>◆ ${it}</span>`).join('')}</div>
        </div>
      `).join('')}
    </div>
  `;
  document.getElementById('mixResult').style.display = 'block';
  document.getElementById('mixResult').scrollIntoView({ behavior:'smooth' });
}
window.generateMixItinerary=generateMixItinerary;

function openBuilderFromMix() {
  const cities = mixSelected.map(n=>DESTS.find(d=>d.name===n)).filter(Boolean);
  let dayCount = 0;
  builderDays = cities.flatMap(city =>
    city.itin.map(d => ({
      day: ++dayCount,
      title: `${city.flag} ${city.name}: ${d.title}`,
      items: d.items.map(it=>({ name: it, price: 0 })),
    }))
  );
  builderDest = cities[0];
  current = cities[0];
  openBuilder();
}
window.openBuilderFromMix=openBuilderFromMix;

// ── SEARCH ───────────────────────────────────────────────────
document.getElementById('globalSearch')?.addEventListener('input', e => {
  buildSidebar(e.target.value);
});

// ── INIT ─────────────────────────────────────────────────────
buildSidebar();
renderAll();
updateSavedCount();
</script>

