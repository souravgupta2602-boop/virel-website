    name:'Rishikesh', country:'India', emoji:'🏔️', tag:'Adventure',
    budget:'₹6K–18K', days:'3–5', best:'Feb–Jun',
    grad:'linear-gradient(160deg,#047857,#10B981,#6EE7B7)',
    img:'https://images.unsplash.com/photo-1544376664-80b17f09d399?w=600&q=80&auto=format&fit=crop',
