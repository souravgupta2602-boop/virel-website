    desc:'Golden beaches, vibrant nightlife, Portuguese heritage and fresh seafood.',
    activities:['🏄 Water sports at Baga Beach','🌿 Spice plantation tour','🌅 Sunset cruise on Mandovi River'],
  },
  {
    name:'Bali', country:'Indonesia', emoji:'🌴', tag:'Island',
    budget:'₹40K–90K', days:'5–8', best:'Apr–Sep',
    grad:'linear-gradient(160deg,#059669,#10B981,#34D399)',
    img:'https://images.unsplash.com/photo-1537953773345-d172ccf13cf1?w=600&q=80&auto=format&fit=crop',
    desc:'Terraced rice fields, ancient temples, world-class surf and volcanic peaks.',
