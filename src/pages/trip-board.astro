---

<Layout title="Virel Blueprints — Trip Planner | Virel">

<!-- HERO -->
<section class="bp-hero">
  <div class="bp-hero-bg"></div>
  <div class="container bp-hero-inner">
    <span class="section-label" style="background:rgba(255,255,255,.1);color:white;border-color:rgba(255,255,255,.2)">✨ AI-Powered</span>
    <h1 class="bp-hero-title">Virel Blueprints</h1>
    <p class="bp-hero-sub">Discover, plan and build your perfect trip. Real pricing · Curated hotels · Day-by-day itineraries.</p>
  </div>
</section>

<!-- FILTER BAR -->
<div class="bp-filter-bar">
  <div class="container bpf-inner">
    <div class="bpf-chips" id="bpfChips">
      <button class="bpf-chip active" data-filter="all">All</button>
      <button class="bpf-chip" data-filter="India">🇮🇳 India</button>
      <button class="bpf-chip" data-filter="International">🌍 International</button>
      <button class="bpf-chip" data-tag="Beach">🏖️ Beach</button>
      <button class="bpf-chip" data-tag="Heritage">🏛️ Heritage</button>
      <button class="bpf-chip" data-tag="Mountains">🏔️ Mountains</button>
      <button class="bpf-chip" data-tag="Luxury">👑 Luxury</button>
      <button class="bpf-chip" data-tag="Adventure">🧗 Adventure</button>
      <button class="bpf-chip" data-tag="Culture">🎭 Culture</button>
    </div>
    <div class="bpf-search-wrap">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="bpSearch" placeholder="Search destination…" />
    </div>
  </div>
</div>

<!-- DESTINATIONS GRID -->
<div class="container bp-grid-wrap">
  <div class="bp-grid" id="bpGrid"></div>
</div>

<!-- DETAIL EXPAND PANEL -->
<div class="dp-overlay" id="dpOverlay" onclick="closeDp()"></div>
<div class="dp-panel" id="dpPanel">
  <div class="dp-header" id="dpHeader"></div>
  <div class="dp-body" id="dpBody"></div>
</div>

<!-- LIGHTBOX -->
<div class="lb-overlay" id="lbOverlay" onclick="closeLb()">
  <button class="lb-close" onclick="event.stopPropagation();closeLb()">✕</button>
  <button class="lb-prev" onclick="event.stopPropagation();lbPrev()">‹</button>
  <button class="lb-next" onclick="event.stopPropagation();lbNext()">›</button>
  <div class="lb-img-wrap" onclick="event.stopPropagation()">
    <img id="lbImg" src="" alt="" class="lb-img" />
    <div class="lb-counter" id="lbCounter">1 / 5</div>
  </div>
</div>

</Layout>

<script define:vars={{ destsJson }}>
const DESTS = JSON.parse(destsJson);
let activeFilter = 'all';
let activeTag    = '';
let searchQ      = '';
let lbImgs = [];
let lbIdx  = 0;

function getFiltered() {
  return DESTS.filter(d => {
    if (searchQ && !d.name.toLowerCase().includes(searchQ.toLowerCase())) return false;
    if (activeFilter === 'India') return d.country === 'India';
    if (activeFilter === 'International') return d.country !== 'India';
    if (activeTag) return d.tag === activeTag;
    return true;
  });
}

// ── GRID ────────────────────────────────────────────────────────────────────
function renderGrid() {
  const grid = document.getElementById('bpGrid');
  if (!grid) return;
  const filtered = getFiltered();

  grid.innerHTML = filtered.map(d => {
    const gi     = DESTS.indexOf(d);
    const heroId = d.imgs[0];
    const imgUrl = `https://images.unsplash.com/${heroId}?w=800&q=80&auto=format&fit=crop`;

    return `
      <div class="bp-card" data-gi="${gi}" style="--theme:${d.theme}">
        <div class="bpc-img-wrap">
          <img class="bpc-img" src="${imgUrl}" alt="${d.name}"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="bpc-img-fallback" style="background:${d.grad};display:none">
            <span style="font-size:3rem">${d.flag}</span>
          </div>

          <!-- Dot nav for cycling images -->
          <div class="bpc-dots">
            ${d.imgs.map((id,j) => `<span class="bpc-dot${j===0?' bpc-dot-active':''}" data-j="${j}" data-gi="${gi}"></span>`).join('')}
          </div>

          <!-- Photo count badge -->
          <button class="bpc-photo-btn" data-gi="${gi}" data-lbopen="1">📷 ${d.imgs.length} photos</button>

          <div class="bpc-top-badges">
            <span class="bpc-tag">${d.tag}</span>
          </div>
          <div class="bpc-overlay-bot">
            <div class="bpc-dest-name">${d.flag} ${d.name}</div>
            <div class="bpc-country">${d.country}</div>
          </div>
        </div>

        <div class="bpc-footer">
          <div class="bpc-meta">
            <span class="bpc-budget">₹${Math.round(d.totalMin/1000)}K–₹${Math.round(d.totalMax/1000)}K</span>
            <span class="bpc-sep">·</span>
            <span class="bpc-days">${d.days} days</span>
            <span class="bpc-sep">·</span>
            <span class="bpc-best">${d.best}</span>
          </div>
          <button class="bpc-cta" data-gi="${gi}" data-openDp="1">Explore →</button>
        </div>
      </div>
    `;
  }).join('');
}

// Delegated clicks on the grid
document.getElementById('bpGrid').addEventListener('click', e => {
  const dotEl   = e.target.closest('.bpc-dot');
  const photoBtn = e.target.closest('[data-lbopen]');
  const ctaBtn  = e.target.closest('[data-openDp]');
  const card    = e.target.closest('.bp-card');

  if (dotEl) {
    const gi  = parseInt(dotEl.dataset.gi);
    const j   = parseInt(dotEl.dataset.j);
    const wrap = dotEl.closest('.bpc-img-wrap');
    const img  = wrap.querySelector('.bpc-img');
    img.style.opacity = '0';
    img.src = `https://images.unsplash.com/${DESTS[gi].imgs[j]}?w=800&q=80&auto=format&fit=crop`;
    img.onload = () => { img.style.opacity='1'; };
    img.onerror = () => { img.style.display='none'; img.nextElementSibling.style.display='flex'; };
    wrap.querySelectorAll('.bpc-dot').forEach(d => d.classList.remove('bpc-dot-active'));
    dotEl.classList.add('bpc-dot-active');
    return;
  }
  if (photoBtn) { openLb(parseInt(photoBtn.dataset.gi), 0); return; }
  if (ctaBtn)   { openDp(parseInt(ctaBtn.dataset.gi)); return; }
  if (card)     { openDp(parseInt(card.dataset.gi)); }
});

// ── DETAIL PANEL ────────────────────────────────────────────────────────────
function openDp(gi) {
  const d = DESTS[gi];
  if (!d) return;
  const avgFlight = Math.round((d.flights.DEL + d.flights.BOM + d.flights.BLR) / 3);

  document.getElementById('dpHeader').innerHTML = `
    <div class="dph-left">
      <span class="dph-flag">${d.flag}</span>
      <div>
        <div class="dph-name">${d.name}</div>
        <div class="dph-sub">${d.country} · ${d.tag} · ${d.days} days</div>
      </div>
    </div>
    <div class="dph-right">
      <button class="dp-close" onclick="closeDp()">✕</button>
    </div>
  `;

  document.getElementById('dpBody').innerHTML = `
    <!-- Scrollable image strip -->
    <div class="dp-imgs-row">
      ${d.imgs.map((id,i) => `
        <div class="dp-img-thumb" data-gi="${gi}" data-i="${i}">
          <img src="https://images.unsplash.com/${id}?w=400&q=75&auto=format&fit=crop"
               alt="${d.name}" loading="${i<2?'eager':'lazy'}"
               onerror="this.parentElement.style.background='${d.grad}';this.style.display='none'" />
          ${i===0?'<div class="dp-img-primary-badge">Hero</div>':''}
        </div>
      `).join('')}
      <div class="dp-img-thumb dp-see-all" data-gi="${gi}" data-lball="1">
        <span style="font-size:1.4rem">📷</span>
        <span>All ${d.imgs.length}</span>
      </div>
    </div>

    <p class="dp-desc">${d.desc}</p>

    <div class="dp-info-bar">
      <div class="dib-item"><div class="dib-val">${d.best}</div><div class="dib-label">Best Season</div></div>
      <div class="dib-item"><div class="dib-val">${d.days}d</div><div class="dib-label">Ideal Stay</div></div>
      <div class="dib-item"><div class="dib-val">₹${Math.round(d.totalMin/1000)}K+</div><div class="dib-label">From</div></div>
      <div class="dib-item"><div class="dib-val">₹${(avgFlight*2).toLocaleString()}</div><div class="dib-label">Avg Flights</div></div>
    </div>

    <div class="dp-section">
      <h3 class="dp-sec-title">✈️ Flights (Economy one-way)</h3>
      <div class="dp-flights">
        ${[['Delhi','DEL'],['Mumbai','BOM'],['Bangalore','BLR']].map(([city,code]) => `
          <div class="dpf-item">
            <div class="dpf-city">${city}</div>
            <div class="dpf-price">₹${(d.flights[code]||0).toLocaleString()}</div>
          </div>
        `).join('')}
      </div>
    </div>

    <div class="dp-section">
      <h3 class="dp-sec-title">🏨 Hotels</h3>
      <div class="dp-hotels">
        ${d.hotels.map((h,i) => `
          <div class="dph-card">
            <div class="dph-mock" style="background:${['linear-gradient(135deg,#7C3AED,#EC4899)','linear-gradient(135deg,#FF6B35,#F59E0B)','linear-gradient(135deg,#10B981,#059669)'][i]}">🏨</div>
            <div class="dph-info">
              <div class="dph-hname">${h.name}</div>
              <div class="dph-htype">${h.type}</div>
              <div class="dph-hprice">₹${h.price.toLocaleString()}<span>/night</span></div>
              <div class="dph-hams">${h.amenities.slice(0,2).join(' · ')}</div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>

    <div class="dp-section">
      <h3 class="dp-sec-title">🎭 Activities</h3>
      <div class="dp-acts">
        ${d.activities.map(a => `
          <div class="dpa-item">
            <span class="dpa-icon">${a.icon}</span>
            <div class="dpa-body">
              <div class="dpa-name">${a.name}</div>
              <div class="dpa-type">${a.type}</div>
            </div>
            <div class="dpa-price">${a.price===0?'Free':'₹'+a.price.toLocaleString()}</div>
          </div>
        `).join('')}
      </div>
    </div>

    <div class="dp-section">
      <h3 class="dp-sec-title">📅 Sample Itinerary</h3>
      <div class="dp-itin">
        ${d.itin.map(day => `
          <div class="dpi-day">
            <div class="dpi-daynum">Day ${day.day}</div>
            <div class="dpi-content">
              <div class="dpi-title">${day.title}</div>
              <div class="dpi-items">${day.items.map(it=>`<span>◆ ${it}</span>`).join('')}</div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>

    <div class="dp-cta">
      <a href="/travel" class="dp-cta-flights">✈️ Search Flights</a>
      <a href="/stays" class="dp-cta-hotels">🏨 Find Hotels</a>
      <button class="dp-cta-build" onclick="saveBlueprint(${gi})">💾 Save Blueprint</button>
    </div>
  `;

  // Delegate lightbox open from dp-body image strip
  document.getElementById('dpBody').querySelectorAll('.dp-img-thumb').forEach(el => {
    el.addEventListener('click', () => {
      const g = parseInt(el.dataset.gi);
      const i = el.dataset.lball ? 0 : parseInt(el.dataset.i || 0);
      openLb(g, i);
    });
  });

  document.getElementById('dpOverlay').style.display = 'block';
  document.getElementById('dpPanel').classList.add('open');
}

function closeDp() {
  document.getElementById('dpOverlay').style.display = 'none';
  document.getElementById('dpPanel').classList.remove('open');
}
window.openDp = openDp;
window.closeDp = closeDp;

function saveBlueprint(gi) {
  const d = DESTS[gi];
  if (!d) return;
  const saved = JSON.parse(localStorage.getItem('virel_blueprints') || '[]');
  saved.unshift({ id:Date.now(), dest:d.name, flag:d.flag, saved:new Date().toLocaleDateString() });
  localStorage.setItem('virel_blueprints', JSON.stringify(saved.slice(0,10)));
  alert('✅ "' + d.name + ' Blueprint" saved!');
}
window.saveBlueprint = saveBlueprint;

// ── LIGHTBOX ────────────────────────────────────────────────────────────────
function openLb(gi, idx) {
  const d = DESTS[gi];
  lbImgs = d.imgs;
  lbIdx  = idx;
  renderLb();
  document.getElementById('lbOverlay').style.display = 'flex';
}
function closeLb() { document.getElementById('lbOverlay').style.display = 'none'; }
function lbPrev()  { lbIdx = (lbIdx - 1 + lbImgs.length) % lbImgs.length; renderLb(); }
function lbNext()  { lbIdx = (lbIdx + 1) % lbImgs.length; renderLb(); }
function renderLb() {
  const img = document.getElementById('lbImg');
  const ctr = document.getElementById('lbCounter');
  img.src = `https://images.unsplash.com/${lbImgs[lbIdx]}?w=1400&q=85&auto=format&fit=crop`;
  if (ctr) ctr.textContent = `${lbIdx + 1} / ${lbImgs.length}`;
}
window.openLb  = openLb;
window.closeLb = closeLb;
window.lbPrev  = lbPrev;
window.lbNext  = lbNext;

document.addEventListener('keydown', e => {
  if (document.getElementById('lbOverlay').style.display === 'flex') {
    if (e.key === 'ArrowLeft')  lbPrev();
    if (e.key === 'ArrowRight') lbNext();
    if (e.key === 'Escape')     closeLb();
  } else if (e.key === 'Escape') {
    closeDp();
  }
});

// ── FILTERS ─────────────────────────────────────────────────────────────────
document.getElementById('bpfChips').addEventListener('click', e => {
  const btn = e.target.closest('.bpf-chip');
  if (!btn) return;
  document.querySelectorAll('.bpf-chip').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  activeFilter = btn.dataset.filter || '';
  activeTag    = btn.dataset.tag    || '';
  renderGrid();
});

document.getElementById('bpSearch').addEventListener('input', e => {
  searchQ = e.target.value.trim();
  renderGrid();
});

renderGrid();
</script>

