---
import Layout from '../layouts/Layout.astro';
import { cards, categories, merchantMap } from '../data/cards.js';
const cardsJson = JSON.stringify(cards);
const merchantMapJson = JSON.stringify(merchantMap);
---

<Layout title="Best Card Finder — Virel" description="Find which credit card gives you the highest reward for any merchant or category.">

  <section class="page-hero">
    <div class="container">
      <div class="section-label">Free tool</div>
      <h1 class="section-title">Find your <span class="gradient-text">best card</span></h1>
      <p class="section-sub" style="margin:0 auto;text-align:center;">
        Type any merchant or pick a category — see which card gives the highest reward instantly.
      </p>
    </div>
  </section>

  <section class="finder-section">
    <div class="container">
      <div class="finder-box">

        <!-- Country toggle -->
        <div class="country-toggle">
          <button class="country-btn active" data-country="IN">🇮🇳 India</button>
          <button class="country-btn" data-country="US">🇺🇸 United States</button>
        </div>

        <!-- Search input -->
        <div class="search-wrap">
          <div class="search-icon">🔍</div>
          <input type="text" id="merchantInput" placeholder="Type merchant name (e.g. Swiggy, Amazon, Petrol…)" autocomplete="off" />
          <div id="detectedBadge" class="detected-badge" style="display:none"></div>
        </div>

        <!-- Category chips -->
        <div class="chip-label">Or pick a category:</div>
        <div class="chips" id="chips">
          {categories.map(c => (
            <button class="chip" data-cat={c}>{c}</button>
          ))}
        </div>

        <!-- Quick merchants -->
        <div class="chip-label">Quick picks:</div>
        <div class="chips" id="quickChips">
          {['Swiggy','Amazon','Petrol','Flight','BigBasket','Netflix','Zomato','Flipkart','IRCTC','Hotel'].map(m => (
            <button class="chip quick-chip" data-merchant={m}>{m}</button>
          ))}
        </div>
      </div>

      <!-- Results -->
      <div id="results" class="results" style="display:none">
        <div class="results-header">
          <div id="resultsTitle" class="results-title"></div>
          <div id="resultsCount" class="results-count"></div>
        </div>
        <div id="cardList" class="card-list"></div>
        <div class="app-nudge">
          <span>💡 Add your own cards to get personalised picks</span>
          <a href="https://play.google.com/store" target="_blank" class="btn-primary nudge-btn">Get Virel App</a>
        </div>
      </div>

      <div id="emptyState" class="empty-state">
        <div class="empty-icon">💳</div>
        <div class="empty-text">Search a merchant or pick a category above</div>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ cardsJson, merchantMapJson }}>
  const cards = JSON.parse(cardsJson);
  const merchantMap = JSON.parse(merchantMapJson);
  let selectedCountry = 'IN';
  let selectedCategory = null;

  const merchantInput = document.getElementById('merchantInput');
  const detectedBadge = document.getElementById('detectedBadge');
  const results = document.getElementById('results');
  const emptyState = document.getElementById('emptyState');
  const cardList = document.getElementById('cardList');
  const resultsTitle = document.getElementById('resultsTitle');
  const resultsCount = document.getElementById('resultsCount');

  function detectCategory(merchant) {
    const m = merchant.toLowerCase().replace(/\s+/g, '');
    for (const [keyword, cat] of Object.entries(merchantMap)) {
      if (m.includes(keyword.replace(/\s+/g, ''))) return cat;
    }
    return null;
  }

  function renderCards(category, merchant = '') {
    const ranked = cards
      .filter(c => c.country === selectedCountry)
      .map(c => ({ ...c, multiplier: (c.multipliers && c.multipliers[category]) || 1.0 }))
      .sort((a, b) => b.multiplier - a.multiplier);

    const curr = selectedCountry === 'IN' ? '₹' : '$';
    const label = merchant ? `Best cards for <strong>${merchant}</strong> (${category})` : `Best cards for <strong>${category}</strong>`;
    resultsTitle.innerHTML = label;
    resultsCount.textContent = `${ranked.length} cards ranked`;

    cardList.innerHTML = ranked.map((card, i) => {
      const isBest = i === 0;
      const loungeText = card.loungeDomestic === -1 ? 'Unlimited' : card.loungeDomestic === 0 ? 'None' : `${card.loungeDomestic} visits`;
      return `
        <div class="card-item ${isBest ? 'best' : ''}">
          <div class="card-rank-badge ${i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : 'rank-3'}">${i < 3 ? ['🥇','🥈','🥉'][i] : `#${i+1}`}</div>
          <div class="card-color-bar" style="background:${card.color}"></div>
          <div class="card-info">
            <div class="card-bank">${card.bank}</div>
            <div class="card-name">${card.name} <span class="card-type">${card.type}</span></div>
            <div class="card-benefits-mini">${card.benefits[0]}</div>
          </div>
          <div class="card-metrics">
            <div class="metric">
              <div class="metric-val ${card.multiplier > 1 ? 'highlight' : ''}">${card.multiplier}x</div>
              <div class="metric-label">${category} reward</div>
            </div>
            <div class="metric">
              <div class="metric-val">${curr}${card.fee.toLocaleString()}</div>
              <div class="metric-label">Annual fee</div>
            </div>
            <div class="metric">
              <div class="metric-val">${loungeText}</div>
              <div class="metric-label">Lounge</div>
            </div>
          </div>
          <a href="${card.applyUrl}" target="_blank" rel="noopener" class="apply-btn">Apply →</a>
        </div>
      `;
    }).join('');

    results.style.display = 'block';
    emptyState.style.display = 'none';
  }

  function setActiveChip(chipEl) {
    document.querySelectorAll('.chip:not(.quick-chip)').forEach(c => c.classList.remove('active'));
    if (chipEl) chipEl.classList.add('active');
  }

  // Category chips
  document.querySelectorAll('.chip:not(.quick-chip)').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedCategory = btn.dataset.cat;
      merchantInput.value = '';
      detectedBadge.style.display = 'none';
      setActiveChip(btn);
      renderCards(selectedCategory);
    });
  });

  // Quick merchant chips
  document.querySelectorAll('.quick-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      merchantInput.value = btn.dataset.merchant;
      const cat = detectCategory(btn.dataset.merchant);
      if (cat) {
        selectedCategory = cat;
        detectedBadge.textContent = `Category: ${cat}`;
        detectedBadge.style.display = 'flex';
        setActiveChip(null);
        renderCards(cat, btn.dataset.merchant);
      }
    });
  });

  // Text input
  let debounce;
  merchantInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      const val = merchantInput.value.trim();
      if (!val) {
        detectedBadge.style.display = 'none';
        if (selectedCategory) renderCards(selectedCategory);
        else { results.style.display = 'none'; emptyState.style.display = 'block'; }
        return;
      }
      const cat = detectCategory(val);
      if (cat) {
        selectedCategory = cat;
        detectedBadge.textContent = `Category: ${cat}`;
        detectedBadge.style.display = 'flex';
        setActiveChip(null);
        renderCards(cat, val);
      } else {
        detectedBadge.textContent = 'Category not detected — pick one below';
        detectedBadge.style.display = 'flex';
        detectedBadge.style.background = 'rgba(239,68,68,0.1)';
        detectedBadge.style.color = '#DC2626';
      }
    }, 300);
  });

  // Country toggle
  document.querySelectorAll('.country-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.country-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedCountry = btn.dataset.country;
      if (selectedCategory) renderCards(selectedCategory, merchantInput.value.trim());
    });
  });
</script>

<style>
  .page-hero { padding:80px 0 40px; text-align:center; }

  .finder-section { padding:20px 0 100px; }

  .finder-box {
    background: white;
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 8px 40px rgba(79,70,229,0.1);
    border: 1px solid rgba(79,70,229,0.08);
    margin-bottom: 36px;
  }

  .country-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }

  .country-btn {
    padding: 8px 20px;
    border-radius: 100px;
    border: 1.5px solid #E5E7EB;
    background: white;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    color: #6B7280;
    transition: all 0.15s;
  }

  .country-btn.active {
    border-color: #4F46E5;
    background: rgba(79,70,229,0.06);
    color: #4F46E5;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #F9FAFB;
    border: 1.5px solid #E5E7EB;
    border-radius: 14px;
    padding: 14px 18px;
    margin-bottom: 24px;
    transition: border-color 0.15s;
  }

  .search-wrap:focus-within {
    border-color: #4F46E5;
    background: white;
    box-shadow: 0 0 0 3px rgba(79,70,229,0.08);
  }

  .search-icon { font-size: 1.2rem; flex-shrink: 0; }

  .search-wrap input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-family: inherit;
    color: #111827;
    outline: none;
  }

  .search-wrap input::placeholder { color: #9CA3AF; }

  .detected-badge {
    display: flex;
    align-items: center;
    background: rgba(13,148,136,0.1);
    color: #0D9488;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .chip-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #9CA3AF;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .chip {
    padding: 8px 16px;
    border-radius: 100px;
    border: 1.5px solid #E5E7EB;
    background: white;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    color: #374151;
    cursor: pointer;
    transition: all 0.15s;
  }

  .chip:hover { border-color: #4F46E5; color: #4F46E5; background: rgba(79,70,229,0.04); }
  .chip.active { border-color: #4F46E5; background: rgba(79,70,229,0.08); color: #4F46E5; }

  /* RESULTS */
  .results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .results-title { font-size: 1.1rem; font-weight: 700; color: #111827; }
  .results-count { font-size: 0.85rem; color: #9CA3AF; font-weight: 500; }

  .card-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }

  .card-item {
    display: flex;
    align-items: center;
    gap: 16px;
    background: white;
    border: 1.5px solid #F3F4F6;
    border-radius: 16px;
    padding: 16px 20px;
    transition: all 0.15s;
  }

  .card-item:hover { border-color: rgba(79,70,229,0.2); box-shadow: 0 4px 16px rgba(79,70,229,0.06); }
  .card-item.best { border-color: rgba(79,70,229,0.25); background: rgba(79,70,229,0.02); }

  .card-rank-badge { font-size: 1.4rem; flex-shrink: 0; width: 32px; text-align: center; }

  .card-color-bar { width: 4px; height: 48px; border-radius: 4px; flex-shrink: 0; }

  .card-info { flex: 1; min-width: 0; }
  .card-bank { font-size: 0.72rem; color: #9CA3AF; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px; }
  .card-name { font-size: 0.95rem; font-weight: 700; color: #111827; margin-bottom: 4px; }
  .card-type { font-size: 0.7rem; color: #6B7280; font-weight: 400; }
  .card-benefits-mini { font-size: 0.78rem; color: #6B7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .card-metrics { display: flex; gap: 24px; flex-shrink: 0; }

  .metric { text-align: center; }
  .metric-val { font-size: 0.95rem; font-weight: 700; color: #374151; }
  .metric-val.highlight { color: #0D9488; }
  .metric-label { font-size: 0.65rem; color: #9CA3AF; font-weight: 500; white-space: nowrap; }

  .apply-btn {
    background: linear-gradient(135deg, #4F46E5, #7C3AED);
    color: white;
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .apply-btn:hover { opacity: 0.85; }

  .app-nudge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, rgba(79,70,229,0.06), rgba(124,58,237,0.06));
    border: 1px solid rgba(79,70,229,0.12);
    border-radius: 14px;
    padding: 16px 20px;
    font-size: 0.9rem;
    color: #374151;
    font-weight: 500;
    gap: 16px;
  }

  .nudge-btn { padding: 8px 18px !important; font-size: 0.85rem !important; }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #9CA3AF;
  }

  .empty-icon { font-size: 3rem; margin-bottom: 16px; }
  .empty-text { font-size: 1rem; font-weight: 500; }

  @media (max-width: 768px) {
    .card-item { flex-wrap: wrap; }
    .card-metrics { gap: 16px; }
    .app-nudge { flex-direction: column; text-align: center; }
    .finder-box { padding: 20px; }
  }

  @media (max-width: 480px) {
    .card-metrics { display: none; }
  }
</style>
