---
import Layout from '../layouts/Layout.astro';
import { cards } from '../data/cards.js';
const indiaCards = cards.filter(c => c.country === 'IN');
const cardsJson = JSON.stringify(indiaCards);
---

<Layout title="Browse Credit Cards — Virel" description="Compare 50+ India credit cards. Find the best rewards, lounge access, cashback and apply online.">

<div class="cp-page">

  <!-- TOP BAR -->
  <div class="cp-topbar">
    <div class="cp-topbar-inner">
      <div class="cp-tb-left">
        <h1 class="cp-heading">Credit Cards</h1>
        <span class="cp-count-badge" id="cpCount">{indiaCards.length} cards</span>
      </div>
      <div class="cp-search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="cardSearch" placeholder="Search by card name, bank, or category…" />
      </div>
      <div class="cp-tb-right">
        <span class="cp-sub">Compare up to 3 cards</span>
        <button class="cp-compare-btn" id="compareBtn" style="display:none" onclick="openCompare()">⚖️ Compare (<span id="compareCount">0</span>)</button>
      </div>
    </div>
  </div>

  <div class="cp-layout">

    <!-- SIDEBAR FILTERS -->
    <aside class="cp-sidebar">
      <div class="sb-hdr">
        <span class="sb-hdr-title">Filters</span>
        <button class="sb-clear" onclick="clearAllFilters()">Clear All</button>
      </div>

      <!-- BANKS -->
      <div class="sb-section">
        <h3 class="sb-sec-title">BANKS</h3>
        <div id="bankFilters" class="sb-checks"></div>
        <button class="sb-show-more" id="bankToggle" onclick="toggleBankList()">+ Show More</button>
      </div>

      <!-- CATEGORIES -->
      <div class="sb-section">
        <h3 class="sb-sec-title">CATEGORIES</h3>
        <div id="catFilters" class="sb-checks"></div>
        <div class="sb-note">Max. 3 selections allowed</div>
      </div>

      <!-- FEE -->
      <div class="sb-section">
        <h3 class="sb-sec-title">FEE</h3>
        <div class="sb-checks">
          <label class="sb-check-item"><input type="checkbox" value="free" onchange="toggleFee(this)"> Lifetime Free</label>
          <label class="sb-check-item"><input type="checkbox" value="low" onchange="toggleFee(this)"> ₹501 – ₹10K</label>
          <label class="sb-check-item"><input type="checkbox" value="high" onchange="toggleFee(this)"> Above ₹10K</label>
        </div>
      </div>

      <!-- ANDROID PILL -->
      <div class="sb-app-pill">
        <span class="sap-icon">🤖</span>
        <div>
          <div class="sap-small">Android App</div>
          <div class="sap-big">Coming Soon</div>
        </div>
      </div>
    </aside>

    <!-- CARD LIST -->
    <main class="cp-main">
      <div class="cp-list" id="cardList">
        <!-- Rendered by JS -->
      </div>
    </main>

  </div>
</div>

<!-- COMPARE BAR (bottom) -->
<div class="compare-bar" id="compareBar" style="display:none">
  <div class="compare-bar-inner">
    <div class="cb-slots" id="cbSlots"></div>
    <div class="cb-actions">
      <button class="cb-compare-btn" onclick="runCompare()">Compare Now</button>
      <button class="cb-clear" onclick="clearCompare()">Clear</button>
    </div>
  </div>
</div>

<!-- CARD MODAL -->
<div class="card-modal-overlay" id="cardModalOverlay" onclick="closeModal()"></div>
<div class="card-modal" id="cardModal">
  <button class="modal-close-btn" onclick="closeModal()">✕</button>
  <div id="cardModalContent"></div>
</div>

</Layout>

<script define:vars={{ cardsJson }}>
const ALL_CARDS = JSON.parse(cardsJson);

const state = { search:'', banks: new Set(), cats: new Set(), fees: new Set() };
let bankShowAll = false;
const compareSet = new Map(); // idx → card

const CAT_DEFS = [
  { id:'travel',    label:'Travel',        icon:'✈️',  test: c => !!(c.multipliers.Travel || c.multipliers.Flight) },
  { id:'premium',   label:'Premium',       icon:'👑',  test: c => c.rewardRate >= 4 || c.fee >= 5000 },
  { id:'rewards',   label:'Rewards',       icon:'⭐',  test: c => c.rewardRate >= 2 },
  { id:'lounge',    label:'Lounge Access', icon:'🛋️', test: c => c.loungeDomestic === -1 || c.loungeIntl === -1 || c.loungeIntl >= 4 },
  { id:'shopping',  label:'Shopping',      icon:'🛍️', test: c => !!(c.multipliers.Shopping) },
  { id:'dining',    label:'Dining',        icon:'🍽️', test: c => !!(c.multipliers.Dining) },
  { id:'cashback',  label:'Cashback',      icon:'💰',  test: c => !!(c.multipliers.Groceries) || c.name.toLowerCase().includes('ace') },
  { id:'fuel',      label:'Fuel',          icon:'⛽',  test: c => !!(c.multipliers.Fuel) },
  { id:'zeroforex', label:'Zero Forex',    icon:'💱',  test: c => c.forex === 0 },
];

const TAG_COLORS = {
  'Travel':'#4F46E5','Premium':'#7C3AED','Rewards':'#D97706','Lounge Access':'#059669',
  'Shopping':'#BE185D','Dining':'#FF6B35','Cashback':'#D97706','Fuel':'#475569','Zero Forex':'#0369A1',
};

function getCardTags(c) {
  return CAT_DEFS.filter(cat => cat.test(c)).map(cat => cat.label).slice(0,4);
}

function feeMatch(c) {
  if (state.fees.size === 0) return true;
  if (state.fees.has('free') && c.fee === 0) return true;
  if (state.fees.has('low')  && c.fee > 0 && c.fee <= 10000) return true;
  if (state.fees.has('high') && c.fee > 10000) return true;
  return false;
}

function catMatch(c) {
  if (state.cats.size === 0) return true;
  return [...state.cats].every(cid => {
    const def = CAT_DEFS.find(d => d.id === cid);
    return def && def.test(c);
  });
}

function getFiltered() {
  return ALL_CARDS.filter(c => {
    if (state.banks.size > 0 && !state.banks.has(c.bank)) return false;
    if (!catMatch(c)) return false;
    if (!feeMatch(c)) return false;
    if (state.search) {
      const q = state.search.toLowerCase();
      return (c.bank+' '+c.name+' '+c.benefits.join(' ')+' '+c.type).toLowerCase().includes(q);
    }
    return true;
  });
}

// ── CARD MOCKUP ────────────────────────────────────────────────
function networkHTML(type) {
  if (type.includes('Mastercard')) {
    return `<div class="cm-mc"><span class="mc-l"></span><span class="mc-r"></span></div>`;
  }
  if (type.includes('Amex')) return `<span class="cm-net cm-amex">AMEX</span>`;
  if (type.includes('Rupay')) return `<span class="cm-net cm-rupay">RuPay</span>`;
  if (type.includes('Infinite')) return `<span class="cm-net cm-visa cm-infinite">VISA</span>`;
  return `<span class="cm-net cm-visa">VISA</span>`;
}

function cardMockup(c, idx, size = 'md') {
  const numSuffix = String((idx * 2791 + 4821) % 9000 + 1000);
  const isLuxury = c.fee >= 10000;
  return `
    <div class="card-mock cm-${size} ${isLuxury ? 'cm-luxury' : ''}"
         style="background:linear-gradient(135deg,${c.color} 0%,${c.color2} 100%)">
      <div class="cm-sheen"></div>
      <div class="cm-lines"></div>
      <div class="cm-chip">
        <div class="cmc-inner"></div>
        <div class="cmc-line cmc-h"></div>
        <div class="cmc-line cmc-v"></div>
      </div>
      ${networkHTML(c.type)}
      <div class="cm-num">•••• •••• •••• ${numSuffix}</div>
      <div class="cm-foot">
        <div class="cm-bank-nm">${c.bank.replace(' Bank','').replace(' Mahindra','').replace(' Small Finance','').replace(' (SBM Bank)','')}</div>
        <div class="cm-card-nm">${c.name}</div>
      </div>
    </div>
  `;
}

// ── SIDEBAR ────────────────────────────────────────────────────
function renderSidebar() {
  const banks = [...new Set(ALL_CARDS.map(c => c.bank))].sort();
  const shown = bankShowAll ? banks : banks.slice(0, 5);
  document.getElementById('bankFilters').innerHTML = shown.map(b => `
    <label class="sb-check-item ${state.banks.has(b)?'is-checked':''}">
      <input type="checkbox" value="${b}" ${state.banks.has(b)?'checked':''} onchange="toggleBank('${b}')">
      <span class="sbci-label">${b}</span>
    </label>
  `).join('');
  const btn = document.getElementById('bankToggle');
  btn.textContent = bankShowAll ? '− Show Less' : `+ Show More (${banks.length - 5})`;

  document.getElementById('catFilters').innerHTML = CAT_DEFS.map(cat => `
    <label class="sb-check-item ${state.cats.has(cat.id)?'is-checked':''}">
      <input type="checkbox" value="${cat.id}" ${state.cats.has(cat.id)?'checked':''} onchange="toggleCat('${cat.id}')">
      <span class="sbci-icon">${cat.icon}</span>
      <span class="sbci-label">${cat.label}</span>
    </label>
  `).join('');
}

// ── CARD LIST ──────────────────────────────────────────────────
function renderCards() {
  const filtered = getFiltered();
  document.getElementById('cpCount').textContent = `${filtered.length} card${filtered.length===1?'':'s'}`;

  const list = document.getElementById('cardList');
  if (!list) return;

  if (filtered.length === 0) {
    list.innerHTML = `<div class="no-results">
      <div class="nr-emoji">🔍</div>
      <div class="nr-title">No cards match your filters</div>
      <button class="nr-clear" onclick="clearAllFilters()">Clear all filters</button>
    </div>`;
    return;
  }

  list.innerHTML = filtered.map((c, i) => {
    const tags = getCardTags(c);
    const isCompared = [...compareSet.values()].some(x => x.bank===c.bank && x.name===c.name);
    const feeStr = c.fee === 0 ? '₹0 (Lifetime Free)' : `₹${c.fee.toLocaleString()}+ Taxes`;

    return `
      <div class="ci" data-idx="${i}">

        <!-- LEFT: card image + compare -->
        <div class="ci-left">
          ${cardMockup(c, i)}
          <label class="ci-compare-lbl">
            <input type="checkbox" class="ci-cmp-chk" ${isCompared?'checked':''}
              onchange="handleCompare(${i}, this.checked, '${c.bank.replace(/'/g,'\\'')}', '${c.name.replace(/'/g,'\\'')}')">
            <span class="ci-cmp-text">Compare</span>
          </label>
        </div>

        <!-- BODY: title, benefits, fees -->
        <div class="ci-body">
          <div class="ci-header-row">
            <div class="ci-title-wrap">
              <h3 class="ci-title">${c.bank} ${c.name} Credit Card</h3>
              <span class="ci-type-badge">${c.type}</span>
            </div>
            <div class="ci-tags">
              ${tags.map(t => `<span class="ci-tag" style="background:${TAG_COLORS[t]||'#475569'}18;color:${TAG_COLORS[t]||'#475569'};border-color:${TAG_COLORS[t]||'#475569'}30">${t}</span>`).join('')}
            </div>
          </div>

          <div class="ci-benefits">
            ${c.benefits.slice(0,4).map(b => `
              <div class="ci-benefit-row">
                <span class="ci-star">★</span>
                <span>${b}</span>
              </div>
            `).join('')}
          </div>

          <div class="ci-footer-row">
            <div class="ci-fees">
              <span class="ci-fee-item">
                <span class="fee-dot fee-join"></span>
                Joining Fee: <strong>${feeStr}</strong>
              </span>
              <span class="ci-fee-item">
                <span class="fee-dot fee-renew"></span>
                Annual/Renewal Fee: <strong>${feeStr}</strong>
              </span>
            </div>
            <div class="ci-actions">
              <button class="ci-read-more" onclick="openModal(${i}, getFiltered())">Read More</button>
              <a href="${c.applyUrl || '#'}" target="_blank" rel="noopener" class="ci-apply-btn">
                Check Eligibility <span class="ci-arrow">›</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    `;
  }).join('');
}

// ── FILTER HANDLERS ────────────────────────────────────────────
function toggleBank(bank) {
  state.banks.has(bank) ? state.banks.delete(bank) : state.banks.add(bank);
  renderSidebar(); renderCards();
}
function toggleCat(cat) {
  if (state.cats.has(cat)) { state.cats.delete(cat); }
  else if (state.cats.size < 3) { state.cats.add(cat); }
  renderSidebar(); renderCards();
}
function toggleFee(el) {
  el.checked ? state.fees.add(el.value) : state.fees.delete(el.value);
  renderCards();
}
function toggleBankList() {
  bankShowAll = !bankShowAll;
  renderSidebar();
}
function clearAllFilters() {
  state.banks.clear(); state.cats.clear(); state.fees.clear(); state.search = '';
  document.getElementById('cardSearch').value = '';
  document.querySelectorAll('.sb-check-item input[type=checkbox]').forEach(el => el.checked = false);
  renderSidebar(); renderCards();
}
window.toggleBank=toggleBank; window.toggleCat=toggleCat;
window.toggleFee=toggleFee; window.toggleBankList=toggleBankList;
window.clearAllFilters=clearAllFilters;

document.getElementById('cardSearch')?.addEventListener('input', e => {
  state.search = e.target.value;
  renderCards();
});

// ── COMPARE ────────────────────────────────────────────────────
function handleCompare(idx, checked, bank, name) {
  const key = bank + '|' + name;
  if (checked) {
    if (compareSet.size >= 3) {
      alert('You can compare up to 3 cards at once. Remove one first.');
      document.querySelectorAll('.ci-cmp-chk')[idx].checked = false;
      return;
    }
    const card = ALL_CARDS.find(c => c.bank === bank && c.name === name);
    if (card) compareSet.set(key, card);
  } else {
    compareSet.delete(key);
  }
  updateCompareBar();
}
function updateCompareBar() {
  const bar = document.getElementById('compareBar');
  const btn = document.getElementById('compareBtn');
  const cnt = document.getElementById('compareCount');
  const slots = document.getElementById('cbSlots');
  const n = compareSet.size;
  bar.style.display = n > 0 ? 'flex' : 'none';
  if (btn) { btn.style.display = n > 0 ? 'flex' : 'none'; if(cnt) cnt.textContent = n; }
  if (slots) {
    slots.innerHTML = [...compareSet.values()].map((c,i) => `
      <div class="cb-slot">
        ${cardMockup(c, i, 'sm')}
        <div class="cb-slot-name">${c.name}</div>
      </div>
    `).join('') + (n < 3 ? `<div class="cb-slot cb-slot-empty">+ Add card</div>` : '');
  }
}
function clearCompare() {
  compareSet.clear();
  document.querySelectorAll('.ci-cmp-chk').forEach(el => el.checked = false);
  updateCompareBar();
}
window.handleCompare=handleCompare; window.clearCompare=clearCompare;

// expose for inline onclick
window.getFiltered = getFiltered;

// ── MODAL ──────────────────────────────────────────────────────
function openModal(idx, filteredCards) {
  const list = filteredCards || getFiltered();
  const c = list[idx];
  if (!c) return;
  const tags = getCardTags(c);
  const feeStr = c.fee === 0 ? 'Lifetime Free' : `₹${c.fee.toLocaleString()}`;
  document.getElementById('cardModalContent').innerHTML = `
    <div class="modal-top">
      ${cardMockup(c, idx, 'lg')}
      <div class="modal-title-blk">
        <h2 class="modal-card-title">${c.bank} ${c.name}</h2>
        <div class="modal-type">${c.type}</div>
        <div class="modal-tags">
          ${tags.map(t => `<span class="ci-tag" style="background:${TAG_COLORS[t]||'#475569'}18;color:${TAG_COLORS[t]||'#475569'};border-color:${TAG_COLORS[t]||'#475569'}30">${t}</span>`).join('')}
        </div>
      </div>
    </div>
    <div class="modal-stats-grid">
      <div class="ms-item"><div class="ms-val">${feeStr}</div><div class="ms-lbl">Annual Fee</div></div>
      <div class="ms-item"><div class="ms-val">${c.rewardRate}X</div><div class="ms-lbl">Max Reward Rate</div></div>
      <div class="ms-item"><div class="ms-val">${c.loungeDomestic === -1 ? '∞' : (c.loungeDomestic||0)}</div><div class="ms-lbl">Domestic Lounge</div></div>
      <div class="ms-item"><div class="ms-val">${c.loungeIntl === -1 ? '∞' : (c.loungeIntl||'—')}</div><div class="ms-lbl">Intl Lounge</div></div>
      <div class="ms-item"><div class="ms-val">${c.forex}%</div><div class="ms-lbl">Forex Markup</div></div>
      <div class="ms-item"><div class="ms-val">₹${(c.feeWaiver||0).toLocaleString()}</div><div class="ms-lbl">Fee Waiver Spend</div></div>
    </div>
    ${c.signup ? `<div class="modal-welcome"><span class="mw-icon">🎁</span><div><strong>Welcome Offer:</strong> ${c.signup}</div></div>` : ''}
    <h3 class="modal-section-title">All Benefits</h3>
    <div class="modal-benefits-list">
      ${c.benefits.map(b => `<div class="ci-benefit-row"><span class="ci-star">★</span><span>${b}</span></div>`).join('')}
    </div>
    <a href="${c.applyUrl || '#'}" target="_blank" rel="noopener" class="modal-apply-btn">
      Check Eligibility & Apply →
    </a>
  `;
  document.getElementById('cardModalOverlay').style.display = 'block';
  document.getElementById('cardModal').classList.add('open');
}
function closeModal() {
  document.getElementById('cardModalOverlay').style.display = 'none';
  document.getElementById('cardModal').classList.remove('open');
}
window.openModal=openModal; window.closeModal=closeModal;

// ── INIT ──────────────────────────────────────────────────────
renderSidebar();
renderCards();
</script>

<style>
.cp-page { background:#F8FAFC;min-height:100vh }

/* TOP BAR */
.cp-topbar {
  background:white;border-bottom:1px solid #E2E8F0;
  position:sticky;top:68px;z-index:180;
  box-shadow:0 2px 8px rgba(0,0,0,.04);
}
.cp-topbar-inner {
  max-width:1320px;margin:0 auto;padding:12px 24px;
  display:flex;align-items:center;gap:16px;
}
.cp-tb-left { display:flex;align-items:center;gap:10px;flex-shrink:0 }
.cp-heading { font-size:1.2rem;font-weight:900;color:#0F172A;letter-spacing:-.02em }
.cp-count-badge {
  font-size:.7rem;font-weight:800;background:#F1F5F9;color:#475569;
  padding:3px 10px;border-radius:100px;border:1px solid #E2E8F0;
}
.cp-search-wrap {
  flex:1;display:flex;align-items:center;gap:8px;
  background:#F8FAFC;border:1.5px solid #E2E8F0;border-radius:10px;
  padding:9px 14px;transition:border-color .15s;
}
.cp-search-wrap:focus-within { border-color:#7C3AED;background:white }
.cp-search-wrap input {
  flex:1;border:none;background:transparent;font-size:.88rem;color:#0F172A;outline:none;font-family:inherit;
}
.cp-tb-right { display:flex;align-items:center;gap:10px;flex-shrink:0 }
.cp-sub { font-size:.72rem;color:#94A3B8;font-weight:600;white-space:nowrap }
.cp-compare-btn {
  display:flex;align-items:center;gap:6px;
  padding:7px 14px;background:linear-gradient(135deg,#7C3AED,#EC4899);
  color:white;border:none;border-radius:8px;font-size:.78rem;font-weight:800;cursor:pointer;
}

/* LAYOUT */
.cp-layout {
  max-width:1320px;margin:0 auto;padding:24px;
  display:flex;gap:24px;align-items:flex-start;
}

/* SIDEBAR */
.cp-sidebar {
  width:250px;flex-shrink:0;background:white;border-radius:16px;
  border:1px solid #E2E8F0;overflow:hidden;position:sticky;top:130px;
}
.sb-hdr {
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 16px;border-bottom:1px solid #F1F5F9;
}
.sb-hdr-title { font-size:.9rem;font-weight:800;color:#0F172A }
.sb-clear {
  font-size:.72rem;font-weight:700;color:#7C3AED;background:none;border:none;cursor:pointer;padding:0;
}
.sb-section { padding:14px 16px;border-bottom:1px solid #F1F5F9 }
.sb-section:last-of-type { border-bottom:none }
.sb-sec-title {
  font-size:.62rem;font-weight:900;color:#94A3B8;
  text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;
}
.sb-checks { display:flex;flex-direction:column;gap:6px }
.sb-check-item {
  display:flex;align-items:center;gap:8px;
  font-size:.8rem;color:#475569;cursor:pointer;
  padding:4px 6px;border-radius:6px;transition:background .1s;
}
.sb-check-item:hover { background:#F8FAFC }
.sb-check-item.is-checked { color:#7C3AED;font-weight:700 }
.sb-check-item input[type=checkbox] { accent-color:#7C3AED;width:14px;height:14px;cursor:pointer }
.sbci-icon { font-size:.85rem }
.sbci-label { flex:1 }
.sb-show-more {
  margin-top:8px;font-size:.72rem;color:#7C3AED;font-weight:700;
  background:none;border:none;cursor:pointer;padding:0;
}
.sb-note { font-size:.62rem;color:#F59E0B;font-weight:700;margin-top:8px;background:#FEF9C3;padding:4px 8px;border-radius:6px;border:1px solid #FDE68A }
.sb-app-pill {
  display:flex;align-items:center;gap:10px;
  padding:12px 16px;background:linear-gradient(135deg,#0F172A,#1E293B);
}
.sap-icon { font-size:1.4rem }
.sap-small { font-size:.6rem;color:rgba(255,255,255,.6);font-weight:600;text-transform:uppercase }
.sap-big { font-size:.82rem;font-weight:900;color:white }

/* MAIN LIST */
.cp-main { flex:1;min-width:0 }
.cp-list { display:flex;flex-direction:column;gap:12px }

/* CARD ITEM */
.ci {
  background:white;border:1px solid #E2E8F0;border-radius:16px;
  display:flex;gap:0;overflow:hidden;transition:all .2s;
}
.ci:hover { box-shadow:0 6px 24px rgba(0,0,0,.08);border-color:#CBD5E1;transform:translateY(-1px) }

.ci-left {
  display:flex;flex-direction:column;align-items:center;gap:10px;
  padding:20px 16px 16px;background:#FAFAFA;border-right:1px solid #F1F5F9;
  flex-shrink:0;
}
.ci-compare-lbl {
  display:flex;align-items:center;gap:5px;
  font-size:.72rem;color:#64748B;cursor:pointer;font-weight:600;
}
.ci-compare-lbl input[type=checkbox] { accent-color:#7C3AED;width:13px;height:13px }
.ci-cmp-text { font-size:.72rem;color:#64748B }

.ci-body { flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:12px;min-width:0 }

