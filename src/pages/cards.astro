---
import Layout from '../layouts/Layout.astro';
import { cards, categories } from '../data/cards.js';
const cardsJson = JSON.stringify(cards);
const catsJson  = JSON.stringify(categories);
---

<Layout title="Browse Credit Cards — Virel" description="Compare 50+ credit cards. Find the best rewards, lowest fees, lounge access and apply online.">

  <!-- HERO -->
  <section class="ch">
    <div class="ch-bg"></div>
    <div class="ch-glow cg1"></div>
    <div class="ch-glow cg2"></div>
    <div class="container ch-inner">
      <div class="ch-left">
        <span class="section-label">💳 Card Marketplace</span>
        <h1 class="ch-title">Find your <span class="gradient-text">perfect card.</span></h1>
        <p class="ch-sub">Compare 50+ credit cards across rewards, fees, lounge access and signup bonuses. Use Virel to pick the right one.</p>
        <div class="ch-perks">
          {['Exclusive signup bonuses','Best reward rates by category','Lounge access comparison','Fee waiver conditions'].map(p => (
            <span class="ch-perk"><span class="ch-check">✓</span> {p}</span>
          ))}
        </div>
        <div class="ch-btns">
          <a href="#grid" class="btn-primary">Browse All Cards ↓</a>
          <a href="/my-cards" class="btn-secondary">Analyse My Cards →</a>
        </div>
        <div class="app-pills">
          <div class="app-pill app-pill-ios">
            <span class="ap-icon">🍎</span>
            <div><div class="ap-small">Download on the</div><div class="ap-big">App Store</div></div>
          </div>
          <div class="app-pill app-pill-android">
            <span class="ap-icon">🤖</span>
            <div><div class="ap-small">Android App</div><div class="ap-big">Coming Soon</div></div>
            <span class="ap-soon">Soon</span>
          </div>
        </div>
      </div>
      <!-- Animated card fan -->
      <div class="ch-right" aria-hidden="true">
        <div class="card-fan">
          <div class="vis-card vc1"><div class="vc-chip"></div><div class="vc-network">VISA</div><div class="vc-num">•••• •••• •••• 4821</div><div class="vc-bot"><span>HDFC Bank</span><span>Infinia</span></div></div>
          <div class="vis-card vc2"><div class="vc-chip"></div><div class="vc-network">MC</div><div class="vc-num">•••• •••• •••• 7732</div><div class="vc-bot"><span>Axis Bank</span><span>Magnus</span></div></div>
          <div class="vis-card vc3"><div class="vc-chip"></div><div class="vc-network">AMEX</div><div class="vc-num">•••• •••• 2291</div><div class="vc-bot"><span>Amex</span><span>Platinum</span></div></div>
          <div class="vis-card vc4"><div class="vc-chip"></div><div class="vc-network">VISA</div><div class="vc-num">•••• •••• •••• 9910</div><div class="vc-bot"><span>ICICI Bank</span><span>Emeralde</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK STATS -->
  <div class="qs-bar">
    <div class="container qs-inner">
      {[['50+','Cards listed'],['₹0','Best joining fee'],['Unlimited','Lounge access cards'],['10X','Max reward rate']].map(([v,l]) => (
        <div class="qs-item">
          <span class="qs-val">{v}</span>
          <span class="qs-lbl">{l}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- FILTERS + GRID -->
  <section class="browse-sec" id="grid">
    <div class="container">

      <!-- SEARCH + FILTERS -->
      <div class="filters-wrap">
        <div class="search-row">
          <div class="card-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="cardSearch" placeholder="Search cards... (e.g. HDFC, travel, cashback)" />
          </div>
          <div class="view-toggle">
            <button class="vt-btn active" id="gridViewBtn" title="Grid view">⊞</button>
            <button class="vt-btn" id="listViewBtn" title="List view">☰</button>
          </div>
        </div>

        <div class="filter-row">
          <div class="fg">
            <span class="fl">Annual Fee</span>
            <div class="chips" id="f-fee">
              <button class="fchip active" data-val="ALL">All</button>
              <button class="fchip" data-val="free">Free forever</button>
              <button class="fchip" data-val="waivable">Fee waivable</button>
              <button class="fchip" data-val="paid">Paid</button>
            </div>
          </div>
          <div class="fg">
            <span class="fl">Best for</span>
            <div class="chips" id="f-cat">
              <button class="fchip active" data-val="ALL">All</button>
              {categories.map(c => <button class="fchip" data-val={c}>{c}</button>)}
            </div>
          </div>
        </div>
        <div class="result-count"><span id="cardCount">0</span> cards</div>
      </div>

      <!-- CARD GRID -->
      <div class="card-grid" id="cardGrid">
        <!-- Filled by JS -->
      </div>

    </div>
  </section>

  <!-- CARD DETAIL MODAL -->
  <div class="modal-bg" id="modalBg">
    <div class="modal" id="modal">
      <button class="modal-close" id="modalClose">✕</button>
      <div id="modalContent"></div>
    </div>
  </div>

</Layout>

<script define:vars={{ cardsJson, catsJson }}>
const allCards = JSON.parse(cardsJson);
let filtered = [...allCards];
let viewMode = 'grid';
let activeFilters = { country:'IN', fee:'ALL', cat:'ALL', search:'' };

// ── Render a visual credit card ──────────────────────────────
function cardVisual(c, size = 'md') {
  const isSmall = size === 'sm';
  const w = isSmall ? 120 : 200;
  const h = isSmall ? 72  : 120;
  const networkLogo = c.type?.toLowerCase().includes('visa') ? 'VISA' :
                      c.type?.toLowerCase().includes('mastercard') ? '◉◉' :
                      c.type?.toLowerCase().includes('amex') ? 'AMEX' : 'CARD';
  const numLen = c.type?.toLowerCase().includes('amex') ? '•••• •••••• 2291' : '•••• •••• •••• 4821';
  return `
    <div class="crd-visual ${isSmall?'crd-sm':''}" style="
      background:linear-gradient(135deg,${c.color||'#1a237e'} 0%,${c.color2||'#3949ab'} 100%);
      width:${w}px;height:${h}px;
    ">
      <div class="cv-top">
        <div class="cv-chip ${isSmall?'cv-chip-sm':''}"></div>
        <span class="cv-network ${isSmall?'cv-net-sm':''}">${networkLogo}</span>
      </div>
      <div class="cv-num ${isSmall?'cv-num-sm':''}">${numLen}</div>
      <div class="cv-bot ${isSmall?'cv-bot-sm':''}">
        <span class="cv-bank">${c.bank}</span>
        <span class="cv-name">${c.name}</span>
      </div>
    </div>
  `;
}

// ── Render card grid item ────────────────────────────────────
function cardGridItem(c) {
  const feeStr = c.fee === 0 ? '<span class="c-free">Free Forever</span>' :
                 c.feeWaiver > 0 ? `<span class="c-waiv">₹${c.fee.toLocaleString()} (waivable)</span>` :
                 `<span class="c-paid">₹${c.fee.toLocaleString()}/yr</span>`;
  const lounge = c.loungeDomestic === -1 ? '∞ Unlimited' :
                 c.loungeDomestic === 0  ? 'No lounge' :
                 `${c.loungeDomestic}× domestic`;
  const loungeColor = c.loungeDomestic === -1 ? '#10B981' :
                      c.loungeDomestic === 0  ? '#94A3B8' : '#7C3AED';
  const topMult = Object.entries(c.multipliers||{}).sort((a,b)=>b[1]-a[1])[0];
  const signupBadge = c.signup ? `<div class="c-signup">🎁 ${c.signup}</div>` : '';
  return `
    <div class="crd-card" data-idx="${allCards.indexOf(c)}" onclick="openModal(${allCards.indexOf(c)})">
      <div class="cc-visual-wrap">
        ${cardVisual(c)}
        ${c.signup ? `<span class="cc-bonus-tag">Signup Bonus</span>` : ''}
      </div>
      <div class="cc-body">
        <div class="cc-header">
          <div>
            <div class="cc-bank">${c.bank}</div>
            <div class="cc-name">${c.name}</div>
          </div>
          <span class="cc-type-badge">${c.type||'Credit'}</span>
        </div>
        <div class="cc-stats">
          <div class="cc-stat">
            <span class="ccs-val" style="color:#FF6B35">${c.rewardRate}%</span>
            <span class="ccs-lbl">Max Reward</span>
          </div>
          <div class="cc-stat-sep"></div>
          <div class="cc-stat">
            <span class="ccs-val" style="color:${loungeColor}">${lounge}</span>
            <span class="ccs-lbl">Lounge Access</span>
          </div>
          <div class="cc-stat-sep"></div>
          <div class="cc-stat">
            ${feeStr}
            <span class="ccs-lbl">Annual Fee</span>
          </div>
        </div>
        ${topMult ? `<div class="cc-best-cat"><span class="cc-cat-icon">⚡</span> Best for <strong>${topMult[0]}</strong> — <span style="color:#7C3AED;font-weight:800">${topMult[1]}x</span> rewards</div>` : ''}
        ${signupBadge}
        <div class="cc-benefits-preview">
          ${c.benefits.slice(0,2).map(b=>`<div class="cc-benefit"><span>◆</span>${b}</div>`).join('')}
        </div>
        <div class="cc-actions">
          <a href="${c.applyUrl}" target="_blank" rel="noopener" class="cc-apply" onclick="event.stopPropagation()">Apply Now →</a>
          <button class="cc-details" onclick="event.stopPropagation();openModal(${allCards.indexOf(c)})">Full Details</button>
        </div>
      </div>
    </div>
  `;
}

// ── Render list item ─────────────────────────────────────────
function cardListItem(c) {
  const lounge = c.loungeDomestic === -1 ? 'Unlimited' : c.loungeDomestic === 0 ? 'None' : `${c.loungeDomestic}×`;
  return `
    <div class="crd-list-item" onclick="openModal(${allCards.indexOf(c)})">
      ${cardVisual(c, 'sm')}
      <div class="cli-body">
        <div class="cli-top">
          <div>
            <span class="cli-bank">${c.bank}</span>
            <span class="cli-name">${c.name}</span>
          </div>
          <span class="cli-type">${c.type||'Credit'}</span>
        </div>
        <div class="cli-meta">
          <span class="cli-m"><span style="color:#FF6B35;font-weight:800">${c.rewardRate}%</span> max reward</span>
          <span class="cli-m">🛫 Lounge: <strong>${lounge}</strong></span>
          <span class="cli-m">💳 Fee: ${c.fee===0?'Free':('₹'+c.fee.toLocaleString())}</span>
          ${c.forex===0?'<span class="cli-m">✈️ <strong>0% forex</strong></span>':''}
        </div>
        ${c.signup?`<div class="cli-signup">🎁 ${c.signup}</div>`:''}
      </div>
      <div class="cli-actions">
        <a href="${c.applyUrl}" target="_blank" rel="noopener" class="cc-apply" onclick="event.stopPropagation()">Apply</a>
      </div>
    </div>
  `;
}

// ── Modal ────────────────────────────────────────────────────
function openModal(idx) {
  const c = allCards[idx];
  if (!c) return;
  const lounge = c.loungeDomestic === -1 ? 'Unlimited domestic' :
                 c.loungeDomestic === 0 ? 'No domestic lounge' : `${c.loungeDomestic} domestic visits/year`;
  const intlLounge = c.loungeIntl === -1 ? 'Unlimited international' :
                     c.loungeIntl === 0 ? '' : `${c.loungeIntl} international visits/year`;
  const mults = Object.entries(c.multipliers||{}).sort((a,b)=>b[1]-a[1]);

  document.getElementById('modalContent').innerHTML = `
    <div class="modal-top">
      ${cardVisual(c)}
      <div class="modal-header">
        <div class="modal-bank">${c.bank}</div>
        <h2 class="modal-name">${c.name}</h2>
        <div class="modal-type">${c.type||'Credit Card'} · ${c.country==='IN'?'🇮🇳 India':'🇺🇸 US'}</div>
      </div>
    </div>
    <div class="modal-stats-row">
      <div class="ms-item">
        <div class="ms-val" style="color:#FF6B35">${c.rewardRate}%</div>
        <div class="ms-lbl">Max Reward Rate</div>
      </div>
      <div class="ms-item">
        <div class="ms-val" style="color:#7C3AED">${c.fee===0?'₹0':('₹'+c.fee.toLocaleString())}</div>
        <div class="ms-lbl">Annual Fee${c.feeWaiver>0?' (waivable)':''}</div>
      </div>
      <div class="ms-item">
        <div class="ms-val" style="color:#9333EA">${c.forex||3.5}%</div>
        <div class="ms-lbl">Forex Markup</div>
      </div>
    </div>
    ${c.signup?`<div class="modal-signup-banner">🎁 Signup Bonus: <strong>${c.signup}</strong></div>`:''}
    ${mults.length?`
    <div class="modal-section">
      <div class="modal-sec-title">⚡ Reward Multipliers</div>
      <div class="modal-mults">
        ${mults.map(([cat,r])=>`<div class="mult-chip"><span>${cat}</span><strong>${r}x</strong></div>`).join('')}
      </div>
    </div>`:''}
    <div class="modal-section">
      <div class="modal-sec-title">🛫 Lounge Access</div>
      <div class="modal-lounge">
        <span class="lounge-badge">${lounge}</span>
        ${intlLounge?`<span class="lounge-badge lounge-intl">${intlLounge}</span>`:''}
      </div>
    </div>
    <div class="modal-section">
      <div class="modal-sec-title">✨ Key Benefits</div>
      <ul class="modal-benefits">
        ${c.benefits.map(b=>`<li><span class="mb-dot">◆</span>${b}</li>`).join('')}
      </ul>
    </div>
    ${c.feeWaiver>0?`<div class="modal-waiver">💡 Fee waived on ₹${(c.feeWaiver/100000).toFixed(0)}L+ annual spend</div>`:''}
    <a href="${c.applyUrl}" target="_blank" rel="noopener" class="modal-apply-btn">Apply for ${c.name} →</a>
  `;
  document.getElementById('modalBg').classList.add('open');
  document.body.style.overflow = 'hidden';
}
window.openModal = openModal;
document.getElementById('modalClose')?.addEventListener('click', closeModal);
document.getElementById('modalBg')?.addEventListener('click', e => { if(e.target===e.currentTarget) closeModal(); });
function closeModal() {
  document.getElementById('modalBg').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });

// ── Filter & render ──────────────────────────────────────────
function applyFilters() {
  filtered = allCards.filter(c => {
    if (activeFilters.country !== 'ALL' && c.country !== activeFilters.country) return false;
    if (activeFilters.fee === 'free' && c.fee !== 0) return false;
    if (activeFilters.fee === 'waivable' && c.feeWaiver === 0) return false;
    if (activeFilters.fee === 'paid' && (c.fee === 0 || c.feeWaiver > 0)) return false;
    if (activeFilters.cat !== 'ALL') {
      const mult = c.multipliers?.[activeFilters.cat];
      if (!mult || mult <= 1) return false;
    }
    if (activeFilters.search) {
      const q = activeFilters.search.toLowerCase();
      if (!c.bank.toLowerCase().includes(q) &&
          !c.name.toLowerCase().includes(q) &&
          !c.benefits.some(b=>b.toLowerCase().includes(q))) return false;
    }
    return true;
  });
  render();
}

function render() {
  const grid = document.getElementById('cardGrid');
  const cnt  = document.getElementById('cardCount');
  if (!grid) return;
  cnt.textContent = filtered.length;
  if (filtered.length === 0) {
    grid.innerHTML = '<div class="no-results">😕 No cards match your filters. Try removing some.</div>';
    return;
  }
  grid.className = viewMode === 'grid' ? 'card-grid' : 'card-list';
  grid.innerHTML = filtered.map(c => viewMode==='grid' ? cardGridItem(c) : cardListItem(c)).join('');
}

// ── Filter chips ─────────────────────────────────────────────
function setupChips(id, key) {
  document.getElementById(id)?.addEventListener('click', e => {
    const btn = e.target.closest('.fchip');
    if (!btn) return;
    document.querySelectorAll(`#${id} .fchip`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeFilters[key] = btn.dataset.val;
    applyFilters();
  });
}
setupChips('f-fee','fee');
setupChips('f-cat','cat');

document.getElementById('cardSearch')?.addEventListener('input', e => {
  activeFilters.search = e.target.value.trim();
  applyFilters();
});

document.getElementById('gridViewBtn')?.addEventListener('click', () => {
  viewMode = 'grid';
  document.getElementById('gridViewBtn').classList.add('active');
  document.getElementById('listViewBtn').classList.remove('active');
  render();
});
document.getElementById('listViewBtn')?.addEventListener('click', () => {
  viewMode = 'list';
  document.getElementById('listViewBtn').classList.add('active');
  document.getElementById('gridViewBtn').classList.remove('active');
  render();
});

applyFilters();
</script>

<style>
/* HERO */
.ch {
  position:relative;overflow:hidden;
  background:linear-gradient(135deg,#0F172A 0%,#1E1B4B 40%,#4C1D95 100%);
  padding:80px 0 60px;
}
.ch-bg {
  position:absolute;inset:0;
  background:radial-gradient(ellipse 70% 60% at 60% 50%,rgba(124,58,237,.4) 0%,transparent 70%),
             radial-gradient(ellipse 40% 40% at 10% 80%,rgba(255,107,53,.2) 0%,transparent 60%);
}
.ch-glow { position:absolute;border-radius:50%;filter:blur(80px);opacity:.4;animation:cg 7s ease-in-out infinite }
.cg1 { width:350px;height:350px;background:#7C3AED;right:-60px;top:-60px;animation-delay:0s }
.cg2 { width:280px;height:280px;background:#FF6B35;left:10%;bottom:-40px;animation-delay:3.5s }
@keyframes cg { 0%,100%{transform:translateY(0)}50%{transform:translateY(-22px)} }
.ch-inner { display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2 }
.ch-left { color:white }
.ch-title { font-size:clamp(2rem,4.5vw,3.2rem);font-weight:900;letter-spacing:-.03em;margin:10px 0 16px;color:white }
.ch-sub   { font-size:1rem;color:rgba(255,255,255,.72);line-height:1.7;margin-bottom:24px;max-width:460px }
.ch-perks { display:flex;flex-direction:column;gap:7px;margin-bottom:28px }
.ch-perk  { font-size:.84rem;color:rgba(255,255,255,.82);display:flex;align-items:center;gap:8px }
.ch-check {
  width:20px;height:20px;border-radius:50%;
  background:linear-gradient(135deg,#10B981,#059669);
  color:white;font-size:.65rem;font-weight:900;
  display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;
}
.ch-btns { display:flex;gap:12px;flex-wrap:wrap }
.app-pills { display:flex;gap:10px;flex-wrap:wrap;margin-top:4px }
.app-pill {
  display:flex;align-items:center;gap:9px;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
  backdrop-filter:blur(8px);border-radius:11px;padding:9px 16px;
  color:white;transition:background .15s;position:relative;
}
.app-pill:hover { background:rgba(255,255,255,.14) }
.app-pill-android { opacity:.72;cursor:default }
.ap-icon { font-size:1.5rem;line-height:1 }
.ap-small { font-size:.58rem;color:rgba(255,255,255,.65);font-weight:600;letter-spacing:.04em }
.ap-big   { font-size:.88rem;font-weight:800;letter-spacing:-.01em }
.ap-soon  {
  position:absolute;top:-6px;right:-6px;
  font-size:.52rem;font-weight:900;background:linear-gradient(135deg,#F59E0B,#EC4899);
  color:white;padding:2px 6px;border-radius:100px;text-transform:uppercase;letter-spacing:.04em;
}

/* CARD FAN */
.ch-right { display:flex;justify-content:center;align-items:center }
.card-fan { position:relative;width:280px;height:200px }
.vis-card {
  position:absolute;width:200px;height:120px;border-radius:14px;
  padding:14px;display:flex;flex-direction:column;justify-content:space-between;
  box-shadow:0 8px 28px rgba(0,0,0,.35);transition:transform .2s;
}
.vc1 { background:linear-gradient(135deg,#1a1a1a,#37474f)!important;top:60px;left:40px;z-index:4 }
.vc2 { background:linear-gradient(135deg,#880e4f,#560027)!important;top:30px;left:20px;z-index:3;transform:rotate(-6deg) }
.vc3 { background:linear-gradient(135deg,#424242,#1a1a1a)!important;top:20px;left:60px;z-index:2;transform:rotate(6deg) }
.vc4 { background:linear-gradient(135deg,#1b5e20,#003300)!important;top:10px;left:10px;z-index:1;transform:rotate(-12deg) }
.vc-chip { width:22px;height:17px;background:linear-gradient(135deg,#FCD34D,#F59E0B);border-radius:3px }
.vc-network { font-size:.6rem;font-weight:900;color:rgba(255,255,255,.7);letter-spacing:.04em }
.vc-top { display:flex;align-items:center;justify-content:space-between }
.vc-num { font-size:.58rem;color:rgba(255,255,255,.8);letter-spacing:.12em;font-weight:600 }
.vc-bot { display:flex;justify-content:space-between;font-size:.6rem;color:rgba(255,255,255,.7);font-weight:600 }

/* QUICK STATS */
.qs-bar { background:#F8FAFC;border-bottom:1px solid #E2E8F0;padding:16px 0 }
.qs-inner { display:flex;justify-content:center;gap:40px;flex-wrap:wrap }
.qs-item  { display:flex;flex-direction:column;align-items:center;gap:2px }
.qs-val   { font-size:1.3rem;font-weight:900;color:#0F172A;letter-spacing:-.02em }
.qs-lbl   { font-size:.7rem;color:#94A3B8;font-weight:700;text-transform:uppercase;letter-spacing:.06em }

/* BROWSE */
.browse-sec { padding:40px 0 80px }
.filters-wrap {
  background:white;border:1.5px solid #E2E8F0;border-radius:20px;
  padding:20px;margin-bottom:32px;
  box-shadow:0 2px 16px rgba(0,0,0,.04);
}
.search-row { display:flex;align-items:center;gap:12px;margin-bottom:18px }
.card-search {
  flex:1;display:flex;align-items:center;gap:8px;
  background:#F8FAFC;border:1.5px solid #E2E8F0;
  border-radius:12px;padding:10px 14px;
  transition:border-color .15s;
}
.card-search:focus-within { border-color:#7C3AED;background:white }
.card-search input {
  flex:1;border:none;background:transparent;font-family:inherit;
  font-size:.88rem;outline:none;color:#0F172A;
}
.card-search input::placeholder { color:#94A3B8 }
.view-toggle { display:flex;gap:4px }
.vt-btn {
  width:34px;height:34px;border-radius:8px;border:1px solid #E2E8F0;
  background:white;cursor:pointer;font-size:.95rem;
