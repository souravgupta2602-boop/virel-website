---
import Layout from '../layouts/Layout.astro';

const hotelsByDest = {
  'Bali': [
    { name:'Four Seasons Resort Bali', area:'Sayan, Ubud', price:18200, rating:9.4, reviews:1842, source2rating:9.2, source2reviews:340, verified:true, tags:['Infinity Pool','Jungle View','Spa'], amenities:['Free Breakfast Included','Airport Transfer Available','Spa & Wellness Centre'], img:'linear-gradient(160deg,#059669,#10B981,#34D399)', emoji:'🌿', badge:'Top Pick' },
    { name:'W Bali – Seminyak',        area:'Beachfront, Seminyak', price:12400, rating:8.8, reviews:2340, source2rating:8.6, source2reviews:890, verified:true, tags:['Beach Access','Rooftop Bar','Pool'], amenities:['Beachfront Location','Infinity Pool','Nightlife Nearby'], img:'linear-gradient(160deg,#EC4899,#7C3AED,#4C1D95)', emoji:'🌊', badge:'' },
    { name:'Alaya Resort Ubud',         area:'Rice Terrace View, Ubud', price:7800, rating:9.1, reviews:675, source2rating:9.0, source2reviews:200, verified:true, tags:['Rice Views','Private Villa','Yoga'], amenities:['Private Plunge Pool','Yoga Studio','Cultural Tours'], img:'linear-gradient(160deg,#166534,#16A34A,#4ADE80)', emoji:'🌾', badge:'Best Value' },
    { name:'Komaneka at Bisma',         area:'Bisma Ridge, Ubud', price:14600, rating:9.3, reviews:412, source2rating:9.1, source2reviews:95, verified:true, tags:['Valley View','Luxury','Adults Only'], amenities:['Valley View Rooms','Fine Dining','Couples Spa'], img:'linear-gradient(160deg,#7C2D12,#EA580C,#FED7AA)', emoji:'🌅', badge:'' },
    { name:'Potato Head Suites & Studios', area:'Petitenget, Seminyak', price:9600, rating:8.5, reviews:1230, source2rating:8.3, source2reviews:445, verified:false, tags:['Design Hotel','Beach Club','Bar'], amenities:['Award-Winning Beach Club','Design Rooms','Party Atmosphere'], img:'linear-gradient(160deg,#9D174D,#EC4899,#FBCFE8)', emoji:'🎨', badge:'' },
    { name:'Anantara Seminyak Bali Resort', area:'Seminyak Beach', price:11200, rating:8.9, reviews:1870, source2rating:8.7, source2reviews:620, verified:true, tags:['Beachfront','Sunset Views','Pool'], amenities:['Beachfront Location','Sunset Bar','Outdoor Pool'], img:'linear-gradient(160deg,#B45309,#D97706,#FCD34D)', emoji:'🌇', badge:'' },
  ],
  'Goa': [
    { name:'Taj Fort Aguada Resort', area:'Sinquerim Beach', price:16800, rating:9.1, reviews:2100, source2rating:8.9, source2reviews:780, verified:true, tags:['Heritage','Beach','Pool'], amenities:['Private Beach Access','Heritage Property','Multiple Restaurants'], img:'linear-gradient(160deg,#7C3AED,#EC4899,#FB923C)', emoji:'🏰', badge:'Top Pick' },
    { name:'W Goa',                   area:'Vagator Beach', price:13500, rating:8.7, reviews:1560, source2rating:8.5, source2reviews:530, verified:true, tags:['Party','Beach','Design'], amenities:['Beachfront','Infinity Pool','Award-Winning Bar'], img:'linear-gradient(160deg,#7C3AED,#A78BFA,#EDE9FE)', emoji:'🎉', badge:'' },
    { name:'Aloft North Goa',         area:'Candolim', price:6400, rating:8.3, reviews:3200, source2rating:8.1, source2reviews:1100, verified:true, tags:['Value','Pool','Tech-Friendly'], amenities:['Near Calangute Beach','Rooftop Pool','Fast WiFi'], img:'linear-gradient(160deg,#059669,#10B981,#A7F3D0)', emoji:'🌴', badge:'Best Value' },
    { name:'ITC Grand Goa',           area:'South Goa, Arossim', price:18900, rating:9.2, reviews:890, source2rating:9.0, source2reviews:280, verified:true, tags:['Luxury','Secluded','Spa'], amenities:['Secluded Beach','Award-Winning Spa','Golf Course'], img:'linear-gradient(160deg,#B45309,#D97706,#FEF3C7)', emoji:'👑', badge:'' },
    { name:'Park Hyatt Goa',          area:'Arossim Beach, South Goa', price:15200, rating:9.0, reviews:1340, source2rating:8.8, source2reviews:460, verified:true, tags:['Portuguese Style','Pool','Spa'], amenities:['Free Breakfast','Lagoon Pool','Direct Beach Access'], img:'linear-gradient(160deg,#0F172A,#5B21B6,#8B5CF6)', emoji:'🏖️', badge:'' },
    { name:'Pousada Tauma',           area:'Calangute', price:4200, rating:8.6, reviews:540, source2rating:8.4, source2reviews:110, verified:false, tags:['Boutique','Pool','Quiet'], amenities:['Boutique Property','Small Pool','Walking to Beach'], img:'linear-gradient(160deg,#BE185D,#EC4899,#F9A8D4)', emoji:'🌸', badge:'Hidden Gem' },
  ],
  'Dubai': [
    { name:'Burj Al Arab Jumeirah', area:'Jumeirah Beach', price:98000, rating:9.5, reviews:4200, source2rating:9.3, source2reviews:1800, verified:true, tags:['Iconic','Luxury','Helipad'], amenities:['Private Beach','Michelin Dining','Butler Service'], img:'linear-gradient(160deg,#B45309,#D97706,#FCD34D)', emoji:'🏙️', badge:'Iconic' },
    { name:'Atlantis The Palm',      area:'Palm Jumeirah', price:38500, rating:8.8, reviews:6700, source2rating:8.6, source2reviews:2400, verified:true, tags:['Waterpark','Beach','Resort'], amenities:['Aquaventure Waterpark','Private Beach','Multiple Pools'], img:'linear-gradient(160deg,#7C3AED,#EC4899,#FF6B35)', emoji:'🌊', badge:'Top Pick' },
    { name:'Armani Hotel Dubai',     area:'Downtown, Burj Khalifa', price:42000, rating:9.2, reviews:1900, source2rating:9.0, source2reviews:650, verified:true, tags:['Design','Luxury','Downtown'], amenities:['Burj Khalifa Location','Armani Spa','Designer Rooms'], img:'linear-gradient(160deg,#1E293B,#334155,#94A3B8)', emoji:'✨', badge:'' },
    { name:'Jumeirah Beach Hotel',   area:'Jumeirah Beach Residence', price:22000, rating:8.9, reviews:3400, source2rating:8.7, source2reviews:1200, verified:true, tags:['Beach','Family','Pool'], amenities:['Private Beach','Water Sports','Kids Club'], img:'linear-gradient(160deg,#047857,#10B981,#6EE7B7)', emoji:'🏄', badge:'Family Choice' },
  ],
  'Jaipur': [
    { name:'Rambagh Palace',          area:'Bhawani Singh Road', price:42000, rating:9.4, reviews:1200, source2rating:9.2, source2reviews:480, verified:true, tags:['Royal Heritage','Palace','Spa'], amenities:['Heritage Palace Stay','Royal Spa','Polo Ground'], img:'linear-gradient(160deg,#BE185D,#EC4899,#F9A8D4)', emoji:'🏰', badge:'Most Iconic' },
    { name:'Jai Mahal Palace',        area:'Jacob Road, Civil Lines', price:18500, rating:9.0, reviews:870, source2rating:8.8, source2reviews:310, verified:true, tags:['Heritage','Garden','Pool'], amenities:['Mughal Gardens','Heritage Architecture','Candlelit Dining'], img:'linear-gradient(160deg,#D97706,#F59E0B,#FEF3C7)', emoji:'🌹', badge:'' },
    { name:'The Oberoi Rajvilas',     area:'Goner Road', price:52000, rating:9.5, reviews:640, source2rating:9.3, source2reviews:200, verified:true, tags:['Luxury Villa','Pool','Spa'], amenities:['Private Pool Villas','Award-Winning Spa','Rajasthani Cuisine'], img:'linear-gradient(160deg,#7C2D12,#EA580C,#FB923C)', emoji:'🏡', badge:'Top Luxury' },
    { name:'Hotel Narain Niwas Palace', area:'Kanota Bagh', price:9800, rating:8.4, reviews:1560, source2rating:8.2, source2reviews:580, verified:false, tags:['Budget Palace','Garden','Heritage'], amenities:['Heritage Havelis','Garden','Value for Money'], img:'linear-gradient(160deg,#166534,#16A34A,#4ADE80)', emoji:'🌿', badge:'Best Value' },
  ],
};

const aiQuestionsByDest = {
  'Bali':   ['Which Ubud area is best for rice terrace views?','Show me hotels with infinity pools and jungle views.','Best boutique villas for a honeymoon in Seminyak?','Are there adults-only resorts near Nusa Penida?'],
  'Goa':    ['Best beachfront hotels in North Goa under ₹10,000?','Which hotels have the best sunset views?','Show me heritage hotels in South Goa.','Family-friendly resorts near Calangute Beach?'],
  'Dubai':  ['Best hotels near Burj Khalifa for a 3-night stay?','Show me hotels with private beach access.','Which hotel offers best desert views?','Kid-friendly resorts on Palm Jumeirah?'],
  'Jaipur': ['Which palace hotels are authentic royal stays?','Best heritage hotels near Amber Fort?','Show me hotels with rooftop dining and fort views.','Are there any villas with private pools in Jaipur?'],
};

const defaultDest = 'Bali';
---

<Layout title="Stays — Hotel Search | Virel" description="Find the best hotels and stays for your trip. AI-curated picks, real-time prices, and best credit card to use. Compare Booking.com, Hotellook and more.">

  <!-- STICKY TOP SEARCH BAR -->
  <div class="stays-topbar">
    <div class="stb-left">
      <button class="stb-menu" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="stb-title">Stays</span>
    </div>

    <div class="stb-search-pill" id="searchPill">
      <div class="stb-field" id="sf-where" onclick="focusWhere()">
        <span class="stb-field-label">WHERE</span>
        <span class="stb-field-val" id="dest-display">Bali</span>
      </div>
      <div class="stb-divider"></div>
      <div class="stb-field" id="sf-when">
        <span class="stb-field-label">WHEN</span>
        <span class="stb-field-val" id="dates-display">Select dates</span>
      </div>
      <div class="stb-divider"></div>
      <div class="stb-field" id="sf-guests">
        <span class="stb-field-label">GUESTS</span>
        <span class="stb-field-val">2 Guests</span>
      </div>
      <div class="stb-divider"></div>
      <div class="stb-field stb-prefs" id="sf-prefs">
        <span class="stb-field-label">PREFERENCES</span>
        <span class="stb-field-val">Couple, Leisure</span>
      </div>
      <button class="stb-search-btn" id="searchBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Search
      </button>
    </div>

    <div class="stb-right">
      <button class="stb-icon-btn" title="Filters">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
      </button>
      <button class="stb-icon-btn" title="Sort">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
      </button>
      <button class="stb-trip-badge" id="tripBadge">Bali Trip ✏️</button>
    </div>
  </div>

  <!-- DESTINATION SEARCH DROPDOWN (hidden by default) -->
  <div class="dest-dropdown" id="destDropdown" style="display:none">
    <div class="dest-dropdown-inner">
      <input type="text" id="destSearchInput" placeholder="Search destinations..." class="dest-search-input" />
      <div class="dest-suggestions">
        {Object.keys(hotelsByDest).map(d => (
          <button class="dest-suggestion" onclick={`selectDest('${d}')`}>
            <span class="dest-sug-icon">{d === 'Bali' ? '🌴' : d === 'Goa' ? '🏖️' : d === 'Dubai' ? '🏙️' : '🏰'}</span>
            <div>
              <div style="font-weight:700;font-size:.88rem;color:#0F172A">{d}</div>
              <div style="font-size:.72rem;color:#94A3B8">{d === 'Bali' ? 'Indonesia' : d === 'Goa' ? 'India' : d === 'Dubai' ? 'UAE' : 'India'}</div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- AI QUESTION CHIPS -->
  <div class="ai-chips-bar">
    <div class="aic-scroll" id="aiChipsRow">
      <!-- filled by JS -->
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="stays-layout">

    <!-- HOTELS PANEL -->
    <div class="hotels-panel" id="hotelsPanel">
      <p class="price-note">Prices displayed are per room · per night · Taxes may apply</p>

      <!-- HANDPICKED SECTION -->
      <div class="handpicked-section" id="handpickedSection">
        <div class="hp-header">
          <span class="hp-trophy">🏆</span>
          <span class="hp-label">Handpicked</span>
          <span class="hp-sub"> top hotels for you</span>
        </div>
        <div class="hotels-grid" id="hotelsGrid">
          <!-- filled by JS -->
        </div>
      </div>

      <!-- MORE HOTELS -->
      <div class="more-hotels-hdr">
        <h3 class="mh-title" id="moreTitle">All Hotels in Bali</h3>
        <div class="mh-sort">
          <span style="font-size:.75rem;color:#94A3B8;font-weight:600">Sort by:</span>
          <button class="sort-chip active" onclick="setSortActive(this)">Our Picks</button>
          <button class="sort-chip" onclick="setSortActive(this)">Price ↑</button>
          <button class="sort-chip" onclick="setSortActive(this)">Rating</button>
        </div>
      </div>
      <div class="hotels-grid hotels-grid-full" id="moreGrid">
        <!-- filled by JS (same cards, all shown) -->
      </div>
    </div>

    <!-- MAP SIDEBAR -->
    <div class="map-panel" id="mapPanel">
      <div class="map-header">
        <button class="map-back-btn">←</button>
        <div class="map-area-btn">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Best areas ▾
        </div>
      </div>
      <div class="map-container" id="mapContainer">
        <div class="map-bg">
          <div class="map-placeholder">
            <div class="map-grid"></div>
            <!-- Price pins (positioned) -->
            <div class="map-pins" id="mapPins"></div>
            <div class="map-label" id="mapCityLabel">Bali, Indonesia</div>
          </div>
        </div>
        <div class="map-count" id="mapCount">6 stays on map</div>
      </div>
      <!-- Best Card for Hotels -->
      <div class="map-card-tip" id="cardTip">
        <div class="mct-header">
          <span style="font-size:.7rem;font-weight:800;color:#0F172A;text-transform:uppercase;letter-spacing:.06em">💳 Best Card for Hotels</span>
        </div>
        <div class="mct-cards" id="bestCards">
          <div class="mct-card">
            <div class="mct-dot" style="background:linear-gradient(135deg,#7C3AED,#EC4899)"></div>
            <div>
              <div style="font-size:.72rem;font-weight:800;color:#0F172A">HDFC Infinia</div>
              <div style="font-size:.62rem;color:#10B981;font-weight:700">5x reward points on hotels</div>
            </div>
            <div style="font-size:.7rem;font-weight:900;color:#7C3AED;margin-left:auto">Best</div>
          </div>
          <div class="mct-card">
            <div class="mct-dot" style="background:linear-gradient(135deg,#7C3AED,#EC4899)"></div>
            <div>
              <div style="font-size:.72rem;font-weight:800;color:#0F172A">Axis Magnus</div>
              <div style="font-size:.62rem;color:#64748B;font-weight:600">4x on travel booking</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI ASK BOTTOM BAR -->
  <div class="ai-ask-bar">
    <div class="aab-inner">
      <span class="aab-icon">✨</span>
      <input type="text" class="aab-input" placeholder='Ask: "Best local food spots near my stay"' id="aiAskInput" />
      <button class="aab-send" onclick="handleAiAsk()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9"/></svg>
      </button>
    </div>
  </div>

</Layout>

<script define:vars={{ hotelsByDest, aiQuestionsByDest }}>

let currentDest = 'Bali';

const pinPositions = [
  { x:'22%',  y:'35%', label:'₹6,276' },
  { x:'38%',  y:'28%', label:'₹9,252' },
  { x:'55%',  y:'42%', label:'₹2,279' },
  { x:'68%',  y:'55%', label:'₹13,416' },
  { x:'45%',  y:'62%', label:'₹5,705' },
  { x:'78%',  y:'38%', label:'₹2,754' },
  { x:'30%',  y:'68%', label:'₹3,323' },
  { x:'60%',  y:'75%', label:'₹7,593' },
];

function renderAiChips(dest) {
  const chips = aiQuestionsByDest[dest] || aiQuestionsByDest['Bali'];
  const row = document.getElementById('aiChipsRow');
  if (!row) return;
  row.innerHTML = chips.map(q => `
    <button class="aic-chip" onclick="handleAiChip(this)">
      <span class="aic-sparkle">✨</span>${q}
    </button>
  `).join('');
}

function renderHotels(dest) {
  const hotels = hotelsByDest[dest] || hotelsByDest['Bali'];
  const grid = document.getElementById('hotelsGrid');
  const moreGrid = document.getElementById('moreGrid');
  const moreTitle = document.getElementById('moreTitle');
  if (moreTitle) moreTitle.textContent = `All Hotels in ${dest}`;

  const hotelCard = (h) => `
    <div class="hotel-card">
      <div class="hc-photo" style="background:${h.img}">
        <button class="hc-heart" onclick="toggleHeart(this)" aria-label="Save">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        <div class="hc-photo-inner">${h.emoji}</div>
        ${h.badge ? `<span class="hc-badge">${h.badge}</span>` : ''}
        <div class="hc-tags">
          ${h.tags.slice(0,2).map(t => `<span class="hc-tag">${t}</span>`).join('')}
        </div>
      </div>
      <div class="hc-body">
        <div class="hc-ratings">
          <span class="hc-rating booking">
            <span class="hc-rating-src">B</span>
            ${h.rating} <span class="hc-rating-count">(${h.reviews.toLocaleString()})</span>
          </span>
          <span class="hc-rating tripadvisor">
            <span class="hc-rating-src">M</span>
            ${h.source2rating} <span class="hc-rating-count">(${h.source2reviews.toLocaleString()})</span>
          </span>
        </div>
        <div class="hc-name-row">
          <h3 class="hc-name">${h.name}${h.verified ? ' <svg width="13" height="13" viewBox="0 0 24 24" fill="#7C3AED"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>' : ''}</h3>
        </div>
        <div class="hc-area-price">
          <span class="hc-area">${h.area}</span>
          <span class="hc-price">₹${h.price.toLocaleString()}<span class="hc-per">/night</span></span>
        </div>
        <ul class="hc-amenities">
          ${h.amenities.map(a => `<li class="hc-amenity"><span class="hc-bullet">◆</span>${a}</li>`).join('')}
        </ul>
        <div class="hc-actions">
          <a href="https://www.booking.com/search.html?ss=${encodeURIComponent(h.name)}" target="_blank" class="hc-book-btn">Book Now</a>
          <button class="hc-save-btn" onclick="this.textContent=this.textContent==='Saved ✓'?'Save':'Saved ✓'">Save</button>
        </div>
      </div>
    </div>
  `;

  if (grid)     grid.innerHTML     = hotels.slice(0,3).map(hotelCard).join('');
  if (moreGrid) moreGrid.innerHTML = hotels.map(hotelCard).join('');
}

function renderMapPins(dest) {
  const hotels = hotelsByDest[dest] || [];
  const container = document.getElementById('mapPins');
  const cityLabel  = document.getElementById('mapCityLabel');
  const mapCount   = document.getElementById('mapCount');
  if (cityLabel) cityLabel.textContent = dest + ', ' + (dest === 'Bali' ? 'Indonesia' : dest === 'Dubai' ? 'UAE' : 'India');
  if (mapCount)  mapCount.textContent  = `${hotels.length} stays on map`;
  if (!container) return;
  container.innerHTML = hotels.slice(0,Math.min(hotels.length, pinPositions.length)).map((h, i) => `
    <div class="map-pin" style="left:${pinPositions[i].x};top:${pinPositions[i].y}" onclick="highlightHotel(${i})">
      ₹${Math.round(h.price/1000)}K
    </div>
  `).join('');
}

function selectDest(dest) {
  currentDest = dest;
  const display = document.getElementById('dest-display');
  const badge = document.getElementById('tripBadge');
  if (display) display.textContent = dest;
  if (badge)   badge.textContent   = dest + ' Trip ✏️';
  document.getElementById('destDropdown').style.display = 'none';
  renderAiChips(dest);
  renderHotels(dest);
  renderMapPins(dest);
  document.getElementById('moreTitle').textContent = `All Hotels in ${dest}`;
}

function focusWhere() {
  const dd = document.getElementById('destDropdown');
  dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
  setTimeout(() => document.getElementById('destSearchInput')?.focus(), 50);
}
window.focusWhere = focusWhere;
window.selectDest = selectDest;

document.getElementById('searchBtn')?.addEventListener('click', () => {
  renderHotels(currentDest);
  document.getElementById('destDropdown').style.display = 'none';
});

document.addEventListener('click', e => {
  const dd = document.getElementById('destDropdown');
  if (!e.target.closest('#destDropdown') && !e.target.closest('#sf-where')) {
    if (dd) dd.style.display = 'none';
  }
});

function handleAiChip(btn) {
  btn.style.background = 'linear-gradient(135deg,#7C3AED,#EC4899)';
  btn.style.color = 'white';
  document.getElementById('aiAskInput').value = btn.textContent.replace('✨','').trim();
}
window.handleAiChip = handleAiChip;

function handleAiAsk() {
  const input = document.getElementById('aiAskInput');
  if (!input?.value) return;
  const val = input.value;
  input.value = '';
  const bar = document.querySelector('.ai-ask-bar .aab-inner');
  const prev = bar.innerHTML;
  bar.innerHTML = `<span class="aab-icon">🤔</span><span style="color:#64748B;font-size:.85rem">AI is finding: "${val}"...</span>`;
  setTimeout(() => { bar.innerHTML = prev; }, 2500);
}
window.handleAiAsk = handleAiAsk;

function highlightHotel(idx) {
  const pins = document.querySelectorAll('.map-pin');
  pins.forEach((p,i) => p.classList.toggle('active', i === idx));
}
window.highlightHotel = highlightHotel;

function toggleHeart(btn) {
  btn.classList.toggle('saved');
}
window.toggleHeart = toggleHeart;

function setSortActive(btn) {
  document.querySelectorAll('.sort-chip').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}
window.setSortActive = setSortActive;

// Init with default destination
document.addEventListener('DOMContentLoaded', () => {
  renderAiChips(currentDest);
  renderHotels(currentDest);
  renderMapPins(currentDest);

  // Set today + tomorrow as default dates
  const today = new Date();
  const tomorrow = new Date(today); tomorrow.setDate(today.getDate() + 1);
  const fmt = d => d.toLocaleDateString('en-GB',{day:'numeric',month:'short'});
  const datesEl = document.getElementById('dates-display');
  if (datesEl) datesEl.textContent = `${fmt(today)} – ${fmt(tomorrow)}`;
});
</script>

