---
import Layout from '../layouts/Layout.astro';

const destinations = ['Goa','Bali','Dubai','Jaipur','Maldives','Kerala','Manali','Bangkok','Singapore','Paris','Tokyo','Rishikesh'];

const curated = [
  { name:'Four Seasons Bali Sayan',  dest:'Bali',      area:'Ubud',           price:18200, rating:9.4, reviews:1842, tags:['Infinity Pool','Jungle View','Free Breakfast'], img:'photo-1566073771259-6a8506099945', badge:'Top Pick',    grad:'linear-gradient(135deg,#059669,#10B981)' },
  { name:'Taj Fort Aguada Resort',   dest:'Goa',       area:'Sinquerim Beach', price:16800, rating:9.1, reviews:2100, tags:['Heritage','Private Beach','Pool'], img:'photo-1520250497591-112f2f40a3f4', badge:'Heritage',   grad:'linear-gradient(135deg,#7C3AED,#EC4899)' },
  { name:'Burj Al Arab Jumeirah',    dest:'Dubai',     area:'Jumeirah Beach',  price:98000, rating:9.5, reviews:4200, tags:['Iconic','Michelin Dining','Helipad'], img:'photo-1582719478250-c89cae4dc85b', badge:'Iconic',     grad:'linear-gradient(135deg,#B45309,#D97706)' },
  { name:'Rambagh Palace',           dest:'Jaipur',    area:'Civil Lines',     price:42000, rating:9.4, reviews:1200, tags:['Royal Heritage','Palace Stay','Spa'], img:'photo-1552832025-e7297b0e7af9', badge:'Most Iconic', grad:'linear-gradient(135deg,#BE185D,#EC4899)' },
  { name:'Soneva Jani',              dest:'Maldives',  area:'Noonu Atoll',     price:125000,rating:9.8, reviews:880,  tags:['Overwater Villa','Retractable Roof','Lagoon'],img:'photo-1573843981267-be1999ff37cd', badge:'Ultra Lux', grad:'linear-gradient(135deg,#7C3AED,#A78BFA)' },
  { name:'Kumarakom Lake Resort',    dest:'Kerala',    area:'Kumarakom',       price:28000, rating:9.3, reviews:970,  tags:['Backwater View','Ayurveda','Heritage'],img:'photo-1602216056096-3b40cc0c9944', badge:'',          grad:'linear-gradient(135deg,#047857,#059669)' },
  { name:'Marina Bay Sands',         dest:'Singapore', area:'Marina Bay',      price:45000, rating:9.1, reviews:6700, tags:['Infinity Pool 57F','Casino','City View'],img:'photo-1525625293386-3f8f99389edd', badge:'Iconic',     grad:'linear-gradient(135deg,#7C3AED,#EC4899)' },
  { name:'Mandarin Oriental Bangkok',dest:'Bangkok',   area:'Riverside',       price:38000, rating:9.6, reviews:3200, tags:['Riverside','Michelin Dining','Spa'],img:'photo-1508009603885-50cf7c579365', badge:'Legend',     grad:'linear-gradient(135deg,#D97706,#F59E0B)' },
  { name:'Alaya Resort Ubud',        dest:'Bali',      area:'Rice Terrace',    price:7800,  rating:9.1, reviews:675,  tags:['Private Villa','Yoga Studio','Rice Views'],img:'photo-1559599101-f09722fb4948', badge:'Best Value', grad:'linear-gradient(135deg,#166534,#16A34A)' },
  { name:'W Goa',                    dest:'Goa',       area:'Vagator Beach',   price:13500, rating:8.7, reviews:1560, tags:['Beach Front','Infinity Pool','Bar'],img:'photo-1544551763-46a013bb70d5', badge:'',          grad:'linear-gradient(135deg,#7C3AED,#A78BFA)' },
  { name:'Park Hyatt Tokyo',         dest:'Tokyo',     area:'Shinjuku',        price:55000, rating:9.5, reviews:2100, tags:['Skyline Views','Spa','Grill Room'],img:'photo-1540959733332-eab4deabeeaf', badge:'',          grad:'linear-gradient(135deg,#9D174D,#EC4899)' },
  { name:'The Himalayan HPTDC',      dest:'Manali',    area:'Old Manali',      price:12000, rating:8.8, reviews:890,  tags:['Mountain View','Heritage','Gardens'],img:'photo-1548013146-72479768bada', badge:'',          grad:'linear-gradient(135deg,#475569,#7C3AED)' },
];
const curatedJson = JSON.stringify(curated);
---

<Layout title="Stays — Find Hotels | Virel" description="Search hotels worldwide via Hotellook. Curated luxury picks, best credit card for hotels, and Travelpayouts integration.">

<!-- HERO SEARCH -->
<section class="stays-hero">
  <div class="sh-bg"></div>
  <div class="container sh-inner">
    <h1 class="sh-title">Find your perfect stay</h1>
    <p class="sh-sub">Real-time hotel prices powered by Hotellook · 700,000+ hotels worldwide</p>

    <form class="stays-search-form" id="staysForm" onsubmit="searchHotels(event)">
      <div class="ssf-field ssf-dest">
        <label class="ssf-label">🏙️ Destination</label>
        <input type="text" id="ssf-dest-input" placeholder="City or hotel name…"
               list="destList" value="Goa" autocomplete="off" />
        <datalist id="destList">
          {destinations.map(d => <option value={d} />)}
          <option value="Mumbai" /><option value="Delhi" /><option value="Udaipur" />
          <option value="London" /><option value="New York" /><option value="Rome" />
        </datalist>
      </div>
      <div class="ssf-sep"></div>
      <div class="ssf-field">
        <label class="ssf-label">📅 Check-in</label>
        <input type="date" id="ssf-checkin" />
      </div>
      <div class="ssf-sep"></div>
      <div class="ssf-field">
        <label class="ssf-label">📅 Check-out</label>
        <input type="date" id="ssf-checkout" />
      </div>
      <div class="ssf-sep"></div>
      <div class="ssf-field ssf-guests">
        <label class="ssf-label">👥 Guests</label>
        <select id="ssf-guests-sel">
          <option value="1">1 Guest</option>
          <option value="2" selected>2 Guests</option>
          <option value="3">3 Guests</option>
          <option value="4">4 Guests</option>
        </select>
      </div>
      <button type="submit" class="ssf-search-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Search Hotels
      </button>
    </form>

    <div class="sh-powered">
      <span>🔗 Powered by</span>
      <span class="sh-tp-badge">Hotellook · Travelpayouts</span>
      <span>· 700K+ properties</span>
    </div>
  </div>
</section>

<!-- QUICK DEST CHIPS -->
<div class="dest-chips-bar">
  <div class="container dcb-inner">
    {destinations.slice(0,8).map(d => (
      <button class="dest-chip" onclick={`quickSearch('${d}')`}>{d}</button>
    ))}
  </div>
</div>

<!-- CURATED PICKS -->
<section class="curated-section">
  <div class="container">
    <div class="cs-header">
      <div>
        <h2 class="cs-title">🏆 Virel Curated Picks</h2>
        <p class="cs-sub">Handpicked top stays — book via Hotellook for best rates</p>
      </div>
      <div class="cs-filters" id="csFilters">
        <button class="csf-btn active" onclick="filterHotels('all', this)">All</button>
        {destinations.slice(0,6).map(d => (
          <button class="csf-btn" onclick={`filterHotels('${d}', this)`}>{d}</button>
        ))}
      </div>
    </div>

    <div class="hotels-grid" id="hotelsGrid">
      <!-- rendered by JS -->
    </div>
  </div>
</section>

<!-- BEST CARD FOR HOTELS -->
<section class="card-tip-section">
  <div class="container">
    <div class="cts-card">
      <div class="cts-left">
        <span class="cts-badge">💳 Best Card for Hotels</span>
        <h3 class="cts-title">Earn up to 10X rewards on hotel bookings</h3>
        <p class="cts-sub">Use the right card and earn back 3–10% of your hotel spend as reward points or cashback.</p>
      </div>
      <div class="cts-cards">
        {[
          { name:'HDFC Infinia',   bank:'HDFC Bank',  reward:'10X on Smartbuy',   color:'#1a1a1a', color2:'#37474f' },
          { name:'Axis Magnus',    bank:'Axis Bank',   reward:'4X EDGE Miles',     color:'#880e4f', color2:'#560027' },
          { name:'Amex Platinum',  bank:'Amex',        reward:'5X MR Points',      color:'#424242', color2:'#1a1a1a' },
        ].map(c => (
          <div class="cts-card-chip">
            <div class="ccc-mock" style={`background:linear-gradient(135deg,${c.color},${c.color2})`}>
              <div class="ccc-chip"></div>
            </div>
            <div class="ccc-info">
              <div class="ccc-name">{c.name}</div>
              <div class="ccc-bank">{c.bank}</div>
              <div class="ccc-reward">{c.reward}</div>
            </div>
          </div>
        ))}
      </div>
      <a href="/cards" class="cts-link-btn">Compare all hotel cards →</a>
    </div>
  </div>
</section>

</Layout>

<script define:vars={{ curatedJson }}>
const HOTELS = JSON.parse(curatedJson);

// Set default dates
const today = new Date();
const checkin  = new Date(today); checkin.setDate(today.getDate() + 14);
const checkout = new Date(today); checkout.setDate(today.getDate() + 17);
const fmt = d => d.toISOString().split('T')[0];
document.getElementById('ssf-checkin').value  = fmt(checkin);
document.getElementById('ssf-checkout').value = fmt(checkout);
document.getElementById('ssf-checkin').min    = fmt(today);
document.getElementById('ssf-checkout').min   = fmt(checkin);

document.getElementById('ssf-checkin').addEventListener('change', e => {
  const d = new Date(e.target.value); d.setDate(d.getDate()+1);
  document.getElementById('ssf-checkout').min   = fmt(d);
  if (document.getElementById('ssf-checkout').value <= e.target.value) {
    document.getElementById('ssf-checkout').value = fmt(d);
  }
});

function searchHotels(e) {
  e.preventDefault();
  const dest     = document.getElementById('ssf-dest-input').value.trim() || 'Goa';
  const checkIn  = document.getElementById('ssf-checkin').value;
  const checkOut = document.getElementById('ssf-checkout').value;
  const adults   = document.getElementById('ssf-guests-sel').value;
  const url = `https://hotellook.com/search?destination=${encodeURIComponent(dest)}&checkIn=${checkIn}&checkOut=${checkOut}&adults=${adults}&lang=en&currency=inr`;
  window.open(url, '_blank');
}
window.searchHotels = searchHotels;

function quickSearch(dest) {
  document.getElementById('ssf-dest-input').value = dest;
  const checkIn  = document.getElementById('ssf-checkin').value;
  const checkOut = document.getElementById('ssf-checkout').value;
  const url = `https://hotellook.com/search?destination=${encodeURIComponent(dest)}&checkIn=${checkIn}&checkOut=${checkOut}&adults=2&lang=en&currency=inr`;
  window.open(url, '_blank');
}
window.quickSearch = quickSearch;

let currentFilter = 'all';

function filterHotels(dest, btn) {
  currentFilter = dest;
  document.querySelectorAll('.csf-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderHotels();
}
window.filterHotels = filterHotels;

function renderHotels() {
  const filtered = currentFilter === 'all' ? HOTELS : HOTELS.filter(h => h.dest === currentFilter);
  const grid = document.getElementById('hotelsGrid');
  if (!grid) return;

  grid.innerHTML = filtered.map(h => `
    <div class="hotel-card">
      <div class="hc-img-wrap">
        <img src="https://images.unsplash.com/${h.img}?w=600&q=80&auto=format&fit=crop"
             alt="${h.name}" class="hc-img" loading="lazy"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <div class="hc-img-fallback" style="background:${h.grad};display:none">
          <span style="font-size:2rem">🏨</span>
        </div>
        ${h.badge ? `<span class="hc-badge">${h.badge}</span>` : ''}
        <div class="hc-rating-pill">⭐ ${h.rating} · ${(h.reviews/1000).toFixed(1)}K reviews</div>
      </div>
      <div class="hc-body">
        <div class="hc-dest-tag">${h.dest}</div>
        <h3 class="hc-name">${h.name}</h3>
        <div class="hc-area">📍 ${h.area}</div>
        <div class="hc-tags">
          ${h.tags.map(t => `<span class="hc-tag">${t}</span>`).join('')}
        </div>
        <div class="hc-footer">
          <div class="hc-price-wrap">
            <span class="hc-price">₹${h.price.toLocaleString()}</span>
            <span class="hc-per">/night</span>
          </div>
          <button class="hc-book-btn" onclick="bookHotel('${h.name}','${h.dest}')">
            Book via Hotellook →
          </button>
        </div>
      </div>
    </div>
  `).join('');
}

function bookHotel(name, dest) {
  const checkIn  = document.getElementById('ssf-checkin').value;
  const checkOut = document.getElementById('ssf-checkout').value;
  const query    = encodeURIComponent(name + ' ' + dest);
  window.open(`https://hotellook.com/search?destination=${query}&checkIn=${checkIn}&checkOut=${checkOut}&adults=2&lang=en&currency=inr`, '_blank');
}
window.bookHotel = bookHotel;

renderHotels();
</script>

<style>
/* HERO */
.stays-hero {
  position:relative;padding:60px 0 40px;
  background:linear-gradient(160deg,#0F172A 0%,#1E1B4B 60%,#312E81 100%);overflow:hidden;
}
.sh-bg {
  position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(124,58,237,.5),transparent);
}
.sh-inner { position:relative;z-index:2;text-align:center }
.sh-title {
  font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;color:white;
  letter-spacing:-.03em;margin-bottom:10px;
}
.sh-sub { font-size:.9rem;color:rgba(255,255,255,.7);margin-bottom:32px }

/* SEARCH FORM */
.stays-search-form {
  display:flex;align-items:center;
  background:white;border-radius:16px;
  box-shadow:0 16px 48px rgba(0,0,0,.3);
  overflow:hidden;max-width:960px;margin:0 auto 16px;
}
.ssf-field {
  display:flex;flex-direction:column;padding:14px 16px;flex:1;min-width:0;
}
.ssf-dest { flex:1.8 }
.ssf-guests { max-width:140px }
.ssf-label {
  font-size:.58rem;font-weight:800;color:#94A3B8;text-transform:uppercase;
  letter-spacing:.08em;margin-bottom:4px;
}
.ssf-field input,.ssf-field select {
  border:none;outline:none;font-size:.88rem;font-weight:700;color:#0F172A;
  background:transparent;font-family:inherit;width:100%;
}
.ssf-field select { cursor:pointer }
.ssf-sep { width:1px;height:44px;background:#E2E8F0;flex-shrink:0;align-self:center }
.ssf-search-btn {
  display:flex;align-items:center;gap:8px;
  padding:0 28px;height:100%;min-height:72px;
  background:linear-gradient(135deg,#7C3AED,#EC4899);
  color:white;border:none;font-size:.9rem;font-weight:800;cursor:pointer;
  transition:opacity .15s;white-space:nowrap;flex-shrink:0;
}
.ssf-search-btn:hover { opacity:.9 }
.sh-powered { font-size:.72rem;color:rgba(255,255,255,.55) }
.sh-tp-badge {
  font-size:.72rem;font-weight:800;color:rgba(255,255,255,.85);
  background:rgba(255,255,255,.1);padding:2px 10px;border-radius:100px;margin:0 4px;
}

/* DEST CHIPS */
.dest-chips-bar {
  background:white;border-bottom:1px solid #E2E8F0;overflow-x:auto;
}
.dcb-inner {
  display:flex;gap:8px;padding:12px 24px;align-items:center;min-width:max-content;
}
.dest-chip {
  padding:6px 16px;border-radius:100px;border:1.5px solid #E2E8F0;
  background:white;font-size:.78rem;font-weight:700;color:#475569;cursor:pointer;
  transition:all .15s;white-space:nowrap;
}
.dest-chip:hover { border-color:#7C3AED;color:#7C3AED;background:#F5F3FF }

/* CURATED */
.curated-section { padding:48px 0 }
.cs-header { display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:28px;flex-wrap:wrap }
.cs-title { font-size:1.4rem;font-weight:900;color:#0F172A;margin-bottom:4px }
.cs-sub { font-size:.82rem;color:#64748B }
.cs-filters { display:flex;gap:8px;flex-wrap:wrap }
.csf-btn {
  padding:6px 14px;border-radius:100px;border:1.5px solid #E2E8F0;
  background:white;font-size:.75rem;font-weight:700;color:#475569;cursor:pointer;transition:all .15s;
}
.csf-btn:hover,.csf-btn.active {
  background:linear-gradient(135deg,#7C3AED,#EC4899);color:white;border-color:transparent;
}

.hotels-grid {
  display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;
}

/* HOTEL CARD */
.hotel-card {
  background:white;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;
  transition:all .2s;
}
.hotel-card:hover { box-shadow:0 12px 40px rgba(0,0,0,.1);transform:translateY(-4px) }
.hc-img-wrap { position:relative;height:200px;overflow:hidden }
.hc-img { width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s }
.hotel-card:hover .hc-img { transform:scale(1.05) }
.hc-img-fallback {
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
}
.hc-badge {
  position:absolute;top:12px;left:12px;
  background:linear-gradient(135deg,#7C3AED,#EC4899);color:white;
  font-size:.62rem;font-weight:800;padding:3px 10px;border-radius:100px;
}
.hc-rating-pill {
  position:absolute;bottom:10px;right:10px;
  background:rgba(0,0,0,.6);backdrop-filter:blur(4px);color:white;
  font-size:.65rem;font-weight:700;padding:4px 10px;border-radius:100px;
}
.hc-body { padding:16px }
.hc-dest-tag {
  font-size:.62rem;font-weight:800;color:#7C3AED;text-transform:uppercase;
  letter-spacing:.08em;margin-bottom:5px;
}
.hc-name { font-size:.95rem;font-weight:800;color:#0F172A;margin-bottom:4px;line-height:1.3 }
.hc-area { font-size:.72rem;color:#64748B;margin-bottom:10px }
.hc-tags { display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px }
.hc-tag {
  font-size:.6rem;font-weight:700;background:#F8FAFC;border:1px solid #E2E8F0;
  color:#475569;padding:2px 8px;border-radius:6px;
}
.hc-footer { display:flex;align-items:center;justify-content:space-between;gap:10px }
.hc-price-wrap { display:flex;align-items:baseline;gap:3px }
.hc-price { font-size:1.1rem;font-weight:900;color:#7C3AED }
.hc-per { font-size:.65rem;color:#94A3B8 }
.hc-book-btn {
  padding:8px 14px;background:linear-gradient(135deg,#7C3AED,#EC4899);
  color:white;border:none;border-radius:10px;font-size:.72rem;font-weight:800;
  cursor:pointer;transition:all .15s;white-space:nowrap;
}
.hc-book-btn:hover { opacity:.9;transform:translateY(-1px) }

/* CARD TIP */
.card-tip-section { padding:0 0 60px }
.cts-card {
  background:linear-gradient(160deg,#0F172A,#1E1B4B);
  border-radius:24px;padding:40px;
  display:grid;grid-template-columns:1fr 2fr auto;gap:32px;align-items:center;
}
.cts-badge {
  font-size:.7rem;font-weight:800;color:#A78BFA;text-transform:uppercase;letter-spacing:.1em;
  display:block;margin-bottom:10px;
}
.cts-title { font-size:1.2rem;font-weight:900;color:white;margin-bottom:8px;line-height:1.3 }
.cts-sub { font-size:.82rem;color:rgba(255,255,255,.6);line-height:1.6 }
.cts-cards { display:flex;gap:12px;flex-wrap:wrap }
.cts-card-chip {
  display:flex;align-items:center;gap:10px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  border-radius:12px;padding:10px 14px;flex:1;min-width:160px;
}
.ccc-mock {
  width:40px;height:26px;border-radius:4px;position:relative;flex-shrink:0;
}
.ccc-chip {
  position:absolute;top:4px;left:5px;width:12px;height:9px;
  background:linear-gradient(135deg,#c8a420,#f0d060);border-radius:2px;
}
.ccc-name { font-size:.78rem;font-weight:800;color:white }
.ccc-bank { font-size:.62rem;color:rgba(255,255,255,.5) }
.ccc-reward { font-size:.62rem;color:#10B981;font-weight:700 }
.cts-link-btn {
  padding:12px 24px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);
  border-radius:12px;color:white;font-size:.82rem;font-weight:800;
  text-decoration:none;white-space:nowrap;transition:all .2s;
}
.cts-link-btn:hover { background:rgba(255,255,255,.2) }

@media (max-width:960px) {
  .stays-search-form { flex-direction:column;border-radius:16px }
  .ssf-sep { width:100%;height:1px }
  .ssf-search-btn { width:100%;justify-content:center;padding:14px }
  .cts-card { grid-template-columns:1fr }
}
@media (max-width:640px) {
  .stays-hero { padding:40px 0 30px }
  .hotels-grid { grid-template-columns:1fr }
}
</style>
