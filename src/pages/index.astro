---
import Layout from '../layouts/Layout.astro';

const cities = [
  { name: 'Goa',       emoji: '🏖️', country: 'India',     tag: 'Beach Vibes',    grad: 'linear-gradient(160deg,#10B981 0%,#059669 50%,#14B8A6 100%)', ig: 'goa' },
  { name: 'Bali',      emoji: '🌴', country: 'Indonesia',  tag: 'Island Escape',  grad: 'linear-gradient(160deg,#059669 0%,#10B981 50%,#34D399 100%)', ig: 'bali' },
  { name: 'Dubai',     emoji: '🏙️', country: 'UAE',        tag: 'Luxury City',    grad: 'linear-gradient(160deg,#B45309 0%,#D97706 50%,#F59E0B 100%)', ig: 'dubaitravel' },
  { name: 'Jaipur',    emoji: '🏰', country: 'India',      tag: 'Pink City',      grad: 'linear-gradient(160deg,#BE185D 0%,#EC4899 50%,#F9A8D4 100%)', ig: 'jaipurdiaries' },
  { name: 'Maldives',  emoji: '🌊', country: 'Maldives',   tag: 'Crystal Waters', grad: 'linear-gradient(160deg,#0284C7 0%,#38BDF8 50%,#BAE6FD 100%)', ig: 'maldives' },
  { name: 'Paris',     emoji: '🗼', country: 'France',     tag: 'City of Love',   grad: 'linear-gradient(160deg,#7C3AED 0%,#A78BFA 50%,#DDD6FE 100%)', ig: 'paristravel' },
  { name: 'Rishikesh', emoji: '🏔️', country: 'India',     tag: 'Adventure Hub',  grad: 'linear-gradient(160deg,#047857 0%,#10B981 50%,#6EE7B7 100%)', ig: 'rishikesh' },
  { name: 'Bangkok',   emoji: '🛕', country: 'Thailand',   tag: 'Temple City',    grad: 'linear-gradient(160deg,#D97706 0%,#F59E0B 50%,#FCD34D 100%)', ig: 'bangkokthailand' },
  { name: 'Singapore', emoji: '🌃', country: 'Singapore',  tag: 'Garden City',    grad: 'linear-gradient(160deg,#0F172A 0%,#7C3AED 50%,#EC4899 100%)', ig: 'singaporetravel' },
  { name: 'Kerala',    emoji: '⛵', country: 'India',      tag: "God's Own",      grad: 'linear-gradient(160deg,#166534 0%,#16A34A 50%,#4ADE80 100%)', ig: 'keraladiaries' },
  { name: 'Manali',    emoji: '❄️', country: 'India',     tag: 'Snow Paradise',  grad: 'linear-gradient(160deg,#475569 0%,#7C3AED 50%,#C4B5FD 100%)', ig: 'manali' },
  { name: 'Tokyo',     emoji: '🌸', country: 'Japan',      tag: 'Cherry Blossom', grad: 'linear-gradient(160deg,#9D174D 0%,#EC4899 50%,#FBCFE8 100%)', ig: 'tokyotrip' },
  { name: 'Mumbai',    emoji: '🌆', country: 'India',      tag: 'City of Dreams', grad: 'linear-gradient(160deg,#7C2D12 0%,#EA580C 50%,#FB923C 100%)', ig: 'mumbaidiaries' },
  { name: 'London',    emoji: '🎡', country: 'UK',         tag: 'Royal City',     grad: 'linear-gradient(160deg,#1E293B 0%,#475569 50%,#94A3B8 100%)', ig: 'visitlondon' },
];

const features = [
  { icon:'✨', title:'Virel Blueprints', desc:'Get day-by-day itineraries powered by AI. Hotels, experiences, and activities curated for your travel style.', color:'#8B5CF6', grad:'linear-gradient(135deg,#8B5CF6,#7C3AED)', href:'/trip-board', tag:'Powered by AI' },
  { icon:'💳', title:'Smart Card Rewards', desc:'Know the best card for every spend. Maximize cashback, air miles, and lounge access automatically.', color:'#FF6B35', grad:'linear-gradient(135deg,#FF6B35,#F59E0B)', href:'/cards', tag:'50+ Cards' },
  { icon:'🎁', title:'Earn & Redeem', desc:'Earn Virel Coins on every booking. Get up to 30% cashback via affiliate commission sharing.', color:'#10B981', grad:'linear-gradient(135deg,#10B981,#059669)', href:'/offers', tag:'Up to 30% back' },
  { icon:'🔍', title:'Browse Everything', desc:'Flights, hotels, trains, cabs, food, medicines, gift cards — all in one beautifully designed app.', color:'#9333EA', grad:'linear-gradient(135deg,#9333EA,#EC4899)', href:'/browse', tag:'10+ Services' },
  { icon:'👨‍👩‍👧', title:'Family Dashboard', desc:'Plan trips together, share rewards, and track household spend. One account for the whole family.', color:'#F59E0B', grad:'linear-gradient(135deg,#F59E0B,#EC4899)', href:'/family', tag:'Coming Soon', soon:true },
  { icon:'📊', title:'Spend Analytics', desc:'Auto-import from SMS and emails. See exactly where your money goes with smart category breakdown.', color:'#EC4899', grad:'linear-gradient(135deg,#EC4899,#7C3AED)', href:'/browse', tag:'Auto Import' },
];

const stats = [
  { value:'50+', label:'Credit Cards', icon:'💳' },
  { value:'30%', label:'Max Cashback',  icon:'💰' },
  { value:'200+', label:'Destinations', icon:'🌍' },
  { value:'10+', label:'Services',      icon:'⚡' },
];

const howItWorks = [
  { step:'01', icon:'🔗', title:'Connect Your Cards', desc:'Add your credit cards to unlock their full benefits, rewards rates, and best use cases.' },
  { step:'02', icon:'✈️', title:'Plan with AI', desc:'Tell us where you want to go. Get a complete AI-powered itinerary with hotels and experiences.' },
  { step:'03', icon:'💰', title:'Earn & Save', desc:'Book through Virel. Earn Virel Coins, get cashback, and maximize your card rewards every time.' },
];
---

<Layout title="Virel — Travel Smart, Earn More">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-glow g1"></div>
    <div class="hero-glow g2"></div>
    <div class="hero-glow g3"></div>

    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="live-dot"></span>
          🚀 Now with AI Trip Planning
        </div>

        <h1 class="hero-title">
          Travel <span class="hg1">smarter.</span><br/>
          Earn <span class="hg2">more.</span><br/>
          Live <span class="hg3">better.</span>
        </h1>

        <p class="hero-sub">
          AI-powered itineraries, best credit card rewards, and instant cashback — all in one beautiful app.
        </p>

        <div class="hero-btns">
          <a href="/trip-board" class="hbtn-primary">✨ Build Blueprint</a>
          <a href="/cards"      class="hbtn-ghost">💳 Explore Cards</a>
        </div>

        <div class="hero-stats">
          {stats.map(s => (
            <div class="hstat">
              <span class="hstat-icon">{s.icon}</span>
              <span class="hstat-val">{s.value}</span>
              <span class="hstat-lbl">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-visual">
        <div class="phone-wrap">
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-inner">
              <div class="ph-topbar">
                <span style="font-size:0.9rem;font-weight:900;color:#0F172A">Virel</span>
                <span class="ph-live">● Live</span>
              </div>
              <div class="ph-cards">
                <div class="ph-card" style="background:linear-gradient(135deg,#5B21B6,#7C3AED)">
                  <div style="font-size:0.5rem;color:rgba(255,255,255,0.75);font-weight:700">HDFC</div>
                  <div style="font-size:0.65rem;color:white;font-weight:900;margin:1px 0">Infinia</div>
                  <div style="font-size:0.45rem;color:rgba(255,255,255,0.6);position:absolute;bottom:6px;left:8px">•••• 4521</div>
                </div>
                <div class="ph-card" style="background:linear-gradient(135deg,#7C3AED,#EC4899)">
                  <div style="font-size:0.5rem;color:rgba(255,255,255,0.75);font-weight:700">Axis</div>
                  <div style="font-size:0.65rem;color:white;font-weight:900;margin:1px 0">Magnus</div>
                  <div style="font-size:0.45rem;color:rgba(255,255,255,0.6);position:absolute;bottom:6px;left:8px">•••• 7890</div>
                </div>
              </div>
              <div class="ph-sec">Best Card for Next Trip</div>
              <div class="ph-rec">
                <span style="font-size:0.9rem">✈️</span>
                <div style="flex:1">
                  <div style="font-size:0.62rem;font-weight:800;color:#0F172A">HDFC Infinia</div>
                  <div style="font-size:0.55rem;color:#10B981;font-weight:700">5x rewards on flights</div>
                </div>
                <div style="font-size:0.65rem;font-weight:800;color:#7C3AED">₹2,400 back</div>
              </div>
              <div class="ph-sec" style="margin-top:8px">Bali Itinerary</div>
              <div class="ph-day">
                <span class="ph-day-badge" style="background:linear-gradient(135deg,#EC4899,#7C3AED)">Day 1</span>
                <span style="font-size:0.58rem;color:#475569">🛬 Arrive → 🏨 Villa → 🌅 Sunset</span>
              </div>
              <div class="ph-day" style="margin-top:4px">
                <span class="ph-day-badge" style="background:linear-gradient(135deg,#EC4899,#F59E0B)">Day 2</span>
                <span style="font-size:0.58rem;color:#475569">🛕 Ubud → 🌿 Rice Fields</span>
              </div>
              <div class="ph-coins">🪙 1,240 Virel Coins earned</div>
            </div>
          </div>
        </div>
        <div class="float-chip fc1">
          <span>🎯</span>
          <div><div style="font-size:0.6rem;font-weight:800;color:#0F172A">Best Card</div><div style="font-size:0.52rem;color:#10B981;font-weight:700">AI matched</div></div>
        </div>
        <div class="float-chip fc2">
          <span>💰</span>
          <div><div style="font-size:0.6rem;font-weight:800;color:#0F172A">₹4,200</div><div style="font-size:0.52rem;color:#7C3AED;font-weight:700">Saved this trip</div></div>
        </div>
        <div class="float-chip fc3">
          <span>⭐</span>
          <div><div style="font-size:0.6rem;font-weight:800;color:#0F172A">Bali, 5 days</div><div style="font-size:0.52rem;color:#EC4899;font-weight:700">AI ready</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUSTED -->
  <section class="trusted">
    <div class="container">
      <p class="trusted-lbl">Trusted by users with cards from</p>
      <div class="trusted-row">
        {['HDFC','Axis','SBI','ICICI','Amex','Kotak','IDFC','YES','HSBC','Citi'].map(b => (
          <span class="trusted-bank">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="sec features-sec">
    <div class="container">
      <div class="sec-hdr">
        <span class="section-label">⚡ Everything You Need</span>
        <h2 class="section-title">One app for travel & finance</h2>
        <p class="section-sub">From AI trip planning to maximizing credit card rewards — Virel does it all.</p>
      </div>
      <div class="feat-grid">
        {features.map(f => (
          <a href={f.href} class:list={['feat-card', { soon: f.soon }]}>
            <div class="feat-icon-bg" style={`background:${f.grad}`}>
              <span style="font-size:1.4rem">{f.icon}</span>
            </div>
            <div class="feat-body">
              <div class="feat-top">
                <span class="feat-title">{f.title}</span>
                <span class="feat-tag" style={`color:${f.color};background:${f.color}18`}>{f.tag}</span>
              </div>
              <p class="feat-desc">{f.desc}</p>
            </div>
            {f.soon && <span class="feat-soon-badge">Coming Soon ✨</span>}
            <span class="feat-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CITY VIBES -->
  <section class="sec cities-sec">
    <div class="container">
      <div class="sec-hdr">
        <span class="section-label" style="background:linear-gradient(135deg,rgba(236,72,153,0.1),rgba(124,58,237,0.1));color:#EC4899;border-color:rgba(236,72,153,0.2)">📸 Get Inspired</span>
        <h2 class="section-title">City Vibes</h2>
        <p class="section-sub">Explore real travel reels from these destinations and start planning your next adventure.</p>
      </div>
      <div class="cities-outer">
        <div class="cities-scroll">
          {cities.map(city => (
            <a href={`https://www.instagram.com/explore/tags/${city.ig}/`} target="_blank" rel="noopener" class="city-reel" style={`background:${city.grad}`}>
              <div class="cr-top">
                <span class="cr-ig-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="white" stroke-width="2.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="white" stroke-width="2.5"/><circle cx="17.5" cy="6.5" r="1.2" fill="white"/></svg>
                  Reels
                </span>
              </div>
              <div class="cr-play">
                <div class="cr-play-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>
                </div>
              </div>
              <div class="cr-bottom">
                <div class="cr-emoji">{city.emoji}</div>
                <div class="cr-name">{city.name}</div>
                <div class="cr-country">{city.country}</div>
                <div class="cr-tag">{city.tag}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
      <p class="cities-note">Tap any city card to explore travel reels on Instagram · Click a card below to plan that trip</p>
      <div class="cities-plan-row">
        {cities.slice(0,6).map(c => (
          <a href={`/trip-board?dest=${c.name}`} class="city-plan-chip" style={`background:${c.grad}`}>
            {c.emoji} Plan {c.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sec how-sec">
    <div class="container">
      <div class="sec-hdr">
        <span class="section-label">🗺️ Simple Steps</span>
        <h2 class="section-title">How Virel works</h2>
      </div>
      <div class="how-grid">
        {howItWorks.map((s, i) => (
          <div class="how-card">
            <span class="how-step">{s.step}</span>
            <div class="how-icon">{s.icon}</div>
            <h3 class="how-title">{s.title}</h3>
            <p class="how-desc">{s.desc}</p>
            {i < 2 && <span class="how-arrow">→</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRIP BOARD PREVIEW -->
  <section class="tb-preview">
    <div class="tb-bg"></div>
    <div class="container tb-inner">
      <div class="tb-left">
        <span class="section-label" style="background:rgba(255,255,255,0.12);color:white;border-color:rgba(255,255,255,0.2)">✈️ AI-Powered, Like Rimingo — But Better</span>
        <h2 class="section-title" style="color:white">Virel Blueprints</h2>
        <p class="section-sub" style="color:rgba(255,255,255,0.72)">
          Tell us your destination and travel style. AI builds a complete day-by-day itinerary with smart hotel picks, curated experiences, and the best credit card to use at every step.
        </p>
        <div style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
          <a href="/trip-board" class="hbtn-primary" style="background:white;color:#7C3AED;box-shadow:0 4px 20px rgba(0,0,0,0.2)">✨ Open Blueprints</a>
          <a href="/travel"     class="hbtn-ghost">Book Now</a>
        </div>
        <div class="tb-feats">
          {['AI Itineraries','Smart Hotel Picks','Curated Experiences','Group Trips','Flexible Dates','Best Card Suggestions'].map(f => (
            <span class="tb-feat">✓ {f}</span>
          ))}
        </div>
      </div>
      <div class="tb-right">
        <div class="tbc tbc-main">
          <div class="tbc-dest">
            <span style="font-size:1.4rem">🌴</span>
            <div style="flex:1">
              <div style="font-weight:900;font-size:0.95rem;color:#0F172A">Bali, Indonesia</div>
              <div style="font-size:0.72rem;color:#64748B">Dec 22–28 · 2 Adults</div>
            </div>
            <span class="tbc-ai-tag">AI Ready ✓</span>
          </div>
          {[
            { day:'Day 1', icon:'🛬', t:'Arrival & Kuta Beach', c:'Chill' },
            { day:'Day 2', icon:'🛕', t:'Ubud Temples & Terraces', c:'Culture' },
            { day:'Day 3', icon:'🤿', t:'Nusa Penida Diving', c:'Adventure' },
          ].map(d => (
            <div class="tbc-row">
              <span class="tbc-daybadge">{d.day}</span>
              <span style="font-size:0.9rem">{d.icon}</span>
              <span style="font-size:0.72rem;font-weight:700;color:#1E293B;flex:1">{d.t}</span>
              <span class="tbc-cat">{d.c}</span>
            </div>
          ))}
        </div>
        <div class="tbc tbc-hotel">
          <div style="font-size:0.6rem;color:rgba(255,255,255,0.55);font-weight:800;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px">Smart Hotel Pick</div>
          <div style="font-size:0.85rem;font-weight:900;color:white">Four Seasons Bali</div>
          <div style="font-size:0.7rem;color:#FCD34D;margin:3px 0">★★★★★ · Ubud</div>
          <div style="font-size:0.65rem;color:rgba(255,255,255,0.65)">Use HDFC Infinia → 5x reward points</div>
          <div style="font-size:0.78rem;font-weight:900;color:#4ADE80;margin-top:8px">₹18,000/night · Save ₹3,600</div>
        </div>
      </div>
    </div>
  </section>

  <!-- APP CTA -->
  <section class="sec app-sec">
    <div class="container">
      <div class="app-card">
        <div class="app-left">
          <span class="section-label">📱 Download Now</span>
          <h2 class="section-title">Take Virel everywhere</h2>
          <p class="section-sub">Import bank statements, scan receipts, get AI suggestions on the go. Available on Android.</p>
          <div class="app-badge-row">
            <a href="https://play.google.com/store" target="_blank" class="app-dl-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.22a2 2 0 0 1-1.3-1.87V2.65a2 2 0 0 1 1.3-1.87l11.02 11.22zm15.45-8.58L15.9 12.9l-2.8 2.8 2.71 2.71zm-1.17-6.28L13.1 11.1l2.8 2.8 3.36-1.74a1.14 1.14 0 0 0 0-2.03zM4.44 1.53l10.35 10.35-2.8 2.8-7.55-13.15z"/></svg>
              Google Play
            </a>
          </div>
          <div class="app-chips">
            {['SMS Auto-Import','Bank Statements','AI Suggestions','Offline Access','Voice Commands'].map(f => (
              <span class="app-chip">✓ {f}</span>
            ))}
          </div>
        </div>
        <div class="app-right">
          <div class="app-qr">
            <div style="font-size:2.5rem">📱</div>
            <div style="font-size:0.72rem;font-weight:700;color:#475569;margin-top:6px;text-align:center">Scan to Download</div>
            <div style="font-size:0.62rem;color:#94A3B8">Android</div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* HERO */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 40%, #312E81 70%, #4C1D95 100%);
}
.hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 65% 40%, rgba(124,58,237,.45) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 10% 80%, rgba(8,145,178,.3) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 90% 15%, rgba(236,72,153,.25) 0%, transparent 60%);
}
.hero-glow {
  position: absolute; border-radius: 50%;
  filter: blur(90px); opacity: .45;
  animation: floatGlow 8s ease-in-out infinite;
}
.g1 { width:500px;height:500px;background:#7C3AED;top:-120px;right:8%;animation-delay:0s }
.g2 { width:380px;height:380px;background:#EC4899;bottom:-40px;right:28%;animation-delay:3s }
.g3 { width:280px;height:280px;background:#FF6B35;top:35%;left:-40px;animation-delay:6s }
@keyframes floatGlow {
  0%,100%{ transform:translateY(0) scale(1) }
  50%    { transform:translateY(-28px) scale(1.05) }
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  padding-top: 80px;
  padding-bottom: 80px;
  position: relative;
  z-index: 2;
}
.hero-content { color: white; }

.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.1); backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.2);
  color: white; font-size: .8rem; font-weight: 700;
  padding: 8px 16px; border-radius: 100px; margin-bottom: 28px;
}
.live-dot {
  width: 8px; height: 8px; background: #4ADE80; border-radius: 50%;
  animation: livePulse 2s infinite;
}
@keyframes livePulse {
  0%,100%{ box-shadow: 0 0 0 0 rgba(74,222,128,.5) }
  50%    { box-shadow: 0 0 0 6px rgba(74,222,128,0) }
}

.hero-title {
  font-size: clamp(2.4rem, 5.5vw, 3.8rem);
  font-weight: 900; line-height: 1.06;
  letter-spacing: -.03em; margin-bottom: 24px; color: white;
}
.hg1 { background:linear-gradient(90deg,#A78BFA,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text }
.hg2 { background:linear-gradient(90deg,#FCD34D,#FF6B35);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text }
.hg3 { background:linear-gradient(90deg,#6EE7B7,#10B981);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text }

.hero-sub {
  font-size: 1.05rem; color: rgba(255,255,255,.72);
  line-height: 1.72; margin-bottom: 36px; max-width: 460px;
}

.hero-btns { display:flex;gap:12px;flex-wrap:wrap;margin-bottom:40px }
.hbtn-primary {
  display:inline-flex;align-items:center;gap:8px;
  background:white;color:#7C3AED;
  padding:15px 26px;border-radius:14px;
  font-weight:800;font-size:.93rem;
  box-shadow:0 4px 24px rgba(0,0,0,.22);
  transition:all .2s; text-decoration:none;
}
.hbtn-primary:hover { transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,.3) }
.hbtn-ghost {
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.1);color:white;
  padding:15px 26px;border-radius:14px;
  font-weight:700;font-size:.93rem;
